{
	"extends": "../../tsconfig.base.json",
	"compilerOptions": {
		"lib": ["es2024", "dom", "dom.iterable"],
		"types": ["vite/client"],
		"jsx": "react-jsx",
		"paths": {
			"@app/*": ["./src/app/*"],
			"@pages/*": ["./src/pages/*"],
			"@widgets/*": ["./src/widgets/*"],
			"@entities/*": ["./src/entities/*"],
			"@shared/*": ["./src/shared/*"]
		}
	},
	"include": ["src"]
}
