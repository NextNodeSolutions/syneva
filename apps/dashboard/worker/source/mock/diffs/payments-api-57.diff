 func (d *Dispatcher) Deliver(ctx context.Context, delivery Delivery) error {
+	var lastErr error
+	for attempt := 0; attempt < maxAttempts; attempt++ {
+		lastErr = d.send(ctx, delivery)
+		if lastErr == nil || errors.Is(lastErr, errPermanent) {
