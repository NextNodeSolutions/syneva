index 0000000..e36b5a4
--- /dev/null
+++ b/src/cart/delivery-estimate.ts
@@ -0,0 +1,37 @@
+import type { ShippingMethod } from './cart'
+
+const TRANSIT_DAYS: Record<ShippingMethod, [number, number]> = {
+  standard: [3, 5],
+  express: [1, 2],
+  pickup: [0, 1],
+}
+
+export type DeliveryEstimate = {
+  earliest: string
+  latest: string
+}
+
+const dayFormat = new Intl.DateTimeFormat('en', {
+  weekday: 'short',
+  month: 'short',
+  day: 'numeric',
+})
+
+export function estimateDelivery(method: ShippingMethod, today: Date): DeliveryEstimate {
+  const [minDays, maxDays] = TRANSIT_DAYS[method]
+  return {
+    earliest: dayFormat.format(addBusinessDays(today, minDays)),
+    latest: dayFormat.format(addBusinessDays(today, maxDays)),
+  }
+}
+
+function addBusinessDays(start: Date, days: number): Date {
+  const result = new Date(start)
+  let remaining = days
+  while (remaining > 0) {
+    result.setDate(result.getDate() + 1)
+    const weekday = result.getDay()
+    if (weekday !== 0 && weekday !== 6) remaining -= 1
+  }
+  return result
+}
