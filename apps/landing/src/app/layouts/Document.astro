---
// The document shell every page shares: head metadata, the motion arming
// script, the ruled frame with the header and footer.
import '../styles/global.css'

import { hexColor } from '@syneva/design-system/tokens.stylex'
import { ARM_SCRIPT } from '@syneva/motion/boot'
import { motionRoot } from '@syneva/motion/root.stylex'

import Footer from '@widgets/footer/ui/Footer.astro'
import Navigation from '@widgets/navigation/ui/Navigation.astro'
import { SITE_NAME, SITE_URL } from '@entities/site/model/site-map'
import { sx } from '@shared/lib/sx'
import { documentShell } from './document.styles'

type Props = { title: string; description: string }

const { title, description } = Astro.props
const canonical = `${SITE_URL}${Astro.url.pathname}`
// The 404 answers every missing address, so it claims no URL of its own.
const hasAddress = Astro.locals.page !== 'lost'
---

<!doctype html>
<html lang="en" {...sx(motionRoot)}>
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="theme-color" content={hexColor.paper} />
		<title>{title}</title>
		<meta name="description" content={description} />
		{hasAddress && <link rel="canonical" href={canonical} />}
		<meta property="og:type" content="website" />
		<meta property="og:site_name" content={SITE_NAME} />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		{hasAddress && <meta property="og:url" content={canonical} />}
		<meta property="og:image" content={`${SITE_URL}/og.png`} />
		<meta name="twitter:card" content="summary_large_image" />
		<link rel="icon" href="/mark.svg" type="image/svg+xml" />
		<link rel="preload" href="/fonts/geist.woff2" as="font" type="font/woff2" crossorigin />
		<link rel="preload" href="/fonts/geist-mono.woff2" as="font" type="font/woff2" crossorigin />
		<script is:inline set:html={ARM_SCRIPT} />
		{import.meta.env.DEV && <link rel="stylesheet" href="/virtual:stylex.css" />}
	</head>
	<body>
		<a {...sx(documentShell.skip)} href="#main">Skip to content</a>
		<div {...sx(documentShell.frame)}>
			<Navigation />
			<main id="main">
				<slot />
			</main>
			<Footer />
		</div>
		<script>
			import '../scripts/site'
		</script>
	</body>
</html>
