---
// A numbered callout on the desk wireframe.
import { sx } from '../../lib/sx'
import { anim } from '../kit/anim'
import { productArt as p } from './product-art.styles'

type Props = { n: number; x: number; y: number; delay: number }

const { n, x, y, delay } = Astro.props
const SIZE = 16
const BASELINE = 11.5
---

<g {...anim('pop', delay)}><rect {...sx(p.anatomyNumber)} x={x} y={y} width={SIZE} height={SIZE}></rect><text {...sx(p.anatomyNumberText)} x={x + SIZE / 2} y={y + BASELINE} text-anchor="middle">{n}</text></g>
