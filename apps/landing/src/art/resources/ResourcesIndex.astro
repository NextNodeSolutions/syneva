---
// Resources overview: a ruled table of contents.
import { sx } from '../../lib/sx'
import { homeArt as h } from '../home/home-art.styles'
import ArtFrame from '../kit/ArtFrame.astro'
import Drawing from '../kit/Drawing.astro'
import { anim, move } from '../kit/anim'
import { shape } from '../kit/shape.styles'
import { text } from '../kit/text.styles'
import { resourcesArt as r } from './resources-art.styles'

const ENTRIES = [
	{ title: 'Get started', n: '01', words: 'From install to your first verdict' },
	{ title: 'Connect your agent', n: '02', words: 'The pi package and the CLI contract' },
	{ title: 'Questions & answers', n: '03', words: 'Local state, agents, limits' },
	{ title: 'Changelog', n: '04', words: 'What shipped, from the history' },
] as const
const ROW = 70
// The leader starts after the title, at the head font's average advance.
const ADVANCE = 9.6
const leaderAt = (title: string, i: number): string => `M${title.length * ADVANCE + 82} ${128 + i * ROW}H486`
---

<Drawing viewBox="0 0 600 420" compact="50 60 500 330" labelledby="toc-title toc-desc">
	<title id="toc-title">Resources, as a table of contents</title>
	<desc id="toc-desc">Four resources listed like a book's contents: get started, connect your agent, questions and answers, and the changelog.</desc>
	<ArtFrame id="toc" width={600} height={420} />
	<text {...anim('fade', 0, text.tiny)} x="70" y="80">CONTENTS</text>
	<path {...anim('draw', 0.1, shape.inkLine)} pathLength="1" d="M70 92h460"></path>
	{
		ENTRIES.map(({ title, n, words }, i) => (
			<g {...anim('rise', 0.2 + i * 0.12)}>
				<text {...sx(text.head)} x="70" y={132 + i * ROW}>{title}</text>
				<text {...sx(text.small)} x="70" y={152 + i * ROW}>{words}</text>
				<path {...sx(r.tocLeader)} d={leaderAt(title, i)} />
				<text {...sx(text.label, text.accent)} x="530" y={132 + i * ROW} text-anchor="end">{n}</text>
				<path {...sx(shape.hair)} d={`M70 ${170 + i * ROW}h460`} />
			</g>
		))
	}
	<rect {...move(0.9, 0, -60, r.tocRibbon)} x="548" y="92" width="14" height="80"></rect>
	<path {...sx(r.tocRibbonCut)} d="M548 172l7-8 7 8"></path>
	<rect {...anim('sweep', 1.2, h.deskCursor)} x="60" y="108" width="480" height="56"></rect>
</Drawing>
