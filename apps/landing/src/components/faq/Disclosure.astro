---
// One native <details> row: the question, then its answer. The motion
// runtime eases it open and shut; without it the row still works natively.
import { richText } from '../../lib/rich-text'
import { revealItem } from '../../lib/reveal'
import { sx } from '../../lib/sx'
import { disclosure as d } from './disclosure.styles'
import { disclosureMarker } from './disclosure.stylex'

type Props = { question: string; answer: string; isFirst?: boolean; isQa?: boolean }

const { question, answer, isFirst = false, isQa = false } = Astro.props
const answerHtml = isQa ? richText(answer, { a: d.qaLink, code: d.qaCode }) : answer
---

<details {...revealItem(d.row, isFirst && !isQa && d.firstRow, isQa && d.qaRow, disclosureMarker)}>
	<summary {...sx(d.summary, isQa && d.qaSummary)} set:html={question} />
	<p {...sx(d.answer, isQa && d.qaAnswer)} set:html={answerHtml} />
</details>
