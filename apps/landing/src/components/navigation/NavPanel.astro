---
// One dropdown panel: the section's links, then a footer linking its overview.
import type { Section } from '../../content/site-map'
import { sx } from '../../lib/sx'
import MenuLink from './MenuLink.astro'
import PreviewScenes from './PreviewScenes.astro'
import WorkflowLink from './WorkflowLink.astro'
import { menuFooterMarker } from './markers.stylex'
import { menuFooter } from './menu-footer.styles'
import { panel } from './panel.styles'

type Props = { section: Section; route: string }

const { section, route } = Astro.props
const isProduct = section.id === 'product'
const current = (href: string) => (href === route ? 'page' : undefined)
---

<section
	{...sx(panel.base, panel[section.id])}
	id={`${section.id}-menu`}
	aria-labelledby={`${section.id}-trigger`}
	aria-hidden="true"
	inert
	data-nav-panel
>
	{
		isProduct && (
			<div {...sx(panel.productBody)}>
				<div {...sx(panel.productLinks)}>
					{section.items.map(page => <MenuLink page={page} route={route} isPreviewing />)}
				</div>
				<PreviewScenes />
			</div>
		)
	}
	{
		section.id === 'workflows' && (
			<div {...sx(panel.workflowLinks)}>
				{section.items.map((page, index) => <WorkflowLink page={page} route={route} index={index} />)}
			</div>
		)
	}
	{
		section.id === 'resources' && (
			<div {...sx(panel.resourceLinks)}>
				{section.items.map(page => <MenuLink page={page} route={route} />)}
			</div>
		)
	}
	<a {...sx(menuFooter.base, menuFooterMarker)} href={section.href} aria-current={current(section.href)}>
		<span {...sx(menuFooter.pitch, isProduct && menuFooter.productPitch)}>{section.footer}</span>
		<span {...sx(menuFooter.overview, isProduct && menuFooter.productOverview)}>
			{section.overview} <span aria-hidden="true">→</span>
		</span>
	</a>
</section>
