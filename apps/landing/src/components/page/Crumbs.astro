---
// Where the page sits: the site, its section (unless it is the section's
// overview), the page itself.
import { siblingsOf } from '../../content/site-map'
import { sx } from '../../lib/sx'
import { pageHero as h } from './page-hero.styles'

type Props = { route: string; title: string }

const { route, title } = Astro.props
const { section } = siblingsOf(route)
const parent = section && section.href !== route ? section : undefined
---

<nav {...sx(h.crumbs)} aria-label="Breadcrumb">
	<a {...sx(h.crumbLink)} href="/">Syneva</a><span aria-hidden="true">/</span>{
		parent && (
			<Fragment>
				<a {...sx(h.crumbLink)} href={parent.href}>{parent.label}</a><span aria-hidden="true">/</span>
			</Fragment>
		)
	}<span {...sx(h.crumbCurrent)} aria-current="page">{title}</span>
</nav>
