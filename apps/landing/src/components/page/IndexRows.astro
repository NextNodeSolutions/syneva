---
// Linked rows for an overview page, from the section's pages; workflows
// show the command each one runs.
import type { Page } from '../../content/site-map'
import { revealItem } from '../../lib/reveal'
import { sx } from '../../lib/sx'
import Icon from '../Icon.astro'
import { indexRows as r } from './index-rows.styles'
import { indexRowMarker } from './page.stylex'
import { twoDigits } from '../../lib/step-number'

type Props = { items: readonly Page[]; hasCode?: boolean }

const { items, hasCode = false } = Astro.props
---

<div {...sx(r.root)}>
	{
		items.map((item, index) => (
			<a {...revealItem(r.row, indexRowMarker)} href={item.href}>
				<span {...sx(r.number)}>{twoDigits(index + 1)}</span>
				<Icon name={item.icon} css={r.icon} />
				<span>
					<strong {...sx(r.title)}>
						{item.title}
						{item.badge && (
							<Fragment>
								{' '}
								<em {...sx(r.badge)}>{item.badge}</em>
							</Fragment>
						)}
					</strong>
					<span {...sx(r.blurb)}>{item.blurb}</span>
				</span>
				{hasCode && <code {...sx(r.code)}>{item.code}</code>}
				<span {...sx(r.arrow)} aria-hidden="true">
					→
				</span>
			</a>
		))
	}
</div>
