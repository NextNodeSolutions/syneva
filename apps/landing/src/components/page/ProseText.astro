---
// A paragraph of a prose body: inline markup in the slot, or an HTML string.
import { revealItem } from '../../lib/reveal'
import { prose } from './prose.styles'

type Props = { html?: string }

const { html } = Astro.props
---

{html ? <p {...revealItem(prose.text)} set:html={html} /> : <p {...revealItem(prose.text)}><slot /></p>}
