---
// The primary action as a petrol button, leading where the launch stage says
// (primaryAction): `label` is its words once Syneva is live.
import type { Part } from '@shared/lib/sx'
import Button from '@shared/ui/Button.astro'
import { primaryAction } from '../model/primary-action'

type Props = { label: string; css?: Part }

const { label, css } = Astro.props
const action = primaryAction(label, Astro.locals.page)
---

<Button href={action.href} label={action.label} css={css} />
