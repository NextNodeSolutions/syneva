---
import Document from '@app/layouts/Document.astro'
import GetStartedPage from '@views/resources/ui/GetStartedPage.astro'
import { primaryAction } from '@entities/site/model/primary-action'
import { LAUNCH_STAGE } from '@entities/site/model/project'
import { pageTitle } from '@entities/site/model/routes'
import { PAGES } from '@entities/site/model/site-map'

// The setup guide is built once Syneva is live. Until then its address
// prerenders a redirect to the signup, so a link to it still lands somewhere.
if (LAUNCH_STAGE !== 'live') {
	return Astro.redirect(primaryAction(PAGES.getStarted.title, 'lost').href)
}
---

<Document
	title={pageTitle(PAGES.getStarted.title)}
	description={'Install Syneva, open a desk over your agent’s diff, and let your agent hear back. The whole path from install to your first verdict, for pi and for any other agent.'}
>
	<GetStartedPage />
</Document>
