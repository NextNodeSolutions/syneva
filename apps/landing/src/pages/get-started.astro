---
import StartFlow from '../art/resources/StartFlow.astro'
import Command from '../components/Command.astro'
import Callout from '../components/page/Callout.astro'
import PageHero from '../components/page/PageHero.astro'
import Pager from '../components/page/Pager.astro'
import Prose from '../components/page/Prose.astro'
import ProseText from '../components/page/ProseText.astro'
import SpecTable from '../components/page/SpecTable.astro'
import Terminal from '../components/page/Terminal.astro'
import TextLink from '../components/TextLink.astro'
import { REPO_URL } from '../content/site-map'
import Document from '../layouts/Document.astro'

const route = '/get-started/'
const REQUIREMENTS = [
	['Node 22+', 'For the CLI.'],
	['git', 'Every review mode reads your repository through git.'],
	['A browser', 'The desk is a tab on localhost.'],
	['Your coding agent', 'Codex, Cursor, pi, or anything that runs a shell command.'],
	['gh (optional)', 'Only to review pull requests by number or URL.'],
] as const
const INSTALL = ['# with pi: pin a tag or commit', '$ pi install git:github.com/walid-mos/syneva@<ref>', '', '# anywhere else', '$ npm install -g syneva']
const OPEN = ['$ cd your-repository', '$ syneva', '# desk ready, open in your browser']
const LOOP = [
	'# your agent, after it edits',
	'$ syneva await          # blocks until you Send or ask',
	'$ syneva comment …      # answers your question on the line',
	'$ syneva reload         # shows its next revision in your tab',
]
const FIRST_KEYS = [
	['j / k', 'Move between changes'],
	['⇧Y / ⇧N', 'Keep or undo the change'],
	['c, then ⌘⇧↵', 'Ask your agent about the line'],
	['⇧A', 'Approve the whole file'],
	['⇧S', 'Send your verdict to the agent'],
	['?', 'Every other key'],
] as const
---

<Document
	route={route}
	page="sub"
	title="Get started · Syneva"
	description={'Install Syneva, open a desk over your agent’s diff, and let your agent hear back. The whole path from install to your first verdict, for pi and for any other agent.'}
>
	<PageHero
		route={route}
		crumb="Get started"
		title="From install to your first verdict."
		lede="Two commands open a desk. One more lets your agent hear back. Here is the whole path, for pi and for every other agent."
		caption="Install · open a desk · attach your agent"
	>
		<Command slot="actions" text="npm install -g syneva" label="Installation command" />
		<StartFlow slot="art" />
	</PageHero>
	<Prose id="requirements" title="What you need.">
		<SpecTable rows={REQUIREMENTS} head={['Requirement', 'Why']} />
	</Prose>
	<Prose id="install" title="1. Install.">
		<ProseText>As a pi package, Syneva ships the CLI, a <code>/syneva</code> status command, the <code>/review</code> and <code>/plan</code> prompt templates, a skill, and a read-only answer subagent. Everywhere else, install the CLI from npm.</ProseText>
		<Terminal lines={INSTALL} title="install" />
	</Prose>
	<Prose id="open" title="2. Open a desk.">
		<ProseText>Run it next to the repository your agent just changed. The desk opens in your browser and stays open across rounds.</ProseText>
		<Terminal lines={OPEN} title="your repository" />
		<ProseText><TextLink href="/workflows/" label="Staged changes, pull requests and single files" /></ProseText>
	</Prose>
	<Prose id="attach" title="3. Let your agent<br>hear back.">
		<ProseText><strong>In pi,</strong> run <code>/review</code>: it starts a desk and attaches your session, so your Sends and questions reach the agent on their own.</ProseText>
		<ProseText><strong>With any other agent,</strong> ask it to run <code>syneva spec</code> and follow the loop it describes. In short:</ProseText>
		<Terminal lines={LOOP} title="your agent" />
		<ProseText><TextLink href="/resources/connect-your-agent/" label="The full agent contract" /></ProseText>
	</Prose>
	<Prose id="review" title="4. Review<br>and Send.">
		<SpecTable rows={FIRST_KEYS} head={['Keys', 'Does']} />
		<Callout lead={'That’s the loop.'} isGreen>Your agent acts on the verdict, reloads, and the next round lands in the same tab. Stuck somewhere? <TextLink href="/resources/faq/" label="Questions & answers" /> or <TextLink href={`${REPO_URL}/issues`} label="open an issue" isExternal />.</Callout>
	</Prose>
	<Pager route={route} />
</Document>
