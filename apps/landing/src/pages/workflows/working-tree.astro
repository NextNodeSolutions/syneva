---
import Document from '@app/layouts/Document.astro'
import WorkingTreePage from '@views/workflows/ui/WorkingTreePage.astro'

const route = '/workflows/working-tree/'
---

<Document
	route={route}
	page="sub"
	title="Working tree review · Syneva"
	description="Run syneva in your repository and review everything your agent just changed: modified files as diffs, new files as full-file additions. Narrow it with --path."
>
	<WorkingTreePage route={route} />
</Document>
