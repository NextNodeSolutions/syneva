---
// The hero: the headline set as a two-line diff (the agent's addition, then
// your verdict), the pitch and its actions, and the review-round instrument.
import { poses } from '@syneva/motion/poses'

import Button from '../../components/Button.astro'
import Command from '../../components/Command.astro'
import FigureTop from '../../components/FigureTop.astro'
import TextLink from '../../components/TextLink.astro'
import { scene } from '../../lib/reveal'
import { sx } from '../../lib/sx'
import HeroStage from './HeroStage.astro'
import { heroBody as b } from './hero-body.styles'
import { hero as h } from './hero.styles'
import { heroMarker, newsMarker } from './hero.stylex'
---

<section {...sx(h.root, heroMarker)} aria-labelledby="hero-title" data-hero>
	<div {...sx(h.field)} aria-hidden="true"><span {...sx(h.light)}></span></div>
	<a {...sx(h.news, poses.stalledShow, newsMarker)} href="/resources/changelog/" data-hero-intro="news">
		<span {...sx(h.newsTag)}>New</span><span {...sx(h.newsText)}>Review notes: every comment and question, one keystroke away</span><span {...sx(h.newsArrow)} aria-hidden="true">→</span>
	</a>
	<h1 {...sx(h.title)} id="hero-title">
		<span {...sx(h.line)}>
			<span {...sx(h.gutter, poses.stalledShow)} aria-hidden="true" data-hero-intro="gutter"><i {...sx(h.number)}>1</i><b {...sx(h.mark, h.agentMark)} data-hero-intro="agent-mark">+</b></span>
			<span {...sx(h.clip, h.agentBand, poses.stalledBand)} data-hero-intro="agent-band"><span {...sx(h.text, poses.stalledShow)} data-hero-intro="agent-text">Your agent writes.</span></span>
		</span>
		<span {...sx(h.line, h.nextLine)}>
			<span {...sx(h.gutter, poses.stalledShow)} aria-hidden="true" data-hero-intro="gutter"><i {...sx(h.number)}>2</i><b {...sx(h.mark)} data-hero-intro="human-mark"><svg {...sx(h.check)} viewBox="0 0 20 20"><path {...sx(h.checkPath)} d="m4 10.5 4 4 8-9" data-hero-intro="human-check"></path></svg></b></span>
			<span {...sx(h.clip, h.humanBand, poses.stalledBand)} data-hero-intro="human-band"><span {...sx(h.text, poses.stalledShow)} data-hero-intro="human-text">You <em {...sx(h.decide)}>decide<svg {...sx(h.underline)} viewBox="0 0 320 18" preserveAspectRatio="none" aria-hidden="true"><path {...sx(h.underlinePath)} d="M6 12C80 5 230 4 314 10" pathLength="100" data-hero-intro="underline"></path></svg></em> what ships.</span></span>
		</span>
	</h1>
	<div {...sx(b.body)}>
		<div {...sx(b.copy, poses.stalledShow)} data-hero-intro="copy">
			<p {...sx(b.lede)}>Syneva is the review desk for code your agent wrote. Read the diff in a reading order, ask about the exact line, give every change a verdict, and hand a structured result back to your agent. Same tab, every round.</p>
			<div {...sx(b.actions)}>
				<Button href="/get-started/" label="Start a local review" />
				<TextLink href="#how" label="See how it works" arrow="↓" />
			</div>
			<Command text="npm install -g syneva" label="Installation command" css={b.command} />
			<p {...sx(b.works)}><span {...sx(b.worksLead)}>Works with the agent you already use</span> Codex · Cursor · pi · your own scripts</p>
		</div>
		<figure {...sx(b.stage, poses.stalledShow)} {...scene} data-hero-intro="stage">
			<FigureTop subject="ONE REVIEW ROUND" aside="ILLUSTRATIVE · NOT A SCREENSHOT" isLive asideCss={b.stageAside} />
			<HeroStage />
		</figure>
	</div>
</section>

<script>
	import './hero.client'
</script>
