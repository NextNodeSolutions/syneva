---
// A ledger verdict glyph centred on (x, y): kept, undone or still pending.
import { sx } from '../../lib/sx'
import { hs } from './hero-stage.styles'

type Props = { kind: 'yes' | 'no' | 'pending'; x: number; y: number }

const { kind, x, y } = Astro.props
const HALF = 7
const SIZE = 14
const box = { x: x - HALF, y: y - HALF, width: SIZE, height: SIZE }
---

{
	kind === 'yes' && (
		<Fragment>
			<rect {...sx(hs.glyphYes)} {...box} />
			<path {...sx(hs.glyphCheck)} d={`m${x - 3.5} ${y}l2.5 2.6 4.6-5.2`} />
		</Fragment>
	)
}
{
	kind === 'no' && (
		<Fragment>
			<rect {...sx(hs.glyphNo)} {...box} />
			<path {...sx(hs.glyphX)} d={`m${x - 3} ${y - 3} 6 6m0-6-6 6`} />
		</Fragment>
	)
}
{kind === 'pending' && <rect {...sx(hs.glyphPending)} {...box} />}
