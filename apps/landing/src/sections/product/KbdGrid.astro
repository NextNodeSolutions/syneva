---
// The desk's keyboard map: the real bindings, two to a row.
import { revealItem } from '../../lib/reveal'
import { sx } from '../../lib/sx'
import { kbdGrid as k } from './kbd-grid.styles'

type Props = { keys: readonly (readonly [string, string])[] }

const { keys } = Astro.props
---

<div {...revealItem(k.root)}>
	{
		keys.map(([key, label]) => (
			<div {...sx(k.row)}>
				<kbd {...sx(k.key)}>{key}</kbd>
				<span {...sx(k.label)}>{label}</span>
			</div>
		))
	}
</div>
