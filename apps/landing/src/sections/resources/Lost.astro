---
// The 404: this page, as a change that was undone.
import LostDiff from '../../art/resources/LostDiff.astro'
import Button from '../../components/Button.astro'
import { pageActionsMarker } from '../../components/page/page.stylex'
import TextLink from '../../components/TextLink.astro'
import { revealGroup, revealItem, scene } from '../../lib/reveal'
import { lost as l } from './lost.styles'
---

<section {...revealGroup(false, l.root)} aria-labelledby="page-title">
	<div>
		<h1 {...revealItem(l.title)} id="page-title">This change<br />was undone.</h1>
		<p {...revealItem(l.text)}>The page you asked for doesn&rsquo;t exist, or moved. Everything that does is one click away.</p>
		<div {...revealItem(l.actions, pageActionsMarker)}><Button href="/" label="Back to the home page" /><TextLink href="/get-started/" label="Get started" /></div>
	</div>
	<figure {...revealItem(l.art)} {...scene}><LostDiff /></figure>
</section>
