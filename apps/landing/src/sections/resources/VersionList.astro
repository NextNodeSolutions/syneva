---
// The changelog's weeks: a date, a headline and the tagged changes.
import { revealItem } from '../../lib/reveal'
import { sx } from '../../lib/sx'
import { versionList as v } from './version-list.styles'

export type Week = {
	iso: string
	label: string
	title: string
	changes: readonly (readonly ['feat' | 'fix' | 'perf', string])[]
}
type Props = { weeks: readonly Week[] }

const { weeks } = Astro.props
const TAG = { feat: v.feat, fix: v.fix, perf: v.perf } as const
---

<ol {...sx(v.root)}>
	{
		weeks.map(({ iso, label, title, changes }) => (
			<li {...revealItem(v.week)}>
				<time {...sx(v.date)} datetime={iso}>{label}</time>
				<h3 {...sx(v.title)}>{title}</h3>
				<ul {...sx(v.changes)}>
					{changes.map(([kind, change]) => (
						<li {...sx(v.change)}>
							<b {...sx(v.tag, TAG[kind])}>{kind}</b>
							{change}
						</li>
					))}
				</ul>
			</li>
		))
	}
</ol>
