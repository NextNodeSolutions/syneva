---
// The wordmark: the Syneva mark (it turns on hover) and the name.
import {
	MARK_DIAMOND,
	MARK_RAYS,
	MARK_VIEW_BOX,
	WORDMARK,
} from '@syneva/design-system/brand'
import { sx } from '../lib/sx'
import { brand } from './brand.styles'
import { brandMarker } from './brand.stylex'
---

<a {...sx(brand.link, brandMarker)} href="/" aria-label="Syneva home">
	<svg {...sx(brand.mark)} viewBox={MARK_VIEW_BOX} aria-hidden="true">
		<path d={MARK_RAYS}></path>
		<path d={MARK_DIAMOND}></path>
	</svg>
	{WORDMARK}
</a>
