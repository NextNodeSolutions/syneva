---
// The secondary action: an underlined link; one to another site (an
// absolute URL) points up-right, unless `arrow` names its own glyph.
import type { Part } from '../lib/sx'
import { sx } from '../lib/sx'
import { textLink } from './text-link.styles'
import { textLinkMarker } from './actions.stylex'

type Props = { href: string; label: string; arrow?: string; css?: Part }

const { href, label, arrow, css } = Astro.props
const glyph = arrow ?? (URL.canParse(href) ? '↗' : '→')
// Subpages (and the 404) set chapter links a step lower; the home's links
// stand alone and take a touch target on phones instead.
const isSubpageSheet = Astro.locals.page !== 'home'
---

<a {...sx(textLink.base, isSubpageSheet ? textLink.inChapterSub : textLink.touch, css, textLinkMarker)} href={href}>
	{label} <span {...sx(textLink.arrow)} aria-hidden="true">{glyph}</span>
</a>
