---
// The id names the title, the description and the frame's grid, so it must be unique on its page; any data-* passed on (a runtime hook like data-circuit) lands on the root <svg>.
import type { Part } from '../../lib/sx'
import { sx } from '../../lib/sx'
import ArtFrame from './ArtFrame.astro'
import { drawingMarker } from './drawing.stylex'
import { drawing } from './drawing.styles'

type DataAttributes = { [attribute: `data-${string}`]: string | true }

type Props = DataAttributes & {
	id: string
	width: number
	height: number
	title: string
	description: string
	compact?: string
	density?: 'regular' | 'dense'
	css?: Part
}

const { id, width, height, title, description, compact, density = 'regular', css, ...dataAttributes } = Astro.props
const titleId = `${id}-title`
const descriptionId = `${id}-desc`
const isSubpage = Astro.locals.page === 'sub'
const fitOf = (): Part => {
	if (!isSubpage) return compact && drawing.compact
	return compact ? drawing.subpageCompact : drawing.subpage
}
const fit = fitOf()
// A bare attribute arrives as true, which a spread would print as ="true".
const hooks = Object.fromEntries(Object.entries(dataAttributes).map(([name, value]) => [name, value === true ? '' : value]))
---

<svg
	{...sx(drawing.root, fit, css, drawingMarker, density === 'dense' && 'is-dense')}
	viewBox={`0 0 ${width} ${height}`}
	data-compact={compact}
	role="img"
	aria-labelledby={`${titleId} ${descriptionId}`}
	{...hooks}
>
	<title id={titleId}>{title}</title>
	<desc id={descriptionId}>{description}</desc>
	<slot name="frame"><ArtFrame id={id} width={width} height={height} /></slot>
	<slot />
</svg>
