---
// The root <svg> of every drawing: its viewBox and ruled frame, the phone
// frame it reframes to (data-compact, swapped by frames.ts) and its
// accessible name. The id names the title, the description and the frame's
// grid, so it must be unique on its page. A drawing without the ruled frame
// fills the frame slot with nothing.
import type { Part } from '../../lib/sx'
import { sx } from '../../lib/sx'
import ArtFrame from './ArtFrame.astro'
import { drawingMarker } from './art.stylex'
import { drawing } from './drawing.styles'

type Props = {
	id: string
	width: number
	height: number
	title: string
	description: string
	compact?: string
	// A dense diagram grows its labels on the phone frame.
	density?: 'regular' | 'dense'
	css?: Part
}

const { id, width, height, title, description, compact, density = 'regular', css } = Astro.props
const titleId = `${id}-title`
const descriptionId = `${id}-desc`
const isSubpage = Astro.locals.page === 'sub'
const fitOf = (): Part => {
	if (!isSubpage) return compact && drawing.compact
	return compact ? drawing.subpageCompact : drawing.subpage
}
const fit = fitOf()
---

<svg
	{...sx(drawing.root, fit, css, drawingMarker, density === 'dense' && 'is-dense')}
	viewBox={`0 0 ${width} ${height}`}
	data-compact={compact}
	role="img"
	aria-labelledby={`${titleId} ${descriptionId}`}
>
	<title id={titleId}>{title}</title>
	<desc id={descriptionId}>{description}</desc>
	<slot name="frame"><ArtFrame id={id} width={width} height={height} /></slot>
	<slot />
</svg>
