---
import { sx } from '../../lib/sx'
import { MARK_SIZE } from './mark-size'
import { shape } from './shape.styles'

type Props = { x: number; y: number; size?: number }

const { x, y, size = MARK_SIZE } = Astro.props
const arm = (size * 3) / 7
const corner = { x: x + (size - arm) / 2, y: y + (size - arm) / 2 }
const cross = `m${corner.x} ${corner.y} ${arm} ${arm}m0-${arm}-${arm} ${arm}`
---

<rect {...sx(shape.no)} x={x} y={y} width={size} height={size}></rect><path {...sx(shape.cross)} d={cross}></path>
