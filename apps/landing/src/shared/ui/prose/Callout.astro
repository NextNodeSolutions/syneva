---
// A boxed aside: a lead line, then its explanation (the default slot). Its
// square follows the palette: an open point in petrol, a settled one in
// green.
import { revealItem } from '../../lib/reveal'
import { sx } from '../../lib/sx'
import { callout } from './callout.styles'

type Props = { lead: string; tone?: 'open' | 'settled' }

const { lead, tone = 'open' } = Astro.props
---

<div {...revealItem(callout.root, callout[tone])}>
	<div><p {...sx(callout.lead)} set:html={lead} /><p {...sx(callout.rest)}><slot /></p></div>
</div>
