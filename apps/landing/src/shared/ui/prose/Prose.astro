---
// A prose section: its heading on the left, the body (default slot) on the
// right, ruled from the section above.
import { revealItem, revealRuledGroup } from '../../lib/reveal'
import { section } from '../section.styles'
import { prose } from './prose.styles'

type Props = { id?: string; title: string }

const { id, title } = Astro.props
---

<section {...revealRuledGroup(prose.root, section.pad)} id={id}>
	<h2 {...revealItem(prose.title)} set:html={title} />
	<div><slot /></div>
</section>
