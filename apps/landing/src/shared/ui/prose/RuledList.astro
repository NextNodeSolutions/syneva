---
// Numbered points, each under its own rule.
import { revealItem } from '../../lib/reveal'
import { sx } from '../../lib/sx'
import { stepIndex } from '../step-index.styles'
import { ruledList } from './prose.styles'
import { twoDigits } from '../../lib/step-number'

type Props = { items: readonly (readonly [string, string])[] }

const { items } = Astro.props
---

<ol {...sx(ruledList.root)}>
	{
		items.map(([head, text], index) => (
			<li {...revealItem(ruledList.item)}>
				<span {...sx(stepIndex.base, ruledList.index)}>{twoDigits(index + 1)}</span>
				<strong {...sx(ruledList.head)} set:html={head} />
				<p {...sx(ruledList.text)} set:html={text} />
			</li>
		))
	}
</ol>
