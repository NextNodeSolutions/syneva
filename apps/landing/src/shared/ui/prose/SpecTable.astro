---
// Key/value rows in mono, for flags, events and fields. Cells are HTML, as
// the copy is written.
import { revealItem } from '../../lib/reveal'
import { sx } from '../../lib/sx'
import { specTable as t } from './prose.styles'

type Props = { rows: readonly (readonly [string, string])[]; head: readonly [string, string] }

const { rows, head } = Astro.props
---

<div {...revealItem(t.root)} role="table">
	<div {...sx(t.row, t.head)} role="row"><span {...sx(t.value)} role="columnheader">{head[0]}</span><span {...sx(t.value)} role="columnheader">{head[1]}</span></div>
	{
		rows.map(([key, value]) => (
			<div {...sx(t.row)} role="row">
				<code {...sx(t.key)} role="cell" set:html={key} />
				<span {...sx(t.value)} role="cell" set:html={value} />
			</div>
		))
	}
</div>
