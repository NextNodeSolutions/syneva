---
// A terminal-style block. "$ " lines are commands, "#" lines comments,
// anything else output; an empty line keeps its height.
import { revealItem } from '../../lib/reveal'
import { sx } from '../../lib/sx'
import { terminal } from './terminal.styles'

type Props = { lines: readonly string[]; title: string }

const { lines, title } = Astro.props
const PROMPT = '$ '
const kindOf = (line: string): 'command' | 'comment' | 'output' => {
	if (line.startsWith(PROMPT)) return 'command'
	return line.startsWith('#') ? 'comment' : 'output'
}
---

<figure {...revealItem(terminal.root)}>
	<div {...sx(terminal.top)}>
		<span {...sx(terminal.dots)} aria-hidden="true"><i {...sx(terminal.dot)}></i><i {...sx(terminal.dot)}></i><i {...sx(terminal.dot)}></i></span><span>{title}</span>
	</div><pre {...sx(terminal.body)}>{
		lines.map(line => {
			const kind = kindOf(line)
			if (kind === 'command')
				return (
					<span {...sx(terminal.command)}><span {...sx(terminal.prompt)} aria-hidden="true">$</span>{line.slice(PROMPT.length)}</span>
				)
			return <span {...sx(kind === 'comment' ? terminal.comment : terminal.output)}>{line || ' '}</span>
		})
	}</pre>
</figure>
