---
// Numbers we can actually promise: product facts, never adoption metrics.
import { SECTION_BY_ID } from '@entities/site/model/site-map'
import { ruledItem } from '@shared/ui/ruled-item.styles'
import { section } from '@shared/ui/section.styles'
import { revealCount, revealItem, revealRuledGroup } from '@shared/lib/reveal'
import { sx } from '@shared/lib/sx'
import { facts } from './facts.styles'

// One review mode per workflow page.
const REVIEW_MODES = SECTION_BY_ID.workflows.items.length
// A count prints bare unless it carries a unit, set smaller after it.
type Fact = { count: number; unit?: '%'; label: string }
const FACTS: readonly Fact[] = [
	{ count: 0, label: 'changes auto-approved. Every verdict is a click you made.' },
	{ count: 1, label: 'tab for the whole loop: review, questions and the next revision.' },
	{ count: REVIEW_MODES, label: 'review modes: working tree, staged, a branch or PR, a single file.' },
	{ count: 100, unit: '%', label: 'local. No model inside, no telemetry, no account.' },
]
---

<section {...revealRuledGroup(section.ruled, section.pad)} id="facts" aria-labelledby="facts-title">
	<div {...sx(section.head, facts.head)}>
		<h2 {...revealItem()} id="facts-title">Numbers we can<br />actually promise.</h2>
		<p {...revealItem(section.headText, facts.headText)}>No adoption charts, no borrowed logos. These are product facts: true on your machine the moment you install it.</p>
	</div>
	<div {...sx(facts.stats)}>
		{
			FACTS.map(({ count, unit, label }, i) => (
				<div {...revealItem(ruledItem.base, facts.stat)}>
					<span {...sx(facts.number, i === 0 && facts.first)} {...revealCount(count)}>
						{count}{unit && <span {...sx(facts.unit)}>{unit}</span>}
					</span>
					<span {...sx(facts.label)}>{label}</span>
				</div>
			))
		}
	</div>
</section>
