---
// The handoff contract: the verdict your agent receives, as the review event
// it reads. Fields match packages/contracts/src/agent.ts; the round is
// illustrative and trimmed.
import FigureTop from '@shared/ui/FigureTop.astro'
import TextLink from '@shared/ui/TextLink.astro'
import { section } from '@shared/ui/section.styles'
import { REPO_URL } from '@entities/site/model/site-map'
import { mapClasses } from '@shared/lib/class-map'
import { revealGroup, revealItem } from '@shared/lib/reveal'
import { sx } from '@shared/lib/sx'
import { handoff as h, json } from './handoff.styles'

const k = (name: string) => `<span class="j-key">"${name}"</span>`
const s = (text: string) => `<span class="j-str">"${text}"</span>`
const n = (num: string) => `<span class="j-num">${num}</span>`
const p = (marks: string) => `<span class="j-punc">${marks}</span>`
const line = (body: string, kind = '') => `<span class="j-line${kind ? ` is-${kind}` : ''}">${body}</span>`
const LISTING = [
	line(`${p('{')} ${k('kind')}${p(':')} ${s('review')}${p(',')} ${k('result')}${p(': {')}`),
	line(`  ${k('mode')}${p(':')} ${s('repo')}${p(',')}`),
	line(`  ${k('accepted')}${p(': [{')} ${k('path')}${p(':')} ${s('auth/session.ts')}${p(',')} ${k('lineNumber')}${p(':')} ${n('14')}${p(',')}`, 'yes'),
	line(`      ${k('side')}${p(':')} ${s('additions')}${p(',')} ${k('title')}${p(':')} ${s('Verify the session first')} ${p('}],')}`, 'yes'),
	line(`  ${k('rejected')}${p(': [{')} ${k('path')}${p(':')} ${s('pages/desk.tsx')}${p(',')} ${k('lineNumber')}${p(':')} ${n('41')}${p(', … }],')}`, 'no'),
	line(`  ${k('requestedChanges')}${p(': [{')} ${k('path')}${p(':')} ${s('api/middleware.ts')}${p(',')} ${k('lineNumber')}${p(':')} ${n('20')}${p(',')}`, 'ask'),
	line(`      ${k('body')}${p(':')} ${s('Log why the session was rejected.')} ${p('}],')}`, 'ask'),
	line(`  ${k('approvedFiles')}${p(': [')}${s('contracts/review.ts')}${p(',')} ${s('lib/hash.ts')}${p('],')}`),
	line(`  ${k('openQuestions')}${p(': [],')}`),
	line(`  ${k('overallNote')}${p(':')} ${s('Run the formatter after.')}`),
	line(p('} }')),
].join('')
const listing = mapClasses(LISTING, {
	'j-line': json.line,
	'is-yes': json.yes,
	'is-no': json.no,
	'is-ask': json.ask,
	'j-key': json.key,
	'j-str': json.str,
	'j-num': json.num,
	'j-punc': json.punc,
})
---

<section {...revealGroup(true, section.ruled, section.pad, h.section)} id="handoff" aria-labelledby="handoff-title">
	<div>
		<h2 {...revealItem()} id="handoff-title">The verdict,<br />as a contract.</h2>
		<p {...revealItem(h.text)}>Send to Agent hands back a structured <code {...sx(h.code)}>ReviewResult</code>, printed to stdout and written to disk. Not a screenshot, not a vibe: your agent knows exactly what you kept, what you undid, and what you asked for.</p>
		<p {...revealItem(h.text)}>It acts on the round, calls <code {...sx(h.code)}>syneva reload</code>, and the same tab shows its next revision. Your settled decisions carry over; its new edits come back pending.</p>
		<div {...revealItem(h.links)}>
			<TextLink href="/resources/connect-your-agent/" label="Connect your agent" />
			<TextLink href={`${REPO_URL}/blob/main/packages/contracts/src/spec.ts`} label="Read the full contract" isExternal />
		</div>
	</div>
	<figure {...revealItem(h.figure)}>
		<FigureTop subject="$ syneva await" aside="EVENT · REVIEW" />
		<pre {...sx(h.json)} aria-label="Illustrative review event" set:html={listing} />
		<figcaption {...sx(h.caption)}>Illustrative round, trimmed. The full shape is versioned with the CLI: <code {...sx(h.code)}>syneva spec</code></figcaption>
	</figure>
</section>
