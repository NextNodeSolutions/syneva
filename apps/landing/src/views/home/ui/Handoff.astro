---
// The handoff contract: the verdict your agent receives, as the review event
// it reads. Its fields are typed by @syneva/contracts (handoff-listing.ts);
// the round is illustrative and trimmed.
import FigureTop from '@shared/ui/FigureTop.astro'
import TextLink from '@shared/ui/TextLink.astro'
import { section } from '@shared/ui/section.styles'
import { PAGES, REPO_URL } from '@entities/site/model/site-map'
import { revealItem, revealRuledGroup } from '@shared/lib/reveal'
import { sx } from '@shared/lib/sx'
import { HANDOFF_LISTING } from './handoff-listing'
import { handoff } from './handoff.styles'
---

<section {...revealRuledGroup(section.ruled, section.pad, handoff.section)} id="handoff" aria-labelledby="handoff-title">
	<div>
		<h2 {...revealItem()} id="handoff-title">The verdict,<br />as a contract.</h2>
		<p {...revealItem(handoff.text)}>Send to Agent hands back a structured <code {...sx(handoff.code)}>ReviewResult</code>, printed to stdout and written to disk. Not a screenshot, not a vibe: your agent knows exactly what you kept, what you undid, and what you asked for.</p>
		<p {...revealItem(handoff.text)}>It acts on the round, calls <code {...sx(handoff.code)}>syneva reload</code>, and the same tab shows its next revision. Your settled decisions carry over; its new edits come back pending.</p>
		<div {...revealItem(handoff.links)}>
			<TextLink href={PAGES.connectYourAgent.href} label="Connect your agent" />
			<TextLink href={`${REPO_URL}/blob/main/packages/contracts/src/spec.ts`} label="Read the full contract" />
		</div>
	</div>
	<figure {...revealItem(handoff.figure)}>
		<FigureTop subject="$ syneva await" aside="EVENT · REVIEW" />
		<pre {...sx(handoff.json)} aria-label="Illustrative review event" set:html={HANDOFF_LISTING} />
		<figcaption {...sx(handoff.caption)}>Illustrative round, trimmed. The full shape is versioned with the CLI: <code {...sx(handoff.code)}>syneva spec</code></figcaption>
	</figure>
</section>
