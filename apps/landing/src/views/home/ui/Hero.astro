---
// The hero: the headline set as a two-line diff (the agent's addition, then
// your verdict), the pitch and its actions, and the review-round instrument.
import { poses } from '@syneva/motion/poses'

import Button from '@shared/ui/Button.astro'
import Command from '@features/copy-command/ui/Command.astro'
import FigureTop from '@shared/ui/FigureTop.astro'
import TextLink from '@shared/ui/TextLink.astro'
import { scene } from '@shared/lib/reveal'
import { sx } from '@shared/lib/sx'
import HeroStage from './HeroStage.astro'
import { heroBody } from './hero-body.styles'
import { hero } from './hero.styles'
import { heroMarker, newsMarker } from './hero.stylex'
---

<section {...sx(hero.root, heroMarker)} aria-labelledby="hero-title" data-hero>
	<div {...sx(hero.field)} aria-hidden="true"><span {...sx(hero.light)}></span></div>
	<a {...sx(hero.news, poses.stalledShow, newsMarker)} href="/resources/changelog/" data-hero-intro="news">
		<span {...sx(hero.newsTag)}>New</span><span {...sx(hero.newsText)}>Review notes: every comment and question, one keystroke away</span><span {...sx(hero.newsArrow)} aria-hidden="true">→</span>
	</a>
	<h1 {...sx(hero.title)} id="hero-title">
		<span {...sx(hero.line)}>
			<span {...sx(hero.gutter, poses.stalledShow)} aria-hidden="true" data-hero-intro="gutter"><i {...sx(hero.number)}>1</i><b {...sx(hero.mark, hero.agentMark)} data-hero-intro="agent-mark">+</b></span>
			<span {...sx(hero.clip, hero.agentBand, poses.stalledBand)} data-hero-intro="agent-band"><span {...sx(hero.text, poses.stalledShow)} data-hero-intro="agent-text">Your agent writes.</span></span>
		</span>
		<span {...sx(hero.line, hero.nextLine)}>
			<span {...sx(hero.gutter, poses.stalledShow)} aria-hidden="true" data-hero-intro="gutter"><i {...sx(hero.number)}>2</i><b {...sx(hero.mark)} data-hero-intro="human-mark"><svg {...sx(hero.check)} viewBox="0 0 20 20"><path {...sx(hero.checkPath)} d="m4 10.5 4 4 8-9" data-hero-intro="human-check"></path></svg></b></span>
			<span {...sx(hero.clip, hero.humanBand, poses.stalledBand)} data-hero-intro="human-band"><span {...sx(hero.text, poses.stalledShow)} data-hero-intro="human-text">You <em {...sx(hero.decide)}>decide<svg {...sx(hero.underline)} viewBox="0 0 320 18" preserveAspectRatio="none" aria-hidden="true"><path {...sx(hero.underlinePath)} d="M6 12C80 5 230 4 314 10" pathLength="100" data-hero-intro="underline"></path></svg></em> what ships.</span></span>
		</span>
	</h1>
	<div {...sx(heroBody.body)}>
		<div {...sx(heroBody.copy, poses.stalledShow)} data-hero-intro="copy">
			<p {...sx(heroBody.lede)}>Syneva is the review desk for code your agent wrote. Read the diff in a reading order, ask about the exact line, give every change a verdict, and hand a structured result back to your agent. Same tab, every round.</p>
			<div {...sx(heroBody.actions)}>
				<Button href="/get-started/" label="Start a local review" />
				<TextLink href="#how" label="See how it works" arrow="↓" />
			</div>
			<Command text="npm install -g syneva" label="Installation command" css={heroBody.command} />
			<p {...sx(heroBody.works)}><span {...sx(heroBody.worksLead)}>Works with the agent you already use</span> Codex · Cursor · pi · your own scripts</p>
		</div>
		<figure {...sx(heroBody.stage, poses.stalledShow)} {...scene} data-hero-intro="stage">
			<FigureTop subject="ONE REVIEW ROUND" aside="ILLUSTRATIVE · NOT A SCREENSHOT" isLive asideCss={heroBody.stageAside} />
			<HeroStage />
		</figure>
	</div>
</section>

<script>
	import './hero.client'
</script>
