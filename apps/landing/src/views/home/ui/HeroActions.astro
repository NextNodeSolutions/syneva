---
// The hero's calls to action at the launch stage: once Syneva is live, the
// setup guide and the install command; until then, the signup.
import { INSTALL_COMMAND, LAUNCH_STAGE } from '@entities/site/model/project'
import { PAGES } from '@entities/site/model/site-map'
import Button from '@shared/ui/Button.astro'
import Command from '@features/copy-command/ui/Command.astro'
import SignupForm from '@features/subscribe/ui/SignupForm.astro'
import TextLink from '@shared/ui/TextLink.astro'
import { sx } from '@shared/lib/sx'
import { heroBody } from './hero-body.styles'
---

{
	LAUNCH_STAGE === 'live' ? (
		<Fragment>
			<div {...sx(heroBody.actions)}>
				<Button href={PAGES.getStarted.href} label="Start a local review" />
				<TextLink href="#how" label="See how it works" arrow="↓" />
			</div>
			<Command text={INSTALL_COMMAND} label="Installation command" css={heroBody.command} />
		</Fragment>
	) : (
		<Fragment>
			<SignupForm css={heroBody.signup} />
			<div {...sx(heroBody.actions, heroBody.afterSignup)}>
				<TextLink href="#how" label="See how it works" arrow="↓" />
			</div>
		</Fragment>
	)
}
