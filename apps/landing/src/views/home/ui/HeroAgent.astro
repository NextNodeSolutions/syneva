---
import { PATH_LENGTH } from '@syneva/motion/poses'
import { shape } from '@shared/ui/drawing/shape.styles'
import { sx } from '@shared/lib/sx'
import HeroCard from './HeroCard.astro'
import { CARDS, HERO_FILES } from './hero-round'
import { stagePart } from './hero-stage-part'
import { heroStage } from './hero-stage.styles'
---

<g {...sx(heroStage.layer, shape.secondary)} {...stagePart('agent')}>
	<text {...sx(heroStage.kicker)} x="30" y="40">YOUR AGENT</text>
	<text {...sx(heroStage.sub)} x="30" y="58">wrote {HERO_FILES.length} files · +214 −37</text>
	<path {...sx(heroStage.rail)} pathLength={PATH_LENGTH.draw} d="M18 92V288" {...stagePart('rail')}></path>
	<g {...stagePart('rail-dots')}>
		<rect {...sx(shape.dotAccent)} x="15" y="89" width="6" height="6"></rect>
		<rect {...sx(shape.dotAccent)} x="15" y="187" width="6" height="6"></rect>
		<rect {...sx(shape.dotAccent)} x="15" y="285" width="6" height="6"></rect>
	</g>
	{CARDS.map(({ path, verdict, bars }, position) => <HeroCard path={path} verdict={verdict} position={position} bars={bars} />)}
	<g {...sx(heroStage.fillBox)} opacity="0" {...stagePart('rev')}>
		<rect {...sx(shape.chipNo)} x="156" y="277" width="40" height="15"></rect>
		<text {...sx(heroStage.revText)} x="176" y="287.8" text-anchor="middle">REV 2</text>
	</g>
	<text {...sx(heroStage.sub)} x="202" y="374" text-anchor="end" {...stagePart('more')}>+{HERO_FILES.length - CARDS.length} more files</text>
	<path {...sx(heroStage.focus, heroStage.fillBox)} d="M22 176v-14h14M196 162h14v14M22 248v14h14M196 262h14v-14" fill="none" {...stagePart('focus')}></path>
	<circle {...sx(shape.port)} cx="202" cy="212" r="2.5"></circle>
	<circle {...sx(shape.port)} cx="116" cy="352" r="2.5"></circle>
</g>
