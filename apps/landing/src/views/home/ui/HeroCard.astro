---
// One of the agent's file cards: its position and path, then its code bars,
// each marked in the gutter as added, removed or context.
import { twoDigits } from '@shared/lib/two-digits'
import { sx } from '@shared/lib/sx'
import { heroStage } from './hero-stage.styles'

type Bar = readonly [kind: 'added' | 'removed' | 'context', width: number]
type Props = { path: string; position: number; bars: readonly Bar[] }

const { path, position, bars } = Astro.props
const MARK = { added: heroStage.markAdded, removed: heroStage.markRemoved, context: heroStage.markContext }
const y = 72 + position * 98
---

<g transform={`translate(30 ${y})`}>
	<g {...sx(heroStage.box)} data-stage-part="card">
		<rect {...sx(heroStage.sheet)} width="172" height="84"></rect>
		<text {...sx(heroStage.index)} x="12" y="20">{twoDigits(position + 1)}</text><text {...sx(heroStage.file)} x="34" y="20">{path}</text>
		<path {...sx(heroStage.hair)} d="M0 30h172"></path>
		{
			bars.map(([kind, width], row) => (
				<Fragment>
					<rect {...sx(MARK[kind])} x="12" y={42 + row * 12} width="4" height="4" />
					<rect {...sx(heroStage.bar, kind === 'context' && heroStage.faintBar)} data-bar={position} x="22" y={42 + row * 12} width={width} height="4" />
				</Fragment>
			))
		}
	</g>
</g>
