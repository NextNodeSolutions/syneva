---
// One of the agent's file cards: its index and path, then three code bars,
// each marked in the gutter as added, removed or context.
import { sx } from '@shared/lib/sx'
import { hs } from './hero-stage.styles'

type Props = { index: string; name: string; card: number }

const { index, name, card } = Astro.props
type Bar = readonly ['add' | 'del' | 'ctx', number]
const BARS: readonly (readonly Bar[])[] = [
	[['add', 96], ['add', 128], ['ctx', 70]],
	[['del', 84], ['add', 120], ['add', 92]],
	[['ctx', 110], ['add', 76], ['del', 120]],
]
const MARK = { add: hs.markAdd, del: hs.markDel, ctx: hs.markCtx }
const y = 72 + card * 98
---

<g transform={`translate(30 ${y})`}>
	<g {...sx(hs.box)} data-hs="card">
		<rect {...sx(hs.sheet)} width="172" height="84"></rect>
		<text {...sx(hs.index)} x="12" y="20">{index}</text><text {...sx(hs.file)} x="34" y="20">{name}</text>
		<path {...sx(hs.hair)} d="M0 30h172"></path>
		{
			(BARS[card] ?? []).map(([kind, width], row) => (
				<Fragment>
					<rect {...sx(MARK[kind])} x="12" y={42 + row * 12} width="4" height="4" />
					<rect {...sx(hs.bar, kind === 'ctx' && hs.faintBar)} data-bar={card} x="22" y={42 + row * 12} width={width} height="4" />
				</Fragment>
			))
		}
	</g>
</g>
