---
// The hero instrument: one review round, drawn as a technical figure. Your
// agent's files arrive scattered, settle into a reading order, one change
// opens on the desk, you ask, the agent answers, you accept, every file gets
// a verdict, Send hands it back and only the rejected file comes back pending.
//
// The markup IS the static pose (round 1, decided and ready to send): without
// JS or with reduced motion the figure still tells the whole story.
// hero.client.ts adds the timeline, one 16s clock for everything; data-stage-part
// names each piece it drives.
import { drawing } from '@shared/ui/drawing/drawing.styles'
import { shape } from '@shared/ui/drawing/shape.styles'
import { sx } from '@shared/lib/sx'
import HeroCard from './HeroCard.astro'
import HeroLedger from './HeroLedger.astro'
import { heroStage } from './hero-stage.styles'

const FILES = [
	['01', 'contracts/review.ts'],
	['02', 'auth/session.ts'],
	['03', 'pages/desk.tsx'],
] as const
const TO_DESK = 'M202 212C219 212 219 170 236 170'
const TO_LEDGER = 'M528 88C545 88 545 123 562 123'
const BACK = 'M651 352V388q0 12-12 12H128q-12 0-12-12V352'
const ROWS = [
	{ line: '12', code: 'export function handle(req) {', y: 126 },
	{ line: '13', sign: '−', code: 'return run(req)', y: 150, isDel: true },
	{ line: '14', sign: '+', code: 'await verifySession(req)', y: 174 },
	{ line: '15', sign: '+', code: 'return run(req)', y: 198 },
	{ line: '16', code: '}', y: 222 },
]
---

<svg
	{...sx(drawing.root, drawing.compact, heroStage.root)}
	viewBox="0 0 760 440"
	data-compact="224 22 316 342"
	role="img"
	aria-labelledby="hero-stage-title hero-stage-desc"
	data-hero-stage
>
	<title id="hero-stage-title">One review round, from your agent's diff to your verdict</title>
	<desc id="hero-stage-desc">Your agent's six changed files settle into a reading order. One change opens on your local desk: you ask why the session is checked there, your agent answers on that line, and you accept it. Every file gets your verdict, one is rejected, and Send hands the result back. The agent revises, and only the rejected file returns as pending. Illustrative, not a screenshot.</desc>
	<defs><pattern id="hero-stage-grid" width="26" height="26" patternUnits="userSpaceOnUse"><path d="M26 0H0V26" fill="none" stroke="var(--grid)"></path></pattern></defs>
	<g>
		<rect width="760" height="440" fill="url(#hero-stage-grid)"></rect>
		<path {...sx(shape.register, heroStage.phoneHidden)} d="M8 20V8h12M740 8h12v12M8 420v12h12M740 432h12v-12" fill="none"></path>
		<g {...sx(heroStage.phoneHidden)} fill="none">
			<path {...sx(heroStage.route)} d={TO_DESK}></path>
			<path {...sx(heroStage.route)} d={TO_LEDGER}></path>
			<path {...sx(heroStage.return)} d={BACK}></path>
			<path {...sx(heroStage.signal, heroStage.signalIn)} pathLength="100" d={TO_DESK} data-stage-part="signal-in"></path>
			<path {...sx(heroStage.signal, heroStage.signalOut)} pathLength="100" d={TO_LEDGER} data-stage-part="signal-out"></path>
			<path {...sx(heroStage.signal, heroStage.signalBack)} pathLength="100" d={BACK} data-stage-part="signal-back"></path>
		</g>
		<text {...sx(heroStage.loop, heroStage.phoneHidden)} x="384" y="424" text-anchor="middle">SAME TAB · NEXT ROUND</text>

		<g {...sx(heroStage.layer, heroStage.phoneHidden)} data-stage-part="agent">
			<text {...sx(heroStage.kicker)} x="30" y="40">YOUR AGENT</text>
			<text {...sx(heroStage.sub)} x="30" y="58">wrote 6 files · +214 −37</text>
			<path {...sx(heroStage.rail)} pathLength="1" d="M18 92V288" data-stage-part="rail"></path>
			<g data-stage-part="rail-dots">
				<rect {...sx(heroStage.railDot)} x="15" y="89" width="6" height="6"></rect>
				<rect {...sx(heroStage.railDot)} x="15" y="187" width="6" height="6"></rect>
				<rect {...sx(heroStage.railDot)} x="15" y="285" width="6" height="6"></rect>
			</g>
			{FILES.map(([index, name], i) => <HeroCard index={index} name={name} card={i} />)}
			<g {...sx(heroStage.box)} opacity="0" data-stage-part="rev">
				<rect {...sx(heroStage.revBox)} x="156" y="277" width="40" height="15"></rect>
				<text {...sx(heroStage.revText)} x="176" y="287.8" text-anchor="middle">REV 2</text>
			</g>
			<text {...sx(heroStage.sub)} x="202" y="374" text-anchor="end" data-stage-part="more">+3 more files</text>
			<path {...sx(heroStage.focus, heroStage.box)} d="M22 176v-14h14M196 162h14v14M22 248v14h14M196 262h14v-14" fill="none" data-stage-part="focus"></path>
			<circle {...sx(heroStage.port)} cx="202" cy="212" r="2.5"></circle>
			<circle {...sx(heroStage.port)} cx="116" cy="352" r="2.5"></circle>
		</g>

		<g {...sx(heroStage.layer)} data-stage-part="desk">
			<text {...sx(heroStage.kicker)} x="236" y="40">YOUR DESK</text>
			<text {...sx(heroStage.sub, heroStage.mono)} x="236" y="58">localhost:41873</text>
			<rect {...sx(heroStage.panel)} x="236" y="72" width="292" height="280"></rect>
			<g opacity="0" data-stage-part="idle">
				<text {...sx(heroStage.tiny)} x="382" y="215" text-anchor="middle">WAITING FOR YOUR AGENT’S DIFF</text>
				<rect {...sx(heroStage.caret)} x="379" y="225" width="6" height="11" data-stage-part="caret"></rect>
			</g>
			<g data-stage-part="head">
				<text {...sx(heroStage.file, heroStage.strong)} x="250" y="93">auth/session.ts</text>
				<text {...sx(heroStage.sub, heroStage.mono)} x="354" y="93">+2 −1</text>
				<g><rect {...sx(heroStage.button)} x="460" y="80" width="28" height="16"></rect><path {...sx(heroStage.buttonGlyph)} d="m471 85 6 6m0-6-6 6"></path></g>
				<g>
					<rect {...sx(heroStage.button, heroStage.accept)} x="492" y="80" width="28" height="16" data-stage-part="accept"></rect>
					<path {...sx(heroStage.buttonGlyph, heroStage.acceptGlyph)} d="m502 88 2.6 2.6 5-5.6" data-stage-part="accept-glyph"></path>
				</g>
			</g>
			<path {...sx(heroStage.hair)} d="M236 104h292"></path>
			<rect {...sx(heroStage.bandDel)} x="237" y="134" width="290" height="24" data-stage-part="band-del"></rect>
			<rect {...sx(heroStage.bandAdd)} x="237" y="158" width="290" height="48" data-stage-part="band-add"></rect>
			<rect {...sx(heroStage.sweep)} x="237" y="110" width="290" height="24" opacity="0" data-stage-part="sweep"></rect>
			{
				ROWS.map(({ line, sign, code, y, isDel }) => (
					<g data-stage-part="row">
						<text {...sx(heroStage.lineNumber)} x="262" y={y} text-anchor="end">{line}</text>
						{sign && <text {...sx(heroStage.sign, isDel ? heroStage.del : heroStage.add)} x="270" y={y}>{sign}</text>}
						<text {...sx(heroStage.code, sign && (isDel ? heroStage.del : heroStage.add))} x={sign ? '298' : '284'} y={y}>{code}</text>
						{isDel && <path {...sx(heroStage.strike)} d="M298 146h104" data-stage-part="strike" />}
					</g>
				))
			}
			<path {...sx(heroStage.gutterCheck)} pathLength="1" d="m241 171 3 3 5.5-6.5" data-stage-part="gutter-check"></path>
			<path {...sx(heroStage.gutterCheck)} pathLength="1" d="m241 195 3 3 5.5-6.5" data-stage-part="gutter-check"></path>
			<path {...sx(heroStage.leader)} pathLength="1" d="M510 179V244" data-stage-part="leader"></path>
			<g {...sx(heroStage.box)} data-stage-part="chip">
				<circle {...sx(heroStage.chipDot)} cx="510" cy="170" r="9"></circle>
				<text {...sx(heroStage.chipText)} x="510" y="174" text-anchor="middle">?</text>
			</g>
			<g data-stage-part="thread">
				<rect {...sx(heroStage.threadBox)} x="250" y="244" width="264" height="94"></rect>
				<path {...sx(heroStage.threadRail)} d="M250 244v94"></path>
				<g data-stage-part="you">
					<text {...sx(heroStage.who)} x="264" y="264">YOU · ASK</text>
					<text {...sx(heroStage.message)} x="264" y="281">What if the session already expired?</text>
				</g>
				<g opacity="0" data-stage-part="typing">
					<circle {...sx(heroStage.typingDot)} cx="266" cy="318" r="2"></circle>
					<circle {...sx(heroStage.typingDot)} cx="274" cy="318" r="2"></circle>
					<circle {...sx(heroStage.typingDot)} cx="282" cy="318" r="2"></circle>
				</g>
				<g data-stage-part="agent-says">
					<text {...sx(heroStage.who, heroStage.agentWho)} x="264" y="304">YOUR AGENT</text>
					<text {...sx(heroStage.message)} x="264" y="321">It returns 401 before the handler runs.</text>
				</g>
			</g>
			<circle {...sx(heroStage.port)} cx="236" cy="170" r="2.5"></circle>
			<circle {...sx(heroStage.port)} cx="528" cy="88" r="2.5"></circle>
		</g>

		<HeroLedger />

		<path {...sx(heroStage.cursor, heroStage.box)} d="M0 0v15.5l4.2-4 3.1 6.9 3-1.4-3-6.7h6Z" opacity="0" data-stage-part="cursor"></path>
	</g>
</svg>
