---
// Local by design: the desk runs next to your repository and calls no model.
import TextLink from '@shared/ui/TextLink.astro'
import { section } from '@shared/ui/section.styles'
import LocalFigure from './art/LocalFigure.astro'
import { REPO_URL } from '@entities/site/model/site-map'
import { revealItem, revealRuledGroup, scene } from '@shared/lib/reveal'
import { sx } from '@shared/lib/sx'
import { local } from './local.styles'
---

<section {...revealRuledGroup(section.ruled, section.pad, local.section)} id="local" aria-labelledby="local-title">
	<div>
		<h2 {...revealItem()} id="local-title">Your code stays<br />on your machine.</h2>
		<p {...revealItem(local.text)}>Review doesn’t need another cloud service. Syneva opens next to your repository, on loopback, and never calls a model. Your agent does the thinking; Syneva gives you a better place to judge it.</p>
		<ul {...revealItem(local.points)}>
			<li {...sx(local.point)}>Binds to 127.0.0.1 on a stable port per session</li>
			<li {...sx(local.point)}>Decisions saved under <code {...sx(local.code)}>~/.syneva</code>, restored after a restart</li>
			<li {...sx(local.point)}>Never edits your tracked files</li>
		</ul>
		<p {...revealItem(local.text, local.note)}>
			<TextLink href={`${REPO_URL}/blob/main/test/benchmarks/history.json`} label="Recorded performance evidence" isExternal /><br />Historical runs published September 17, 2026. Not a guarantee for your repository.
		</p>
	</div>
	<figure {...revealItem()} {...scene}>
		<LocalFigure />
	</figure>
</section>
