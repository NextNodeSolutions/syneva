---
// The principle strip under the hero: what Syneva will not trade away.
import { poses } from '@syneva/motion/poses'

import { twoDigits } from '@shared/lib/two-digits'
import { sx } from '@shared/lib/sx'
import { introPart } from './hero-intro-part'
import { principles } from './principles.styles'

const PRINCIPLES = ['Local by default', 'Your agent, not ours', 'No model inside Syneva', 'Open source · MIT']
const THIRD = 2
---

<div {...sx(poses.fade, principles.strip)} role="list" {...introPart('principles')}>
	{
		PRINCIPLES.map((principle, i) => (
			<span
				{...sx(principles.item, i > 0 && principles.notFirst, i === THIRD && principles.rowStart, i >= THIRD && principles.secondRow)}
				role="listitem"
			>
				<b {...sx(principles.index)} aria-hidden="true">{twoDigits(i + 1)}</b>
				{principle}
			</span>
		))
	}
</div>
