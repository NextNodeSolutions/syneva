---
// Chapter: the review desk. A reading order on the left, verdicts on the right.
import { HOTKEYS } from '@entities/desk/model/hotkeys'
import { sx } from '@shared/lib/sx'
import Check from '@shared/ui/drawing/Check.astro'
import Drawing from '@shared/ui/drawing/Drawing.astro'
import Pending from '@shared/ui/drawing/Pending.astro'
import { anim, loop } from '@shared/ui/drawing/anim'
import { shape } from '@shared/ui/drawing/shape.styles'
import { text } from '@shared/ui/drawing/text.styles'
import { homeArt } from '@shared/ui/drawing/home-art.styles'

const SIDE = [
	['CONTRACTS', 118],
	['BEHAVIOR', 186],
	['INTERFACE', 276],
	['OTHER', 344],
] as const
const ROWS = [
	['contracts/review.ts', 144, 'yes'],
	['auth/session.ts', 212, 'current'],
	['api/middleware.ts', 240, 'pending'],
	['pages/desk.tsx', 302, 'pending'],
	['README.md', 370, 'pending'],
] as const
---

<Drawing
	id="desk-art"
	width={520}
	height={520}
	compact="206 56 288 408"
	title="A reading order and a verdict on every change"
	description="On the left, your agent's walkthrough groups files into contracts, behavior, interface and a trailing Other section, so nothing is hidden. On the right, the open file's first change is kept, the second is undone, and the third waits for your verdict. Illustrative, not a screenshot."
>
	<g {...anim('rise', 0)}>
		<rect {...sx(shape.panel)} x="34" y="64" width="166" height="392"></rect>
		<text {...sx(text.label)} x="48" y="90">WALKTHROUGH</text>
		<path {...sx(shape.hair)} d="M34 102h166"></path>
		{SIDE.map(([label, y]) => <text {...sx(text.tiny, text.accent)} x="48" y={y}>{label}</text>)}
		{
			ROWS.map(([name, y, state]) => (
				<Fragment>
					<text {...sx(text.file, state === 'current' && text.strong)} x="48" y={y}>{name}</text>
					{state === 'yes' ? <Check x={180} y={y - 9} delay={0.5} /> : <Pending x={180} y={y - 9} />}
				</Fragment>
			))
		}
		<rect {...anim('sweep', 0.4, homeArt.deskCursor)} x="38" y="198" width="158" height="22"></rect>
		<path {...sx(shape.hair)} d="M34 414h166"></path>
		<rect {...sx(shape.track)} x="48" y="428" width="138" height="3"></rect><rect {...sx(shape.fill)} x="48" y="428" width="56" height="3"></rect>
		<text {...sx(text.tiny)} x="48" y="446">2 OF 5 SETTLED</text>
	</g>
	<g {...anim('rise', 0.2)}>
		<rect {...sx(shape.panel, shape.panelWhite)} x="214" y="64" width="272" height="392"></rect>
		<text {...sx(text.file, text.strong)} x="228" y="90">auth/session.ts</text><text {...sx(text.tiny)} x="472" y="90" text-anchor="end">3 CHANGES</text>
		<path {...sx(shape.hair)} d="M214 102h272"></path>
		<text {...sx(text.tiny)} x="228" y="124">@@ 12 · VERIFY THE SESSION</text>
		<rect {...anim('sweep', 0.9, shape.bandYes)} x="215" y="150" width="270" height="44"></rect>
		<text {...sx(text.code)} x="228" y="146">export function handle(req) {'{'}</text>
		<text {...sx(text.code, text.green)} x="228" y="168">+  await verifySession(req)</text>
		<text {...sx(text.code, text.green)} x="228" y="188">+  return run(req)</text>
		<g {...anim('pop', 1.3)}>
			<rect {...sx(shape.chipYes)} x="384" y="111" width="88" height="19"></rect>
			<text {...sx(text.tiny, text.green)} x="428" y="124.5" text-anchor="middle">✓ KEPT · {HOTKEYS.keep}</text>
		</g>
		<path {...sx(shape.hair)} d="M214 212h272"></path>
		<text {...sx(text.tiny)} x="228" y="234">@@ 41 · CACHE THE USER</text>
		<rect {...anim('sweep', 1.7, shape.bandNo)} x="215" y="244" width="270" height="22"></rect>
		<text {...sx(text.code, text.accent)} x="228" y="260">+  cache.set(token, user)</text>
		<path {...anim('draw', 2, shape.strike)} d="M246 256h158"></path>
		<text {...sx(text.code)} x="228" y="282">   return user</text>
		<g {...anim('pop', 2.1)}>
			<rect {...sx(shape.chipNo)} x="372" y="221" width="100" height="19"></rect>
			<text {...sx(text.tiny, text.accent)} x="422" y="234.5" text-anchor="middle">✕ UNDONE · {HOTKEYS.undo}</text>
		</g>
		<path {...sx(shape.hair)} d="M214 300h272"></path>
		<text {...sx(text.tiny)} x="228" y="322">@@ 60 · LOG THE SESSION</text>
		<rect {...loop('pulse', homeArt.deskNext)} x="220" y="330" width="260" height="26"></rect>
		<text {...sx(text.code, text.green)} x="228" y="348">+  log.debug(session.id)</text>
		<g {...anim('fade', 2.5)}>
			<rect {...sx(shape.kbd)} x="228" y="378" width="16" height="16"></rect>
			<text {...sx(text.tiny)} x="236" y="390" text-anchor="middle">{HOTKEYS.nextChange}</text>
			<text {...sx(text.small)} x="252" y="390">next change, waiting for you</text>
		</g>
		<path {...sx(shape.hair)} d="M214 414h272"></path>
		<text {...sx(text.tiny)} x="228" y="439">NOTHING IS AUTO-APPROVED</text>
	</g>
</Drawing>
