---
// Local section: everything runs inside your machine's boundary.
import { sx } from '@shared/lib/sx'
import Drawing from '@shared/ui/drawing/Drawing.astro'
import { anim, loop } from '@shared/ui/drawing/anim'
import { shape } from '@shared/ui/drawing/shape.styles'
import { text } from '@shared/ui/drawing/text.styles'
import { homeArt } from '@shared/ui/drawing/home-art.styles'

const TO_DESK = 'M176 112h68'
const DESK_TO_REPO = 'M310 150v36q0 10-10 10h-14q-10 0-10 10v16'
const AGENT_TO_REPO = 'M110 150v36q0 10 10 10h14q10 0 10 10v16'
---

<Drawing
	id="local-art"
	width={520}
	height={340}
	compact="12 14 500 318"
	isFrameless
	title="Everything stays inside your machine"
	description="Your agent, the review desk on localhost and your repository sit inside your machine, talking over loopback and git. The line to the internet is cut: no model call, no telemetry, no account."
>
	<path {...anim('draw', 0, homeArt.localBoundary)} pathLength="1" d="M20 40h380v280H20Z"></path>
	<text {...anim('fade', 0.3, text.label)} x="34" y="30">YOUR MACHINE</text>
	<g {...anim('rise', 0.3)}>
		<rect {...sx(shape.panel, shape.panelWhite)} x="44" y="74" width="132" height="76"></rect>
		<text {...sx(text.tiny)} x="56" y="94">YOUR AGENT</text>
		<text {...sx(text.code)} x="56" y="122">$ syneva await</text>
		<rect {...loop('blink', homeArt.localCaret)} x="162" y="112" width="6" height="12"></rect>
	</g>
	<g {...anim('rise', 0.45)}>
		<rect {...sx(shape.panel, shape.panelWhite)} x="244" y="74" width="140" height="76"></rect>
		<path {...sx(shape.hair)} d="M244 92h140"></path>
		<rect {...sx(shape.dot)} x="252" y="80" width="5" height="5"></rect>
		<text {...sx(text.tiny)} x="262" y="86">localhost:41873</text>
		<text {...sx(text.small)} x="256" y="116">Your desk</text>
		<rect {...sx(shape.yes)} x="256" y="126" width="11" height="11"></rect>
		<path {...sx(shape.check)} d="m258.8 131.4 2 2 3.6-4"></path>
		<text {...sx(text.tiny)} x="272" y="136">3 KEPT · 1 UNDONE</text>
	</g>
	<g {...anim('rise', 0.6)}>
		<rect {...sx(shape.panel)} x="144" y="222" width="132" height="70"></rect>
		<text {...sx(text.tiny)} x="156" y="242">YOUR REPOSITORY</text>
		<text {...sx(text.code)} x="156" y="270">git diff</text>
	</g>
	<g fill="none">
		<path {...anim('draw', 0.8, shape.route)} pathLength="1" d={TO_DESK}></path>
		<path {...anim('draw', 0.9, shape.route)} pathLength="1" d={DESK_TO_REPO}></path>
		<path {...anim('draw', 1, shape.route)} pathLength="1" d={AGENT_TO_REPO}></path>
		<path {...anim('signal', 1.6, homeArt.localSignal)} pathLength="100" d={TO_DESK}></path>
		<path {...anim('signal', 2.4, homeArt.localSignal, homeArt.localSignalGreen)} pathLength="100" d={DESK_TO_REPO}></path>
	</g>
	<text {...anim('fade', 1.1, text.tiny)} x="210" y="104" text-anchor="middle">LOOPBACK</text>
	<path {...anim('draw', 1.3, homeArt.localOut)} pathLength="1" d="M400 180h48"></path>
	<g {...anim('pop', 1.8)}>
		<rect {...sx(homeArt.localCut)} x="416" y="172" width="16" height="16"></rect>
		<path {...sx(homeArt.localCutX)} d="m420 176 8 8m0-8-8 8"></path>
	</g>
	<g {...anim('fade', 1.5)}>
		<rect {...sx(homeArt.localCloud)} x="448" y="152" width="56" height="56"></rect>
		<text {...sx(text.tiny)} x="476" y="184" text-anchor="middle">CLOUD</text>
	</g>
	<text {...anim('fade', 2, text.tiny)} x="476" y="232" text-anchor="middle">NO MODEL</text>
	<text {...anim('fade', 2.1, text.tiny)} x="476" y="248" text-anchor="middle">NO TELEMETRY</text>
	<text {...anim('fade', 2.2, text.tiny)} x="476" y="264" text-anchor="middle">NO ACCOUNT</text>
</Drawing>
