---
// Chapter: the plan desk prototype - a plan becomes a map of decisions.
import { sx } from '@shared/lib/sx'
import ArtFrame from '@shared/ui/drawing/ArtFrame.astro'
import Drawing from '@shared/ui/drawing/Drawing.astro'
import { anim } from '@shared/ui/drawing/anim'
import { shape } from '@shared/ui/drawing/shape.styles'
import { text } from '@shared/ui/drawing/text.styles'
import { homeArt as h } from '@shared/ui/drawing/home-art.styles'

const BUS = [
	[0.8, 'M220 162h30'],
	[1, 'M250 150v240'],
	[1.3, 'M250 150h36'],
	[1.5, 'M250 270h36'],
	[1.7, 'M250 390h36'],
] as const
const DOTS = [
	[0.9, 159],
	[1.3, 147],
	[1.5, 267],
	[1.7, 387],
] as const
---

<Drawing viewBox="0 0 520 520" compact="44 60 456 440" labelledby="plan-art-title plan-art-desc">
	<title id="plan-art-title">A plan becomes a map of decisions</title>
	<desc id="plan-art-desc">A plan document routes into three claims: an assumption that needs proof, a question for the agent, and a decision that is understood. Illustrative prototype concept.</desc>
	<ArtFrame id="plan" width={520} height={520} />
	<g {...anim('rise', 0)}>
		<path d="M64 100h-8v-8h8M212 92h8v8" {...sx(shape.inkLine)}></path>
		<rect {...sx(shape.panel, shape.panelWhite)} x="64" y="100" width="156" height="212"></rect>
		<rect {...anim('sweep', 0.6, h.planHighlight)} x="80" y="150" width="124" height="24"></rect>
		<path {...sx(shape.lines)} d="M84 128h96m-96 34h92m-92 32h104m-104 30h80m-80 28h58m-58 26h88"></path>
		<text {...sx(text.label)} x="64" y="82">plan.md</text>
	</g>
	<g fill="none">
		{BUS.map(([delay, d]) => <path {...anim('draw', delay, h.planBus)} pathLength="1" d={d} />)}
		<path {...anim('signal', 2.6, h.planBus, h.planSignal)} pathLength="100" d="M220 162h30v228h36"></path>
	</g>
	<g>
		{DOTS.map(([delay, y]) => <rect {...anim('pop', delay, h.planDot)} x="247" y={y} width="6" height="6" />)}
	</g>
	<g {...anim('rise', 1.4)}>
		<rect {...sx(h.planClaim, h.planRisk)} x="286" y="122" width="200" height="56"></rect>
		<text {...sx(text.copy)} x="304" y="146">An assumption</text>
		<text {...sx(text.small)} x="304" y="165">Needs proof before code</text>
		<rect {...anim('pulse', undefined, h.planFlag)} x="462" y="144" width="10" height="10"></rect>
	</g>
	<g {...anim('rise', 1.6)}>
		<rect {...sx(h.planClaim)} x="286" y="242" width="200" height="56"></rect>
		<text {...sx(text.copy)} x="304" y="266">A question</text>
		<text {...sx(text.small)} x="304" y="285">Ask the agent on the line</text>
		<text {...sx(text.copy, text.accent)} x="467" y="275" text-anchor="middle">?</text>
	</g>
	<g {...anim('rise', 1.8)}>
		<rect {...sx(h.planClaim, h.planSettled)} x="286" y="362" width="200" height="56"></rect>
		<text {...sx(text.copy)} x="304" y="386">A decision</text>
		<text {...sx(text.small)} x="304" y="405">Understood and settled</text>
		<path {...anim('draw', 2.3, shape.check)} pathLength="1" d="m461 390 4 4 8-9"></path>
	</g>
	<text {...anim('fade', 2, text.label)} x="28" y="487">LESS READING BLIND. MORE DECIDING.</text>
</Drawing>
