---
// The review circuit, formerly the hero drawing: the full diff travels
// horizontally while its review layers separate vertically. It opens the How
// it works section, where its loop (diff, focus, verdict, next revision) is
// the story being told. Its wires and loop label are routed at build time
// (circuit-layout.ts); circuit.client.ts re-routes them from the ports' live
// positions and runs its loop.
import { sx } from '@shared/lib/sx'
import CircuitLayer from './CircuitLayer.astro'
import CircuitStation from './CircuitStation.astro'
import { LOOP_LABEL, PLATFORM_X, portsOn, ROW, WIRES } from './circuit-layout'
import { circuit } from './circuit.styles'
---

<svg {...sx(circuit.root)} viewBox="0 0 1160 480" role="img" aria-labelledby="circuit-title circuit-desc" data-circuit>
	<title id="circuit-title">The review, in two dimensions</title>
	<desc id="circuit-desc">The full diff passes from your agent into a local review. Its layers open vertically: critical, important, and tested. You make your decisions during review, then ship code you've examined with confidence. A dotted return connection carries the next revision back to the agent. An illustrative human review, not automatic approval or a product screenshot.</desc>
	<defs>
		<clipPath id="review-face-clip"><use href="#review-face"></use></clipPath>
		{WIRES.map(({ id, from, to, route, d }) => <path id={id} data-from={from} data-to={to} data-route={route} d={d} />)}
		<g id="review-leaf">
			<path {...sx(circuit.leafEdge)} d="M-112 0 0 56 112 0v5L0 61-112 5Z"></path>
			<path {...sx(circuit.leafFace)} id="review-face" d="M0-56 112 0 0 56-112 0Z"></path>
			<path {...sx(circuit.leafFold)} d="M0 56v5"></path>
			<g {...sx(circuit.leafCode)} transform="matrix(.8 .4 -.8 .4 0 -39)">
				<path {...sx(circuit.codeAccent)} d="M0 0h47"></path>
				<path d="M0 17h18m10 0h44M0 34h32m10 0h40M0 51h14m10 0h39M0 68h42"></path>
				<path {...sx(circuit.codeFaint)} d="M81 0h14M90 34h8M72 51h20M51 68h15"></path>
			</g>
		</g>
		<g id="review-mark" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round"><path d="M0-11v6M0 5v6M-11 0h6M5 0h6M-8-8l4 4M4 4l4 4M-8 8l4-4M4-4l4-4"></path><path d="m0-3 3 3-3 3-3-3Z"></path></g>
		<g id="verdict-check" fill="none" stroke="var(--green)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m-7 0 5 5 10-11"></path></g>
	</defs>
	<g {...sx(circuit.register)} fill="none" stroke="var(--line)"><path d="M28 44V28h16m1072 0h16v16M28 436v16h16m1072 0h16v-16"></path></g>
	<g>
		{/* Visible conductors and travelling signals share the same paths. */}
		<g {...sx(circuit.routes)} fill="none">
			<use href="#flow-in"></use><use href="#flow-out"></use>
			<use {...sx(circuit.returnRoute)} href="#flow-return"></use>
			<use {...sx(circuit.signal)} href="#flow-in" data-signal="in"></use>
			<use {...sx(circuit.signal, circuit.signalOut)} href="#flow-out" data-signal="out"></use>
			<use {...sx(circuit.signal, circuit.signalReturn)} href="#flow-return" data-signal="return"></use>
		</g>
		<CircuitStation kind="source" />
		<g transform={`translate(${PLATFORM_X.review} ${ROW})`}>
			<path {...sx(circuit.foot)} d="M0-76 152 0 0 76-152 0Z"></path><path {...sx(circuit.rim)} d="M-152 0v8L0 84 152 8V0"></path>
			<path {...sx(circuit.seat)} d="M0-61 122 0 0 61-122 0Z"></path>
			<g {...sx(circuit.mark)} transform="translate(0 68) scale(1 .5)"><use href="#review-mark"></use></g>
			{portsOn('review').map(([id, { x, y }]) => <circle {...sx(circuit.port)} id={id} cx={x} cy={y} r="2.5" />)}
		</g>
		<g transform="translate(580 276)">
			<CircuitLayer kind="tested" />
			<CircuitLayer kind="important" />
			<CircuitLayer kind="critical" />
		</g>
		<CircuitStation kind="verdict" />
		<text {...sx(circuit.loopLabel)} x={LOOP_LABEL.x} y={LOOP_LABEL.y} text-anchor="middle" data-loop-label>SAME TAB. NEXT REVISION.</text>
	</g>
</svg>

<script>
	import './circuit.client'
</script>
