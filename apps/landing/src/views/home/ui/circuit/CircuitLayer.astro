---
// One review layer on the circuit: tested at the bottom, important, then the
// critical sheet that lifts highest and takes your focus. Its sheet and note
// are drawn here; Circuit.astro passes what a layer adds, drawn over the
// sheet (the slot) or under it (the under slot).
import { sx } from '@shared/lib/sx'
import { circuitPart, layerPart } from './circuit-part'
import { circuit } from './circuit.styles'

import type { LayerKind } from './circuit-part'

type Props = { kind: LayerKind }

const { kind } = Astro.props
const NOTE = {
	tested: ['Tested', 'Check evidence'],
	important: ['Important', 'Follow the change'],
	critical: ['Critical', 'Read closely'],
} as const
const [title, detail] = NOTE[kind]
const isCritical = kind === 'critical'
---

<g {...sx(circuit.layer, circuit[kind])} {...layerPart(kind)}>
	<slot name="under" />
	<use href="#review-leaf"></use>
	<slot />
	<g {...sx(circuit.note)} {...circuitPart('note')}>
		<path {...sx(circuit.notePath)} d="M112 0h38"></path><circle {...sx(circuit.noteDot)} cx="112" r="2"></circle>
		<text {...sx(circuit.noteTitle, isCritical && circuit.criticalTitle)} x="162" y="-3">{title}</text><text {...sx(circuit.noteDetail)} x="162" y="15">{detail}</text>
	</g>
</g>
