---
import { sx } from '@shared/lib/sx'
import { PLATFORM_X, portsOn, ROW } from './circuit-layout'
import { circuit } from './circuit.styles'

type Props = { kind: 'source' | 'verdict' }

const { kind } = Astro.props
const STATION = {
	source: { css: circuit.sourceStation, title: 'Your full diff', detail: 'Every change from your agent' },
	verdict: { css: circuit.verdictStation, title: 'Ship with confidence', detail: 'Code you’ve reviewed' },
}
const RIM = 'M-124 0v7L0 69 124 7V0'
const station = STATION[kind]
---

<g {...sx(station.css)} transform={`translate(${PLATFORM_X[kind]} ${ROW})`}>
	<path {...sx(circuit.foot)} d="M0-62 124 0 0 62-124 0Z"></path><path {...sx(circuit.rim)} d={RIM}></path>
	<slot />
	{portsOn(kind).map(([id, { x, y }]) => <circle {...sx(circuit.port)} id={id} cx={x} cy={y} r="2.5" />)}
	<text {...sx(circuit.stationTitle)} y="-128" text-anchor="middle">{station.title}</text><text {...sx(circuit.stationDetail)} y="-109" text-anchor="middle">{station.detail}</text>
</g>
