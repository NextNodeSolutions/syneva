---
import { a11y } from '@syneva/design-system/a11y.styles'
import { SITE_NAME } from '@entities/site/model/site-map'
import { prose } from '@shared/ui/prose/prose.styles'
import { section } from '@shared/ui/section.styles'
import { revealItem, revealRuledGroup } from '@shared/lib/reveal'
import { sx } from '@shared/lib/sx'
import { compare } from './compare.styles'

const COLUMNS = [
	{ key: 'editor', label: 'Your editor’s diff' },
	{ key: 'hosted', label: 'Hosted AI review' },
	{ key: 'ours', label: SITE_NAME },
] as const
type Row = { aspect: string } & Record<(typeof COLUMNS)[number]['key'], string>
const ROWS: readonly Row[] = [
	{ aspect: 'Who judges the change', editor: 'You, file by file', hosted: 'A model, on its servers', ours: 'You, with your agent on call' },
	{ aspect: 'Order you read in', editor: 'The file tree', hosted: 'The PR’s file list', ours: 'A walkthrough your agent sets' },
	{ aspect: 'Questions', editor: 'Switch to a chat window', hosted: 'Comments on a PR', ours: 'On the exact line, answered there' },
	{ aspect: 'What a verdict is', editor: 'Git staging', hosted: 'A bot’s approval', ours: 'Your decision, recorded per change' },
	{ aspect: 'After the agent revises', editor: 'Start over', hosted: 'A new review pass', ours: 'Same tab. Only rewritten changes reset' },
	{ aspect: 'Where your code goes', editor: 'Stays local', hosted: 'Uploaded for analysis', ours: 'Stays on localhost' },
]
---

<section {...revealRuledGroup(section.ruled, section.pad)} id="compare" aria-labelledby="compare-title">
	<div {...sx(section.head, compare.head)}>
		<h2 {...revealItem(prose.title)} id="compare-title">Built for the loop<br />your editor wasn’t.</h2>
		<p {...revealItem(section.headText)}>Editors were designed for writing code. AI reviewers put a model between you and the diff. Syneva is a review surface for the human, with the agent that wrote the code one keystroke away.</p>
	</div>
	<div {...revealItem(compare.scroll)}>
		<table {...sx(compare.table)}>
			<thead {...sx(compare.thead)}>
				<tr {...sx(compare.row)}>
					<th {...sx(compare.cell, compare.column, compare.stacked)} scope="col"><span {...sx(a11y.srOnly)}>Aspect</span></th>
					{COLUMNS.map(({ key, label }) => <th {...sx(compare.cell, compare.column, key === 'ours' && compare.columnUs, compare.stacked)} scope="col">{label}</th>)}
				</tr>
			</thead>
			<tbody {...sx(compare.stacked)}>
				{
					ROWS.map(row => (
						<tr {...sx(compare.row)}>
							<th {...sx(compare.cell, compare.aspect)} scope="row">{row.aspect}</th>
							{COLUMNS.map(({ key, label }) => <td {...sx(compare.cell, compare.value, key === 'ours' && compare.valueUs)} data-label={label}>{row[key]}</td>)}
						</tr>
					))
				}
			</tbody>
		</table>
	</div>
</section>
