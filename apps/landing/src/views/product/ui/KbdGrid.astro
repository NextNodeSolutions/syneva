---
import { revealItem } from '@shared/lib/reveal'
import { sx } from '@shared/lib/sx'
import { kbdGrid } from './kbd-grid.styles'

type Props = { keys: readonly (readonly [string, string])[] }

const { keys } = Astro.props
---

<div {...revealItem(kbdGrid.root)}>
	{
		keys.map(([key, label]) => (
			<div {...sx(kbdGrid.row)}>
				<kbd {...sx(kbdGrid.key)}>{key}</kbd>
				<span {...sx(kbdGrid.label)}>{label}</span>
			</div>
		))
	}
</div>
