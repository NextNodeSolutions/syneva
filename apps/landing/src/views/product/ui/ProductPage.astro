---
import DeskLayers from './art/DeskLayers.astro'
import Button from '@shared/ui/Button.astro'
import CtaBand from '@widgets/cta-band/ui/CtaBand.astro'
import IndexRows from '@widgets/page-index/ui/IndexRows.astro'
import PageHero from '@widgets/page-hero/ui/PageHero.astro'
import Prose from '@shared/ui/prose/Prose.astro'
import ProseText from '@shared/ui/prose/ProseText.astro'
import RuledList from '@shared/ui/prose/RuledList.astro'
import TextLink from '@shared/ui/TextLink.astro'
import { sectionById } from '@entities/site/model/site-map'


const COMMITMENTS = [
	['No model runs inside Syneva.', 'It never calls an LLM and never orchestrates one. It renders the diff, validates what it is given, and hands a result back.'],
	['Your agent, not ours.', 'The contract is plain JSON on stdout plus a localhost HTTP server. Whatever agent you use today can drive it, and so can tomorrow’s.'],
	['The review is yours.', 'Verdicts are recorded per change. Nothing is auto-approved, no file is hidden, and a change your agent rewrites goes back to pending.'],
] as const
const DAILY = [
	['One tab across rounds.', 'Each repo and session binds a stable port, so a restarted desk reattaches and the open tab heals itself.'],
	['Decisions survive everything.', 'Every save is persisted under ~/.syneva. Reloads, restarts and crashes keep your verdicts.'],
	['Keyboard first.', 'Move, keep, undo, comment, approve and send without touching the mouse. Press ? for the full map.'],
	['Your editor, one key away.', 'Configure a repo-scoped editor command and jump to the current file and line with ⇧E.'],
] as const
---

<PageHero
	crumb="Product"
	title="The review desk for code your agent wrote."
	lede={'Syneva is an integrated review environment: a browser desk on localhost where you read your agent’s diff in order, question it on the line and record a verdict on every change. It runs no model of its own. The judgment is yours, the agent is yours, and the code stays on your machine.'}
	caption="Four layers, one desk. The verdicts on top are yours alone."
>
	<Fragment slot="actions"><Button href="/get-started/" label="Start a local review" /><TextLink href="/workflows/" label="See the four workflows" /></Fragment>
	<DeskLayers slot="art" />
</PageHero>
<Prose id="desk" title={'What’s on the desk.'}>
	<ProseText>Each part of the desk answers one question you have when an agent hands you a diff: what changed, in what order should I read it, why is this here, and what do I keep.</ProseText>
	<IndexRows items={sectionById('product').items} />
</Prose>
<Prose id="commitments" title={'Three commitments<br>we won’t trade away.'}>
	<RuledList items={COMMITMENTS} />
</Prose>
<Prose id="daily" title="Built for the daily loop.">
	<ProseText>Syneva is built by someone who reviews agent-written code every day. Anything that costs a round-trip or a re-orientation is treated as a defect.</ProseText>
	<RuledList items={DAILY} />
</Prose>
<CtaBand />
