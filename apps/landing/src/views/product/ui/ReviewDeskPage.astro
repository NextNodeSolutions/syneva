---
import DeskAnatomy from './art/DeskAnatomy.astro'
import VerdictLifecycle from './art/VerdictLifecycle.astro'
import Button from '@shared/ui/Button.astro'
import Chapter from '@widgets/chapter/ui/Chapter.astro'
import ChapterText from '@widgets/chapter/ui/ChapterText.astro'
import Command from '@features/copy-command/ui/Command.astro'
import CtaBand from '@widgets/cta-band/ui/CtaBand.astro'
import PageHero from '@widgets/page-hero/ui/PageHero.astro'
import Pager from '@widgets/page-index/ui/Pager.astro'
import Prose from '@shared/ui/prose/Prose.astro'
import ProseText from '@shared/ui/prose/ProseText.astro'
import RuledList from '@shared/ui/prose/RuledList.astro'
import { PAGES } from '@entities/site/model/site-map'
import KbdGrid from './KbdGrid.astro'

// The real desk bindings (packages/frontend/src/app/hotkeys-*.ts).
const KEYS = [
	['j', 'Next change'],
	['k', 'Previous change'],
	['⇧Y', 'Keep the change'],
	['⇧N', 'Undo the change'],
	['⇧A', 'Approve the whole file'],
	['c', 'Comment on the line'],
	['⇧C', 'Comment on the file'],
	['⇧→', 'Next file, in reading order'],
	['w', 'Tree or walkthrough'],
	['n', 'Review notes'],
	['⇧H', 'Hide approved changes'],
	['⇧E', 'Open in your editor'],
	['⇧S', 'Send to agent'],
	['?', 'The full keyboard map'],
] as const
const VERDICTS = [
	['Nothing is auto-approved.', 'Every change starts pending. Only your keypress settles it.'],
	['Approve a whole file.', '⇧A signs off a file. Turn on “Approve stages file” and a clean approval stages it in git too.'],
	['Stale trust can’t hide.', 'Approvals and comment anchors follow the same hashing rule as verdicts.'],
] as const
const ROUNDS = [
	['Hide what you already approved.', '⇧H distills a multi-round review down to what still needs your eyes.'],
	['Every note in one panel.', 'n opens the review notes: every comment and question across files, filterable, one key from its line.'],
	['Reset with a scalpel.', 'Clear decisions and sign-offs but keep your notes, or reset only the approved files.'],
	['Make it yours.', 'Split or stacked diffs, intra-line highlights, wrapping, fourteen code themes, your fonts, light or dark.'],
] as const
---

<PageHero
	crumb="Review desk"
	title="A verdict on every change."
	lede={'Your agent’s diff opens in a local browser tab, rendered in full and ready to judge. Keep what’s right, undo what isn’t, sign off whole files, and send the result back without leaving the keyboard.'}
	caption="Illustrative wireframe. Your diff, your agent, your verdicts."
>
	<Fragment slot="actions"><Button href={PAGES.getStarted.href} label="Open your first desk" /><Command text="syneva" label="Start a review" /></Fragment>
	<DeskAnatomy slot="art" />
</PageHero>
<Chapter id="verdicts" title="Verdicts, not vibes." list={VERDICTS} caption="Pending → kept or undone → pending again only if rewritten">
	<ChapterText>A verdict in Syneva is a record: this change, kept or undone, by you. It is not inferred from git staging and never granted in bulk by a model.</ChapterText>
	<ChapterText>Each change is content-hashed. When your agent rewrites something you already kept, it comes back pending on the next reload. What it left alone keeps your verdict, round after round.</ChapterText>
	<VerdictLifecycle slot="art" />
</Chapter>
<Prose id="keyboard" title="The keyboard<br>is the fast path.">
	<ProseText>Every major action has a key, and the help overlay is generated from the same table that runs them, so the hints never drift from the behavior.</ProseText>
	<KbdGrid keys={KEYS} />
</Prose>
<Prose id="rounds" title="Made for the second round,<br>and the tenth.">
	<RuledList items={ROUNDS} />
</Prose>
<CtaBand />
<Pager />
