---
// A numbered callout on the desk wireframe.
import { sx } from '@shared/lib/sx'
import { anim } from '@shared/ui/drawing/anim'
import { productArt } from '@shared/ui/drawing/product-art.styles'

type Props = { n: number; x: number; y: number; delay: number }

const { n, x, y, delay } = Astro.props
const SIZE = 16
const BASELINE = 11.5
---

<g {...anim('pop', delay)}><rect {...sx(productArt.anatomyNumber)} x={x} y={y} width={SIZE} height={SIZE}></rect><text {...sx(productArt.anatomyNumberText)} x={x + SIZE / 2} y={y + BASELINE} text-anchor="middle">{n}</text></g>
