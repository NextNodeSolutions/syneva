---
// Ask your agent: one line, two intents.
import { HOTKEYS } from '@entities/desk/model/hotkeys'
import { sx } from '@shared/lib/sx'
import { homeArt } from '@shared/ui/drawing/home-art.styles'
import AskThread from '@shared/ui/drawing/AskThread.astro'
import CodeLine from '@shared/ui/drawing/CodeLine.astro'
import Drawing from '@shared/ui/drawing/Drawing.astro'
import Wire from '@shared/ui/drawing/Wire.astro'
import { anim } from '@shared/ui/drawing/anim'
import { shape } from '@shared/ui/drawing/shape.styles'
import { text } from '@shared/ui/drawing/text.styles'

const TO_ASK = 'M300 220C340 220 340 96 380 96'
const TO_CHANGE = 'M300 220C340 220 340 300 380 300'
---

<Drawing
	id="fork"
	width={600}
	height={440}
	compact="20 24 566 400"
	title="One line, two intents"
	description="From a changed line, an Ask goes to your agent and its answer comes back into the thread right away. A Request change stays on the line and rides along with your verdict when you Send, as a requestedChanges entry."
>
	<g {...anim('rise', 0)}>
		<rect {...sx(shape.panel, shape.panelWhite)} x="30" y="150" width="270" height="110"></rect>
		<text {...sx(text.file, text.strong)} x="44" y="172">api/middleware.ts</text><path {...sx(shape.hair)} d="M30 182h270"></path>
		<CodeLine x={66} y={202} gap={10} lineNumber={18}>token = readCookie(req)</CodeLine>
		<rect {...sx(shape.bandAdd)} x="31" y="210" width="268" height="20"></rect>
		<CodeLine x={66} y={224} gap={10} lineNumber={19} tone="green">+ await verifySession(req)</CodeLine>
		<CodeLine x={66} y={248} gap={10} lineNumber={20}>return next()</CodeLine>
	</g>
	<circle {...sx(shape.port)} cx="300" cy="220" r="3"></circle>
	<g fill="none">
		<Wire d={TO_ASK} drawDelay={0.5} signalDelay={1.4} routeCss={shape.routeAccent} />
		<Wire d={TO_CHANGE} drawDelay={0.7} signalDelay={2.2} />
		<path {...anim('draw', 1.6, shape.route, shape.routeDotted)} d="M475 330V362"></path>
	</g>
	<text {...anim('fade', 0.8, text.tiny, text.accent)} x="380" y="34">ASK · {HOTKEYS.ask} · ANSWERED NOW</text>
	<g {...anim('rise', 0.9)}>
		<AskThread x={380} y={44} width={190} height={112}>
			<text {...sx(text.tiny)} x="394" y="64">YOU</text><text {...sx(text.copy)} x="394" y="82">Why verify here?</text>
			<text {...sx(text.tiny, text.accent)} x="394" y="108">YOUR AGENT</text><text {...sx(text.small)} x="394" y="126">So an expired session</text><text {...sx(text.small)} x="394" y="142">returns 401 first.</text>
		</AskThread>
	</g>
	<text {...anim('fade', 1, text.tiny)} x="380" y="262">REQUEST CHANGE · {HOTKEYS.requestChange}</text>
	<g {...anim('rise', 1.1)}>
		<rect {...sx(homeArt.askChange)} x="380" y="272" width="190" height="58"></rect><path {...sx(homeArt.askChangeRail)} d="M380 272v58"></path>
		<text {...sx(text.small)} x="394" y="296">Log why the session</text><text {...sx(text.small)} x="394" y="313">was rejected.</text>
	</g>
	<text {...anim('fade', 1.7, text.tiny)} x="486" y="350">RIDES WITH SEND</text><g {...anim('rise', 1.8)}><rect {...sx(shape.kbd)} x="380" y="362" width="190" height="40"></rect><text {...sx(text.code)} x="394" y="380">"requestedChanges": [</text><text {...sx(text.code)} x="394" y="395">  &#123; "lineNumber": 20 … &#125; ]</text></g>
	<g {...anim('fade', 0.3, shape.secondary)}><text {...sx(text.tiny)} x="30" y="300">ON A LINE · {HOTKEYS.commentOnLine}</text><text {...sx(text.tiny)} x="30" y="318">ON A WHOLE FILE · {HOTKEYS.commentOnFile}</text><text {...sx(text.tiny)} x="30" y="336">RESOLVE A THREAD · {HOTKEYS.resolveThread}</text></g>
</Drawing>
