---
// Ask your agent: one line, two intents.
import { sx } from '@shared/lib/sx'
import { homeArt } from '@shared/ui/drawing/home-art.styles'
import ArtFrame from '@shared/ui/drawing/ArtFrame.astro'
import Drawing from '@shared/ui/drawing/Drawing.astro'
import { anim } from '@shared/ui/drawing/anim'
import { shape } from '@shared/ui/drawing/shape.styles'
import { text } from '@shared/ui/drawing/text.styles'

const TO_ASK = 'M300 220C340 220 340 96 380 96'
const TO_CHANGE = 'M300 220C340 220 340 300 380 300'
---

<Drawing viewBox="0 0 600 440" compact="20 24 566 400" labelledby="fork-title fork-desc">
	<title id="fork-title">One line, two intents</title>
	<desc id="fork-desc">From a changed line, an Ask goes to your agent and its answer comes back into the thread right away. A Request change stays on the line and rides along with your verdict when you Send, as a requestedChanges entry.</desc>
	<ArtFrame id="fork" width={600} height={440} />
	<g {...anim('rise', 0)}>
		<rect {...sx(shape.panel, shape.panelWhite)} x="30" y="150" width="270" height="110"></rect>
		<text {...sx(text.file, text.strong)} x="44" y="172">api/middleware.ts</text><path {...sx(shape.hair)} d="M30 182h270"></path>
		<text {...sx(text.ln)} x="56" y="202" text-anchor="end">18</text><text {...sx(text.code)} x="66" y="202">token = readCookie(req)</text>
		<rect {...sx(shape.bandAdd)} x="31" y="210" width="268" height="20"></rect>
		<text {...sx(text.ln)} x="56" y="224" text-anchor="end">19</text><text {...sx(text.code, text.green)} x="66" y="224">+ await verifySession(req)</text>
		<text {...sx(text.ln)} x="56" y="248" text-anchor="end">20</text><text {...sx(text.code)} x="66" y="248">return next()</text>
	</g>
	<circle {...sx(shape.port)} cx="300" cy="220" r="3"></circle>
	<g fill="none">
		<path {...anim('draw', 0.5, shape.route, shape.routeAccent)} pathLength="1" d={TO_ASK}></path>
		<path {...anim('draw', 0.7, shape.route)} pathLength="1" d={TO_CHANGE}></path>
		<path {...anim('draw', 1.6, shape.route, shape.routeDotted)} pathLength="1" d="M475 330V362"></path>
		<path {...anim('signal', 1.4, shape.signal)} pathLength="100" d={TO_ASK}></path>
		<path {...anim('signal', 2.2, shape.signal)} pathLength="100" d={TO_CHANGE}></path>
	</g>
	<text {...anim('fade', 0.8, text.tiny, text.accent)} x="380" y="34">ASK · ⌘⇧↵ · ANSWERED NOW</text>
	<g {...anim('rise', 0.9)}>
		<rect {...sx(homeArt.askThread)} x="380" y="44" width="190" height="112"></rect><path {...sx(homeArt.askRail)} d="M380 44v112"></path>
		<text {...sx(text.tiny)} x="394" y="64">YOU</text><text {...sx(text.copy)} x="394" y="82">Why verify here?</text>
		<text {...sx(text.tiny, text.accent)} x="394" y="108">YOUR AGENT</text><text {...sx(text.small)} x="394" y="126">So an expired session</text><text {...sx(text.small)} x="394" y="142">returns 401 first.</text>
	</g>
	<text {...anim('fade', 1, text.tiny)} x="380" y="262">REQUEST CHANGE · ⌘↵</text>
	<g {...anim('rise', 1.1)}>
		<rect {...sx(homeArt.askChange)} x="380" y="272" width="190" height="58"></rect><path {...sx(homeArt.askChangeRail)} d="M380 272v58"></path>
		<text {...sx(text.small)} x="394" y="296">Log why the session</text><text {...sx(text.small)} x="394" y="313">was rejected.</text>
	</g>
	<text {...anim('fade', 1.7, text.tiny)} x="486" y="350">RIDES WITH SEND</text><g {...anim('rise', 1.8)}><rect {...sx(shape.kbd)} x="380" y="362" width="190" height="40"></rect><text {...sx(text.code)} x="394" y="380">"requestedChanges": [</text><text {...sx(text.code)} x="394" y="395">  &#123; "lineNumber": 20 … &#125; ]</text></g>
	<g {...anim('fade', 0.3, shape.secondary)}><text {...sx(text.tiny)} x="30" y="300">ON A LINE · c</text><text {...sx(text.tiny)} x="30" y="318">ON A WHOLE FILE · ⇧C</text><text {...sx(text.tiny)} x="30" y="336">RESOLVE A THREAD · r</text></g>
</Drawing>
