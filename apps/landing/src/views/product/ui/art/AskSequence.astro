---
import { sx } from '@shared/lib/sx'
import Drawing from '@shared/ui/drawing/Drawing.astro'
import { anim } from '@shared/ui/drawing/anim'
import { text } from '@shared/ui/drawing/text.styles'
import { productArt } from '@shared/ui/drawing/product-art.styles'

const LANES = {
	you: { name: 'YOU', x: 90 },
	desk: { name: 'YOUR DESK', x: 300 },
	agent: { name: 'YOUR AGENT', x: 510 },
} as const
const LANE_HALF = 56
const STEPS = [
	{ from: 'you', to: 'desk', y: 84, label: 'Ask on line 19', tone: 'accent' },
	{ from: 'desk', to: 'agent', y: 124, label: 'question event', tone: 'accent' },
	{ from: 'agent', to: 'desk', y: 164, label: 'syneva status “reading…”', tone: 'muted' },
	{ from: 'agent', to: 'desk', y: 204, label: 'syneva comment (the answer)', tone: 'accent' },
	{ from: 'desk', to: 'you', y: 244, label: 'Answer in your thread', tone: 'green' },
] as const
const LINE = { accent: productArt.lineAccent, green: productArt.lineGreen, muted: productArt.lineMuted } as const
const HEAD = { accent: productArt.headAccent, green: productArt.headGreen, muted: productArt.headMuted } as const
const ARROW = 4
const arrows = STEPS.map(({ from, to, y, label, tone }, index) => {
	const start = LANES[from].x
	const end = LANES[to].x
	const backward = end > start ? -1 : 1
	const delay = 0.5 + index * 0.4
	return {
		line: `M${start} ${y}H${end + backward * ARROW}`,
		head: `M${end} ${y}l${backward * 7}-4v8Z`,
		labelX: (start + end) / 2,
		labelY: y - 8,
		label,
		tone,
		delay,
		headDelay: delay + 0.3,
		labelDelay: delay + 0.2,
	}
})
---

<Drawing
	id="sequence-art"
	width={600}
	height={320}
	compact="30 10 540 300"
	title="A question, in order"
	description="You ask on a line. The desk hands the question to your agent as an event. Your agent posts a live status while it reads, then posts its answer with syneva comment, and the answer appears in your thread on that line."
>
	{
		Object.values(LANES).map(({ name, x }) => (
			<Fragment>
				<rect {...sx(productArt.lane)} x={x - LANE_HALF} y="30" width="112" height="24" />
				<text {...sx(text.tiny)} x={x} y="46" text-anchor="middle">{name}</text>
				<path {...sx(productArt.laneRule)} d={`M${x} 54V292`} />
			</Fragment>
		))
	}
	{
		arrows.map(({ line, head, labelX, labelY, label, tone, delay, headDelay, labelDelay }) => (
			<Fragment>
				<path {...anim('draw', delay, productArt.sequenceLine, LINE[tone])} d={line} />
				<path {...anim('pop', headDelay, HEAD[tone])} d={head} />
				<text {...anim('fade', labelDelay, text.small)} x={labelX} y={labelY} text-anchor="middle">{label}</text>
			</Fragment>
		))
	}
	<text {...anim('fade', 2.8, text.tiny)} x="300" y="290" text-anchor="middle">READ-ONLY · NO FILE IS EDITED TO ANSWER</text>
</Drawing>
