---
// Review desk: an annotated wireframe of the desk.
import { HOTKEYS } from '@entities/desk/model/hotkeys'
import { sx } from '@shared/lib/sx'
import { homeArt } from '@shared/ui/drawing/home-art.styles'
import AskThread from '@shared/ui/drawing/AskThread.astro'
import Check from '@shared/ui/drawing/Check.astro'
import CodeLine from '@shared/ui/drawing/CodeLine.astro'
import Drawing from '@shared/ui/drawing/Drawing.astro'
import Pending from '@shared/ui/drawing/Pending.astro'
import { anim, loop } from '@shared/ui/drawing/anim'
import { shape } from '@shared/ui/drawing/shape.styles'
import { text } from '@shared/ui/drawing/text.styles'
import { productArt } from '@shared/ui/drawing/product-art.styles'
import AnatomyMarker from './AnatomyMarker.astro'

// The walkthrough sidebar: section heads, and files with their verdict.
const FILES = [
	{ name: 'CONTRACTS', y: 110, kind: 'section' },
	{ name: 'contracts/review.ts', y: 130, kind: 'yes' },
	{ name: 'BEHAVIOR', y: 158, kind: 'section' },
	{ name: 'auth/session.ts', y: 178, kind: 'current' },
	{ name: 'api/middleware.ts', y: 200, kind: 'pending' },
	{ name: 'INTERFACE', y: 228, kind: 'section' },
	{ name: 'pages/desk.tsx', y: 248, kind: 'pending' },
	{ name: 'OTHER', y: 276, kind: 'section' },
	{ name: 'README.md', y: 296, kind: 'yes' },
] as const
// The progress strip across the top fills by the files you settled, and the
// sidebar counts them.
const TRACK_WIDTH = 552
const reviewedFiles = FILES.filter(({ kind }) => kind !== 'section')
const settled = reviewedFiles.filter(({ kind }) => kind === 'yes').length
const fillWidth = (TRACK_WIDTH * settled) / reviewedFiles.length
const progress = `${settled} OF ${reviewedFiles.length} FILES SETTLED`
// The numbered parts: where each marker pops in, and its name in the legend.
const MARKERS = [
	{ step: 1, x: 150, y: 72, delay: 1.9, label: 'WALKTHROUGH' },
	{ step: 2, x: 474, y: 115, delay: 2, label: 'KEEP / UNDO' },
	{ step: 3, x: 544, y: 262, delay: 2.1, label: 'THREAD' },
	{ step: 4, x: 372, y: 68, delay: 2.2, label: 'PROGRESS' },
	{ step: 5, x: 462, y: 38, delay: 2.3, label: 'SEND' },
] as const
const LEGEND_GAP = '   '
---

<Drawing
	id="anatomy-art"
	width={600}
	height={450}
	compact="182 22 402 380"
	title="Anatomy of the review desk"
	description="A wireframe of the desk with five numbered parts: the walkthrough sidebar, the keep and undo verdicts on each change, a question thread anchored to a line, the review progress strip, and the Send to agent button. Illustrative, not a screenshot."
>
	<g {...anim('rise', 0)}>
		<rect {...sx(shape.panel, shape.panelWhite)} x="24" y="30" width="552" height="362"></rect>
		<path {...sx(shape.hair)} d="M24 62h552M184 62v330M184 96h392"></path>
		<text {...sx(text.label)} x="38" y="51">syneva</text><text {...sx(text.tiny)} x="300" y="50" text-anchor="middle">AUTH-REFACTOR · ROUND 2</text>
		<rect {...sx(productArt.anatomySend)} x="486" y="37" width="80" height="18"></rect><text {...sx(text.tiny, text.white)} x="526" y="49.5" text-anchor="middle">SEND · {HOTKEYS.send}</text>
		<rect {...sx(shape.track)} x="24" y="62" width={TRACK_WIDTH} height="3"></rect>
		<rect {...anim('sweep', 1.6, shape.fill)} x="24" y="62" width={fillWidth} height="3"></rect>
		<text {...sx(text.label)} x="38" y="86">WALKTHROUGH</text>
		{
			FILES.map(({ name, y, kind }) =>
				kind === 'section' ? (
					<text {...sx(text.tiny, text.accent)} x="38" y={y}>{name}</text>
				) : (
					<Fragment>
						<text {...sx(text.file, kind === 'current' && text.strong)} x="38" y={y}>{name}</text>
						{kind === 'yes' ? <Check x={164} y={y - 9} size={10} /> : <Pending x={164} y={y - 9} size={10} />}
					</Fragment>
				),
			)
		}
		<rect {...loop('pulse', homeArt.deskCursor)} x="28" y="166" width="152" height="18"></rect>
		<text {...sx(text.tiny)} x="38" y="378">{progress}</text>
		<text {...sx(text.file, text.strong)} x="198" y="84">auth/session.ts</text><text {...sx(text.tiny)} x="312" y="84">+12 −3</text>
		<rect {...sx(shape.kbd)} x="470" y="72" width="96" height="17"></rect><text {...sx(text.tiny)} x="518" y="84" text-anchor="middle">APPROVE · {HOTKEYS.approveFile}</text>
	</g>
	<g {...anim('fade', 0.3)}>
		<CodeLine x={222} y={120} gap={12} lineNumber={12}>export function handle(req) &#123;</CodeLine>
		<rect {...anim('sweep', 0.7, shape.bandYes)} x="185" y="126" width="390" height="40"></rect>
		<CodeLine x={222} y={140} gap={12} lineNumber={13} tone="green">+  await verifySession(req)</CodeLine>
		<CodeLine x={222} y={160} gap={12} lineNumber={14} tone="green">+  return run(req)</CodeLine>
		<path {...sx(shape.hair)} d="M184 180h392"></path>
		<rect {...anim('sweep', 1.1, shape.bandNo)} x="185" y="194" width="390" height="20"></rect>
		<CodeLine x={222} y={208} gap={12} lineNumber={41} tone="accent">+  cache.set(token, user)</CodeLine>
		<path {...anim('draw', 1.3, shape.strike)} d="M238 204h148"></path>
		<CodeLine x={222} y={230} gap={12} lineNumber={42}>   return user</CodeLine>
	</g>
	<g {...anim('pop', 0.9)}><rect {...sx(shape.chipYes)} x="494" y="136" width="72" height="20"></rect><text {...sx(text.tiny, text.green)} x="530" y="149.5" text-anchor="middle">✓ KEEP {HOTKEYS.keep}</text></g>
	<g {...anim('pop', 1.25)}><rect {...sx(shape.chipNo)} x="494" y="194" width="72" height="20"></rect><text {...sx(text.tiny, text.accent)} x="530" y="207.5" text-anchor="middle">✕ UNDO {HOTKEYS.undo}</text></g>
	<g {...anim('rise', 1.5)}>
		<path {...sx(homeArt.askAnchor)} d="M214 214v40"></path>
		<AskThread x={206} y={254} width={356} height={96}>
			<text {...sx(text.tiny)} x="222" y="275">YOU · ASK</text><text {...sx(text.copy)} x="222" y="293">Why not cache the user here?</text>
			<text {...sx(text.tiny, text.accent)} x="222" y="318">YOUR AGENT</text><text {...sx(text.copy)} x="222" y="336">Tokens rotate, so the cache would go stale.</text>
		</AskThread>
	</g>
	{MARKERS.map(({ step, x, y, delay }) => <AnatomyMarker step={step} x={x} y={y} delay={delay} />)}
	<g {...anim('fade', 2.4, shape.secondary)}><text {...sx(text.tiny)} x="24" y="424">{
		MARKERS.map(({ step, label }, index) => (
			<Fragment>{index > 0 && LEGEND_GAP}<tspan {...sx(productArt.anatomyKey)}>{step}</tspan>{` ${label}`}</Fragment>
		))
	}</text></g>
</Drawing>
