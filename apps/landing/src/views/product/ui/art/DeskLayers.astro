---
// Product overview: the desk, exploded into the four layers it is made of.
import { sx } from '@shared/lib/sx'
import ArtFrame from '@shared/ui/drawing/ArtFrame.astro'
import Drawing from '@shared/ui/drawing/Drawing.astro'
import { anim, move } from '@shared/ui/drawing/anim'
import { shape } from '@shared/ui/drawing/shape.styles'
import { text } from '@shared/ui/drawing/text.styles'
import IsoSheet from './IsoSheet.astro'
import { productArt } from '@shared/ui/drawing/product-art.styles'

// Each layer: where it rests, where it travels in from, and its legend.
const LAYERS = [
	{ y: 388, from: -138, label: '01 · THE DIFF', words: 'Everything your agent changed.', tone: '' },
	{ y: 296, from: -46, label: '02 · WALKTHROUGH', words: 'Your agent’s reading order.', tone: 'accent' },
	{ y: 204, from: 46, label: '03 · THREADS', words: 'Questions pinned to the line.', tone: 'accent' },
	{ y: 112, from: 138, label: '04 · VERDICTS', words: 'Yours. Recorded per change.', tone: 'green' },
] as const
const sheetAt = (i: number) => move(0.1 + i * 0.12, 0, LAYERS[i]?.from ?? 0)
const at = (i: number): string => `translate(220 ${LAYERS[i]?.y ?? 0})`
const DIFF_BARS = [70, 92, 50, 84, 62, 40] as const
const GUIDE_BARS = [
	[78, 52],
	[64, 70],
	[86, 40],
] as const
const VERDICT_BARS = [70, 82, 60, 76] as const
---

<Drawing viewBox="0 0 600 460" compact="96 40 504 420" labelledby="layers-title layers-desc">
	<title id="layers-title">The review desk, layer by layer</title>
	<desc id="layers-desc">Four stacked sheets: your agent's diff at the bottom, the walkthrough your agent can attach above it, the questions you pin to lines above that, and your verdicts on top.</desc>
	<ArtFrame id="layers" width={600} height={460} />
	<g {...sheetAt(0)}><g transform={at(0)}><IsoSheet>{
		DIFF_BARS.map((width, i) => (
			<Fragment>
				<rect {...sx(i % 3 === 1 ? productArt.isoMarkDel : productArt.isoMarkAdd)} x="12" y={20 + i * 16} width="6" height="6" />
				<rect {...sx(productArt.isoBar)} x="24" y={20 + i * 16} width={width} height="6" />
			</Fragment>
		))
	}</IsoSheet></g></g>
	<g {...sheetAt(1)}><g transform={at(1)}><IsoSheet tone="guide">{
		GUIDE_BARS.map(([first, second], i) => (
			<Fragment>
				<rect {...sx(productArt.isoNum)} x="12" y={16 + i * 38} width="12" height="12" />
				<rect {...sx(productArt.isoBar)} x="32" y={18 + i * 38} width={first} height="7" />
				<rect {...sx(productArt.isoBar, productArt.isoBarFaint)} x="32" y={32 + i * 38} width={second} height="5" />
			</Fragment>
		))
	}</IsoSheet></g></g>
	<g {...sheetAt(2)}><g transform={at(2)}><IsoSheet tone="thread"><rect {...sx(productArt.isoBar, productArt.isoBarFaint)} x="14" y="18" width="90" height="6"></rect><rect {...sx(productArt.isoBand)} x="10" y="34" width="110" height="14"></rect><rect {...sx(productArt.isoBar)} x="14" y="38" width="76" height="6"></rect><rect {...sx(productArt.isoBubble)} x="26" y="60" width="92" height="50"></rect><rect {...sx(productArt.isoRail)} x="26" y="60" width="4" height="50"></rect><rect {...sx(productArt.isoBar)} x="38" y="72" width="62" height="5"></rect><rect {...sx(productArt.isoBar, productArt.isoBarAccent)} x="38" y="90" width="48" height="5"></rect></IsoSheet></g></g>
	<g {...sheetAt(3)}><g transform={at(3)}><IsoSheet tone="verdict">{
		VERDICT_BARS.map((width, i) => (
			<Fragment>
				<rect {...sx(productArt.isoBar)} x="14" y={20 + i * 26} width={width} height="7" />
				<rect {...sx(i === 2 ? productArt.isoNo : productArt.isoYes)} x="104" y={16 + i * 26} width="14" height="14" />
			</Fragment>
		))
	}</IsoSheet></g></g>
	{
		LAYERS.map(({ y, label, words, tone }, i) => (
			<Fragment>
				<path {...anim('draw', 1 + i * 0.12, shape.route)} pathLength="1" d={`M332 ${y}h48`} />
				<circle {...sx(shape.port)} cx="332" cy={y} r="2.5" />
				<g {...anim('fade', 1.15 + i * 0.12)}>
					<text {...sx(text.tiny, tone === 'green' && text.green, tone === 'accent' && text.accent)} x="392" y={y - 4}>{label}</text>
					<text {...sx(text.small)} x="392" y={y + 14}>{words}</text>
				</g>
			</Fragment>
		))
	}
</Drawing>
