---
// Product overview: the desk, exploded into the four layers it is made of.
import { sx } from '@shared/lib/sx'
import Drawing from '@shared/ui/drawing/Drawing.astro'
import { anim } from '@shared/ui/drawing/anim'
import { productArt } from '@shared/ui/drawing/product-art.styles'
import { shape } from '@shared/ui/drawing/shape.styles'
import { text } from '@shared/ui/drawing/text.styles'
import ExplodedLayer from './ExplodedLayer.astro'

// Each layer, bottom to top: what it carries, where it rests, where it
// travels in from, and its legend.
const LAYERS = [
	{ kind: 'diff', y: 388, from: -138, label: '01 · THE DIFF', words: 'Everything your agent changed.' },
	{ kind: 'guide', y: 296, from: -46, label: '02 · WALKTHROUGH', words: 'Your agent’s reading order.' },
	{ kind: 'thread', y: 204, from: 46, label: '03 · THREADS', words: 'Questions pinned to the line.' },
	{ kind: 'verdict', y: 112, from: 138, label: '04 · VERDICTS', words: 'Yours. Recorded per change.' },
] as const
type Layer = (typeof LAYERS)[number]
const [diff, walkthrough, threads, verdicts] = LAYERS
// The sheets arrive a beat apart, and their legends follow at the same pace.
const BEAT = 0.12
const beatOf = (layer: Layer): number => LAYERS.indexOf(layer) * BEAT
const sheetDelay = (layer: Layer): number => 0.1 + beatOf(layer)
const LABEL_TONE = { diff: null, guide: text.accent, thread: text.accent, verdict: text.green } as const
const DIFF_LINES = [
	{ width: 70, change: 'added' },
	{ width: 92, change: 'deleted' },
	{ width: 50, change: 'added' },
	{ width: 84, change: 'added' },
	{ width: 62, change: 'deleted' },
	{ width: 40, change: 'added' },
] as const
const CHANGE_MARK = { added: productArt.isoMarkAdd, deleted: productArt.isoMarkDeleted } as const
const GUIDE_BARS = [
	[78, 52],
	[64, 70],
	[86, 40],
] as const
const VERDICT_ROWS = [
	{ width: 70, verdict: 'kept' },
	{ width: 82, verdict: 'kept' },
	{ width: 60, verdict: 'undone' },
	{ width: 76, verdict: 'kept' },
] as const
const VERDICT_MARK = { kept: productArt.isoYes, undone: productArt.isoNo } as const
---

<Drawing
	id="layers"
	width={600}
	height={460}
	compact="96 40 504 420"
	title="The review desk, layer by layer"
	description="Four stacked sheets: your agent's diff at the bottom, the walkthrough your agent can attach above it, the questions you pin to lines above that, and your verdicts on top."
>
	<ExplodedLayer layer={diff} delay={sheetDelay(diff)}>{
		DIFF_LINES.map(({ width, change }, i) => (
			<Fragment>
				<rect {...sx(CHANGE_MARK[change])} x="12" y={20 + i * 16} width="6" height="6" />
				<rect {...sx(productArt.isoBar)} x="24" y={20 + i * 16} width={width} height="6" />
			</Fragment>
		))
	}</ExplodedLayer>
	<ExplodedLayer layer={walkthrough} delay={sheetDelay(walkthrough)}>{
		GUIDE_BARS.map(([first, second], i) => (
			<Fragment>
				<rect {...sx(productArt.isoNumber)} x="12" y={16 + i * 38} width="12" height="12" />
				<rect {...sx(productArt.isoBar)} x="32" y={18 + i * 38} width={first} height="7" />
				<rect {...sx(productArt.isoBar, productArt.isoBarFaint)} x="32" y={32 + i * 38} width={second} height="5" />
			</Fragment>
		))
	}</ExplodedLayer>
	<ExplodedLayer layer={threads} delay={sheetDelay(threads)}><rect {...sx(productArt.isoBar, productArt.isoBarFaint)} x="14" y="18" width="90" height="6"></rect><rect {...sx(productArt.isoBand)} x="10" y="34" width="110" height="14"></rect><rect {...sx(productArt.isoBar)} x="14" y="38" width="76" height="6"></rect><rect {...sx(productArt.isoBubble)} x="26" y="60" width="92" height="50"></rect><rect {...sx(productArt.isoRail)} x="26" y="60" width="4" height="50"></rect><rect {...sx(productArt.isoBar)} x="38" y="72" width="62" height="5"></rect><rect {...sx(productArt.isoBar, productArt.isoBarAccent)} x="38" y="90" width="48" height="5"></rect></ExplodedLayer>
	<ExplodedLayer layer={verdicts} delay={sheetDelay(verdicts)}>{
		VERDICT_ROWS.map(({ width, verdict }, i) => (
			<Fragment>
				<rect {...sx(productArt.isoBar)} x="14" y={20 + i * 26} width={width} height="7" />
				<rect {...sx(VERDICT_MARK[verdict])} x="104" y={16 + i * 26} width="14" height="14" />
			</Fragment>
		))
	}</ExplodedLayer>
	{
		LAYERS.map(layer => (
			<Fragment>
				<path {...anim('draw', 1 + beatOf(layer), shape.route)} d={`M332 ${layer.y}h48`} />
				<circle {...sx(shape.port)} cx="332" cy={layer.y} r="2.5" />
				<g {...anim('fade', 1.15 + beatOf(layer))}>
					<text {...sx(text.tiny, LABEL_TONE[layer.kind])} x="392" y={layer.y - 4}>{layer.label}</text>
					<text {...sx(text.small)} x="392" y={layer.y + 14}>{layer.words}</text>
				</g>
			</Fragment>
		))
	}
</Drawing>
