---
// One layer of the exploded desk: its sheet rests at y in the sheets' column
// and travels in from `from` px away, carrying the layer's marks (the slot).
import type { ComponentProps } from 'astro/types'
import { move } from '@shared/ui/drawing/anim'
import IsoSheet from './IsoSheet.astro'

type Props = { layer: { kind: ComponentProps<typeof IsoSheet>['kind']; y: number; from: number }; delay: number }

const { layer, delay } = Astro.props
const COLUMN_X = 220
---

<g {...move(delay, 0, layer.from)}><g transform={`translate(${COLUMN_X} ${layer.y})`}><IsoSheet kind={layer.kind}><slot /></IsoSheet></g></g>
