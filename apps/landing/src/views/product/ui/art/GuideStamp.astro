---
import { commandOf } from '@entities/desk/model/agent-contract'
import { sx } from '@shared/lib/sx'
import Drawing from '@shared/ui/drawing/Drawing.astro'
import { anim } from '@shared/ui/drawing/anim'
import { shape } from '@shared/ui/drawing/shape.styles'
import { text } from '@shared/ui/drawing/text.styles'

const SWAP_GUIDE = `${commandOf('reload')} --guide`
---

<Drawing
	id="stamp"
	width={600}
	height={240}
	compact="30 40 550 190"
	density="dense"
	title="A guide is stamped to its diff"
	description={`The guide is attached to the diff it was written for and survives reloads. When a reload moves the diff past it, the desk notes that the grouping may be out of date, and your agent can swap in a new guide with ${SWAP_GUIDE}.`}
>
	<g {...anim('rise', 0)}><rect {...sx(shape.panel, shape.panelWhite)} x="40" y="60" width="150" height="110"></rect><text {...sx(text.tiny)} x="54" y="82">GUIDE.JSON</text><path {...sx(shape.lines)} d="M54 100h100M54 116h80M54 132h110M54 148h70"></path></g>
	<path {...anim('draw', 0.4, shape.route)} d="M190 115h60"></path>
	<g {...anim('rise', 0.5)}><rect {...sx(shape.panel)} x="250" y="60" width="150" height="110"></rect><text {...sx(text.tiny)} x="264" y="82">DIFF · ROUND 1</text><rect {...sx(shape.bandYes)} x="251" y="96" width="148" height="20"></rect><text {...sx(text.tiny, text.green)} x="264" y="110">STAMPED ✓</text><path {...sx(shape.lines)} d="M264 134h96M264 150h70"></path></g>
	<path {...anim('draw', 0.9, shape.route, shape.routeDotted)} d="M400 115h50"></path>
	<text {...anim('fade', 1, text.tiny)} x="425" y="105" text-anchor="middle">RELOAD</text>
	<g {...anim('rise', 1.1)}><rect {...sx(shape.panel)} x="450" y="60" width="120" height="110"></rect><text {...sx(text.tiny)} x="464" y="82">DIFF · ROUND 3</text><rect {...sx(shape.bandNo)} x="451" y="96" width="118" height="34"></rect><text {...sx(text.tiny, text.accent)} x="464" y="110">GROUPING MAY</text><text {...sx(text.tiny, text.accent)} x="464" y="124">BE OUT OF DATE</text><path {...sx(shape.lines)} d="M464 150h80"></path></g>
	<text {...anim('fade', 1.5, text.code)} x="300" y="210" text-anchor="middle">{SWAP_GUIDE} new.json</text>
</Drawing>
