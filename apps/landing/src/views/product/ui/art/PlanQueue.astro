---
// Plan desk (prototype): a plan becomes a queue of claims ranked by risk.
import { sx } from '@shared/lib/sx'
import { homeArt } from '@shared/ui/drawing/home-art.styles'
import Drawing from '@shared/ui/drawing/Drawing.astro'
import { anim } from '@shared/ui/drawing/anim'
import { shape } from '@shared/ui/drawing/shape.styles'
import { text } from '@shared/ui/drawing/text.styles'
import { productArt } from '@shared/ui/drawing/product-art.styles'
import { twoDigits } from '@shared/lib/two-digits'

const CLAIMS = [
	{ words: 'Sessions move to middleware', risk: 3, state: 'Needs proof', kind: 'risk' },
	{ words: 'Routes never cache users', risk: 2, state: 'Ask the agent', kind: 'question' },
	{ words: 'Expired sessions return 401', risk: 1, state: 'Settled', kind: 'yes' },
	{ words: 'No schema change is required', risk: 1, state: 'Settled', kind: 'yes' },
] as const
const CELLS = [0, 1, 2] as const
// A claim's risk fills its meter in one tone: three cells high, two mid.
const RISK_TONE = { 3: productArt.riskHigh, 2: productArt.riskMid, 1: productArt.riskLow } as const
const CLAIM_TONE = { risk: [homeArt.planClaim, homeArt.planRisk], question: [homeArt.planClaim], yes: [homeArt.planClaim, homeArt.planSettled] } as const
const rowY = (index: number): number => 96 + index * 72
---

<Drawing
	id="queue"
	width={600}
	height={420}
	compact="270 30 320 380"
	title="A plan as a queue of claims"
	description="Prototype concept. Sentences highlighted in a plan become claims, ranked by risk: an assumption that needs proof first, then a question for the agent, then claims already settled."
>
	<g {...anim('rise', 0)}>
		<rect {...sx(shape.panel, shape.panelWhite)} x="30" y="70" width="210" height="300"></rect>
		<text {...sx(text.label)} x="30" y="56">plan.md</text>
		<path {...sx(shape.lines)} d="M48 96h150M48 112h120M48 168h160M48 184h90M48 240h140M48 256h170M48 312h110M48 328h150"></path>
		<rect {...anim('sweep', 0.4, homeArt.planHighlight)} x="44" y="128" width="170" height="20"></rect>
		<rect {...anim('sweep', 0.5, productArt.queueMark)} x="44" y="200" width="150" height="20"></rect>
		<rect {...anim('sweep', 0.6, shape.bandYes)} x="44" y="272" width="166" height="20"></rect>
	</g>
	<g fill="none">
		<path {...anim('draw', 0.8, shape.route, shape.routeAccent)} d="M214 138C252 138 252 124 290 124"></path>
		<path {...anim('draw', 0.95, shape.route)} d="M194 210C242 210 242 196 290 196"></path>
		<path {...anim('draw', 1.1, shape.route, shape.routeGreen)} d="M210 282C250 282 250 268 290 268"></path>
	</g>
	<text {...sx(text.tiny, text.accent)} x="290" y="76">RANKED BY RISK</text>
	<g {...anim('pop', 1.6)}><rect {...sx(productArt.protoTag)} x="476" y="34" width="96" height="20"></rect><text {...sx(text.tiny, text.accent)} x="524" y="48" text-anchor="middle">PROTOTYPE</text></g>
	{
		CLAIMS.map(({ words, risk, state, kind }, index) => (
			<g {...anim('rise', 0.8 + index * 0.18)}>
				<rect {...sx(CLAIM_TONE[kind])} x="290" y={rowY(index)} width="282" height="56" />
				<text {...sx(text.tiny, text.accent)} x="304" y={rowY(index) + 21}>{twoDigits(index + 1)}</text>
				<text {...sx(text.copy)} x="326" y={rowY(index) + 22}>{words}</text>
				<text {...sx(text.small)} x="326" y={rowY(index) + 41}>{state}</text>
				{CELLS.map(cell => (
					<rect {...sx(productArt.riskCell, cell < risk && RISK_TONE[risk])} x={528 + cell * 12} y={rowY(index) + 14} width="9" height="9" />
				))}
			</g>
		))
	}
</Drawing>
