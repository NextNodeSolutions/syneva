---
import HistoryRail from './art/HistoryRail.astro'
import CtaBand from '@widgets/cta-band/ui/CtaBand.astro'
import PageHero from '@widgets/page-hero/ui/PageHero.astro'
import Pager from '@widgets/page-index/ui/Pager.astro'
import Prose from '@shared/ui/prose/Prose.astro'
import TextLink from '@shared/ui/TextLink.astro'
import { REPO_URL } from '@entities/site/model/site-map'
import { WEEKS } from '../model/changelog'
import VersionList from './VersionList.astro'
---

<PageHero
	title="What shipped."
	lede="Straight from the git history, grouped by week and written for humans. Releases are cut automatically from the commit messages; this page tells you what they mean for your review."
	caption="Counts of feat, fix and perf commits. Not a growth chart."
>
	<TextLink slot="actions" href={`${REPO_URL}/commits/main`} label="Every commit on GitHub" />
	<HistoryRail slot="art" />
</PageHero>
<Prose id="log" title="Recent changes.">
	<VersionList weeks={WEEKS} />
</Prose>
<CtaBand />
<Pager />
