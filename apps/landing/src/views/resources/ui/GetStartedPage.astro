---
import Command from '@features/copy-command/ui/Command.astro'
import Callout from '@shared/ui/prose/Callout.astro'
import PageHero from '@widgets/page-hero/ui/PageHero.astro'
import Pager from '@widgets/page-index/ui/Pager.astro'
import Prose from '@shared/ui/prose/Prose.astro'
import ProseText from '@shared/ui/prose/ProseText.astro'
import SpecTable from '@shared/ui/prose/SpecTable.astro'
import Terminal from '@shared/ui/prose/Terminal.astro'
import TextLink from '@shared/ui/TextLink.astro'
import { INSTALL_COMMAND, ISSUES_URL, NODE_REQUIREMENT, REPO_URL, START_COMMAND } from '@entities/site/model/project'
import { PAGES, SECTION_BY_ID } from '@entities/site/model/site-map'
import { HOTKEYS } from '@entities/desk/model/hotkeys'
import StartFlow from './art/StartFlow.astro'
import { SPEC_COMMAND } from '@entities/desk/model/agent-contract'

const REQUIREMENTS = [
	[NODE_REQUIREMENT, 'For the CLI.'],
	['git', 'Every review mode reads your repository through git.'],
	['A browser', 'The desk is a tab on localhost.'],
	['Your coding agent', 'Codex, Cursor, pi, or anything that runs a shell command.'],
	['gh (optional)', 'Only to review pull requests by number or URL.'],
] as const
const { host, pathname } = new URL(REPO_URL)
const INSTALL = ['# with pi: pin a tag or commit', `$ pi install git:${host}${pathname}@<ref>`, '', '# anywhere else', `$ ${INSTALL_COMMAND}`]
const OPEN = ['$ cd your-repository', `$ ${START_COMMAND}`, '# desk ready, open in your browser']
const LOOP = [
	'# your agent, after it edits',
	'$ syneva await          # blocks until you Send or ask',
	'$ syneva comment …      # answers your question on the line',
	'$ syneva reload         # shows its next revision in your tab',
]
const FIRST_KEYS = [
	[`${HOTKEYS.nextChange} / ${HOTKEYS.previousChange}`, 'Move between changes'],
	[`${HOTKEYS.keep} / ${HOTKEYS.undo}`, 'Keep or undo the change'],
	[`${HOTKEYS.commentOnLine}, then ${HOTKEYS.ask}`, 'Ask your agent about the line'],
	[HOTKEYS.approveFile, 'Approve the whole file'],
	[HOTKEYS.send, 'Send your verdict to the agent'],
	[HOTKEYS.keyboardMap, 'Every other key'],
] as const
---

<PageHero
	title="From install to your first verdict."
	lede="Two commands open a desk. One more lets your agent hear back. Here is the whole path, for pi and for every other agent."
	caption="Install · open a desk · attach your agent"
>
	<Command slot="actions" text={INSTALL_COMMAND} label="Installation command" />
	<StartFlow slot="art" />
</PageHero>
<Prose id="requirements" title="What you need.">
	<SpecTable rows={REQUIREMENTS} head={['Requirement', 'Why']} />
</Prose>
<Prose id="install" title="1. Install.">
	<ProseText>As a pi package, Syneva ships the CLI, a <code>/syneva</code> status command, the <code>/review</code> and <code>/plan</code> prompt templates, a skill, and a read-only answer subagent. Everywhere else, install the CLI from npm.</ProseText>
	<Terminal lines={INSTALL} title="install" />
</Prose>
<Prose id="open" title="2. Open a desk.">
	<ProseText>Run it next to the repository your agent just changed. The first open starts the hub, one process per machine; the desk opens in your browser at its own URL and stays open across rounds. The dashboard at <code>http://127.0.0.1:4747/</code> lists every project and desk.</ProseText>
	<Terminal lines={OPEN} title="your repository" />
	<ProseText><TextLink href={SECTION_BY_ID.workflows.href} label="Staged changes, pull requests and single files" /></ProseText>
</Prose>
<Prose id="attach" title="3. Let your agent<br>hear back.">
	<ProseText><strong>In pi,</strong> run <code>/review</code>: it starts a desk and attaches your session, so your Sends and questions reach the agent on their own.</ProseText>
	<ProseText><strong>With any other agent,</strong> ask it to run <code>{SPEC_COMMAND}</code> and follow the loop it describes. In short:</ProseText>
	<Terminal lines={LOOP} title="your agent" />
	<ProseText><TextLink href={PAGES.connectYourAgent.href} label="The full agent contract" /></ProseText>
</Prose>
<Prose id="review" title="4. Review<br>and Send.">
	<SpecTable rows={FIRST_KEYS} head={['Keys', 'Does']} />
	<Callout lead={'That’s the loop.'} tone="settled">Your agent acts on the verdict, reloads, and the next round lands in the same tab. Stuck somewhere? <TextLink href={PAGES.faq.href} label="Questions & answers" /> or <TextLink href={ISSUES_URL} label="open an issue" />.</Callout>
</Prose>
<Pager />
