---
// The 404: this page, as a change that was undone.
import LostDiff from './art/LostDiff.astro'
import Button from '@shared/ui/Button.astro'
import { pageActionsMarker } from '@shared/ui/actions.stylex'
import TextLink from '@shared/ui/TextLink.astro'
import { revealGroup, revealItem, scene } from '@shared/lib/reveal'
import { lost } from './lost.styles'
---

<section {...revealGroup(lost.root)} aria-labelledby="page-title">
	<div>
		<h1 {...revealItem(lost.title)} id="page-title">This change<br />was undone.</h1>
		<p {...revealItem(lost.text)}>The page you asked for doesn&rsquo;t exist, or moved. Everything that does is one click away.</p>
		<div {...revealItem(lost.actions, pageActionsMarker)}><Button href="/" label="Back to the home page" /><TextLink href="/get-started/" label="Get started" /></div>
	</div>
	<figure {...revealItem(lost.art)} {...scene}><LostDiff /></figure>
</section>
