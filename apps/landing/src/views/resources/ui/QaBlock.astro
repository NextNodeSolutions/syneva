---
// One FAQ topic: its number, title and blurb on the left, its questions as
// native disclosures on the right.
import { chapter } from '@widgets/chapter/ui/chapter.styles'
import QaDisclosure from '@features/disclosure/ui/QaDisclosure.astro'
import { heading } from '@shared/ui/heading.styles'
import { stepIndex } from '@shared/ui/step-index.styles'
import { revealItem, revealRuledGroup } from '@shared/lib/reveal'
import { sx } from '@shared/lib/sx'
import type { QaGroup } from '../model/faq'
import { qaAnchor } from '../model/faq'
import { qa } from './qa.styles'
import { twoDigits } from '@shared/lib/two-digits'

type Props = { group: QaGroup; index: number }

const { group, index } = Astro.props
const id = qaAnchor(index)
const count = `${group.items.length} question${group.items.length === 1 ? '' : 's'}`
---

<section {...revealRuledGroup(chapter.section, chapter.subSection, qa.block)} id={id} aria-labelledby={`${id}-title`}>
	<div {...sx(chapter.copy, chapter.subCopy, qa.copy)}>
		<span {...revealItem(stepIndex.base)}>{twoDigits(index + 1)} · {count}</span>
		<h2 {...revealItem(heading.section, heading.subpage)} id={`${id}-title`}>{group.title}</h2>
		<p {...revealItem(chapter.text)}>{group.blurb}</p>
	</div>
	<div {...sx(qa.list)}>
		{group.items.map(({ question, answer }) => <QaDisclosure question={question} answer={answer} />)}
	</div>
</section>
