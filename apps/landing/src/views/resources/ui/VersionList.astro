---
// The changelog's weeks: a date, a headline and the tagged changes.
import { revealItem } from '@shared/lib/reveal'
import { sx } from '@shared/lib/sx'
import type { ChangeKind, Week } from '../model/changelog'
import { versionList } from './version-list.styles'

type Props = { weeks: readonly Week[] }

const { weeks } = Astro.props
const TAG = { feat: versionList.feat, fix: versionList.fix, perf: versionList.perf } as const satisfies Record<ChangeKind, unknown>
---

<ol {...sx(versionList.root)}>
	{
		weeks.map(({ iso, label, title, changes }) => (
			<li {...revealItem(versionList.week)}>
				<time {...sx(versionList.date)} datetime={iso}>{label}</time>
				<h3 {...sx(versionList.title)}>{title}</h3>
				<ul {...sx(versionList.changes)}>
					{changes.map(([kind, change]) => (
						<li {...sx(versionList.change)}>
							<b {...sx(versionList.tag, TAG[kind])}>{kind}</b>
							{change}
						</li>
					))}
				</ul>
			</li>
		))
	}
</ol>
