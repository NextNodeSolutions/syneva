---
// Changelog: shipped work as a day-by-day stacked rail.
import type { Style } from '@shared/lib/sx'
import { sx } from '@shared/lib/sx'
import Drawing from '@shared/ui/drawing/Drawing.astro'
import { anim, move } from '@shared/ui/drawing/anim'
import { shape } from '@shared/ui/drawing/shape.styles'
import { text } from '@shared/ui/drawing/text.styles'
import type { ChangeKind } from '../../model/change-kinds'
import { CHANGE_KINDS } from '../../model/change-kinds'

type DayCount = { day: string } & Record<ChangeKind, number>

// Real commit counts per day, from the repository history; days are
// month-day pairs of HISTORY_YEAR.
const HISTORY = [
	{ day: '09-15', feat: 3, fix: 0, perf: 0 },
	{ day: '09-16', feat: 1, fix: 0, perf: 0 },
	{ day: '09-17', feat: 0, fix: 1, perf: 0 },
	{ day: '09-18', feat: 0, fix: 0, perf: 0 },
	{ day: '09-19', feat: 1, fix: 2, perf: 3 },
	{ day: '09-20', feat: 1, fix: 4, perf: 4 },
	{ day: '09-21', feat: 0, fix: 4, perf: 1 },
	{ day: '09-22', feat: 1, fix: 2, perf: 5 },
	{ day: '09-23', feat: 5, fix: 5, perf: 3 },
	{ day: '09-24', feat: 0, fix: 0, perf: 0 },
	{ day: '09-25', feat: 0, fix: 0, perf: 0 },
	{ day: '09-26', feat: 0, fix: 0, perf: 0 },
	{ day: '09-27', feat: 0, fix: 0, perf: 0 },
	{ day: '09-28', feat: 0, fix: 0, perf: 0 },
	{ day: '09-29', feat: 0, fix: 0, perf: 0 },
	{ day: '09-30', feat: 0, fix: 2, perf: 0 },
	{ day: '10-01', feat: 1, fix: 0, perf: 0 },
	{ day: '10-02', feat: 2, fix: 2, perf: 0 },
] as const satisfies readonly DayCount[]
const BASE = 320
const STEP = 28
const CELL = 11
const SQUARE = 10
const KIND: Record<ChangeKind, Style> = { feat: shape.yes, fix: shape.no, perf: shape.panelWhite }
// Where each kind's legend swatch sits; its label follows to the right.
const LEGEND_X: Record<ChangeKind, number> = { feat: 52, fix: 120, perf: 180 }
const LEGEND_LABEL_GAP = 16
const LAST = HISTORY.length - 1
// A date under every fourth day, and under the last one. Dates one column
// apart would overlap, so a fourth day right before the last gives its date up.
const DATE_EVERY = 4
const isDated = (index: number): boolean => (index % DATE_EVERY === 0 && index < LAST - 1) || index === LAST
const columnX = (index: number): number => 52 + index * STEP
const centerOf = (index: number): number => columnX(index) + SQUARE / 2
// A day's commits stack one square per commit, in the changelog's kind order.
const cellsOf = (count: DayCount): ChangeKind[] =>
	CHANGE_KINDS.flatMap(kind => Array.from({ length: count[kind] }, (): ChangeKind => kind))
const days = HISTORY.map((count, index) => ({
	x: columnX(index),
	center: centerOf(index),
	cells: cellsOf(count),
	date: count.day.replace('-', '/'),
	hasDate: isDated(index),
	delay: 0.2 + index * 0.05,
}))
// The review notes panel shipped on 09-23. The pointer rises from above that
// column's stack and runs right to its label.
const NOTES_PANEL_DAY: (typeof HISTORY)[number]['day'] = '09-23'
const NOTES_PANEL_X = centerOf(HISTORY.findIndex(({ day }) => day === NOTES_PANEL_DAY))
const POINTER_RUN = 40
const POINTER_LABEL_GAP = 5
// The description says the span and the busiest day in words, and names the
// notes panel as the busiest day's work: a history where another day leads
// fails the build until the sentence is rewritten.
const HISTORY_YEAR = 2026
const MONTH_NAMES = ['January', 'February', 'March', 'April', 'May', 'June', 'July', 'August', 'September', 'October', 'November', 'December'] as const
function spokenDay(day: string): string {
	const [month, date] = day.split('-').map(Number)
	// Months and dates start at 1, so a missing or zero part fails the check.
	const name = month ? MONTH_NAMES[month - 1] : undefined
	if (!name || !date) throw new Error(`The history day "${day}" is not a month-day pair.`)
	return `${name} ${date}`
}
const dayTotal = (count: DayCount): number => CHANGE_KINDS.reduce((sum, kind) => sum + count[kind], 0)
const [FIRST_DAY] = HISTORY
// reduce over the non-empty history keeps its last day, then its busiest.
const LAST_DAY = HISTORY.reduce<DayCount>((_previous, count) => count, FIRST_DAY)
const BUSIEST_DAY = HISTORY.reduce<DayCount>((busiest, count) => (dayTotal(count) > dayTotal(busiest) ? count : busiest), FIRST_DAY)
if (BUSIEST_DAY.day !== NOTES_PANEL_DAY) throw new Error(`The busiest history day is ${BUSIEST_DAY.day}, not the notes panel's ${NOTES_PANEL_DAY}: rewrite HistoryRail's description.`)
---

<Drawing
	id="history-art"
	width={600}
	height={400}
	compact="36 40 540 330"
	title="Shipped, day by day"
	description={`Feature, fix and performance commits per day from ${spokenDay(FIRST_DAY.day)} to ${spokenDay(LAST_DAY.day)}, ${HISTORY_YEAR}, taken from the repository history. The busiest day, ${spokenDay(BUSIEST_DAY.day)}, shipped the review notes panel.`}
>
	<text {...anim('fade', 0, text.tiny)} x="52" y="66">COMMITS PER DAY · FROM THE GIT HISTORY</text>
	<g {...anim('fade', 0.1)}>{
		CHANGE_KINDS.map(kind => (
			<Fragment>
				<rect {...sx(KIND[kind])} x={LEGEND_X[kind]} y="84" width={SQUARE} height={SQUARE} />
				<text {...sx(text.tiny)} x={LEGEND_X[kind] + LEGEND_LABEL_GAP} y="93">{kind.toUpperCase()}</text>
			</Fragment>
		))
	}</g>
	<path {...anim('draw', 0, shape.route)} d={`M44 ${BASE + 2}H556`}></path>
	{
		days.map(({ x, center, cells, date, hasDate, delay }) => (
			<Fragment>
				<g {...move(delay, 0, 30)}>
					{cells.map((kind, level) => (
						<rect {...sx(KIND[kind])} x={x} y={BASE - 12 - level * CELL} width={SQUARE} height={SQUARE} />
					))}
				</g>
				<path {...sx(shape.hair)} d={`M${center} ${BASE + 2}v5`} />
				{hasDate && <text {...sx(text.tiny)} x={center} y={BASE + 22} text-anchor="middle">{date}</text>}
			</Fragment>
		))
	}
	<path {...anim('draw', 1.4, shape.route, shape.routeAccent)} d={`M${NOTES_PANEL_X} 160V130h${POINTER_RUN}`}></path>
	<text {...anim('fade', 1.5, text.tiny, text.accent)} x={NOTES_PANEL_X + POINTER_RUN + POINTER_LABEL_GAP} y="134">REVIEW NOTES PANEL</text>
</Drawing>
