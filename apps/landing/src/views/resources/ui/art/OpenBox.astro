---
// Open source: a protocol, an interface, and no model inside.
import { sx } from '@shared/lib/sx'
import ArtFrame from '@shared/ui/drawing/ArtFrame.astro'
import Drawing from '@shared/ui/drawing/Drawing.astro'
import { anim } from '@shared/ui/drawing/anim'
import { shape } from '@shared/ui/drawing/shape.styles'
import { text } from '@shared/ui/drawing/text.styles'
import { resourcesArt } from './resources-art.styles'

const AGENTS = ['Any agent', 'Codex', 'Cursor', 'pi', 'your script'] as const
const ROW = 52
const wireOf = (i: number): string => `M160 ${103 + i * ROW}C200 ${103 + i * ROW} 200 210 240 210`
---

<Drawing viewBox="0 0 600 420" compact="20 40 570 350" labelledby="oss-title oss-desc">
	<title id="oss-title">A protocol and an interface, nothing more</title>
	<desc id="oss-desc">Any agent plugs into Syneva over JSON on stdout. Syneva serves your desk over localhost HTTP. The slot where a model would sit is empty, on purpose. MIT licensed.</desc>
	<ArtFrame id="oss" width={600} height={420} />
	{
		AGENTS.map((name, i) => (
			<Fragment>
				<g {...anim('rise', i * 0.08)}>
					<rect {...sx(shape.panel, shape.panelWhite)} x="40" y={86 + i * ROW} width="120" height="34" />
					<text {...sx(text.file)} x="54" y={107 + i * ROW}>{name}</text>
				</g>
				<path {...anim('draw', 0.5 + i * 0.06, shape.route)} pathLength="1" d={wireOf(i)} />
			</Fragment>
		))
	}
	<path {...anim('signal', 1.6, shape.signal)} pathLength="100" d="M160 103C200 103 200 210 240 210"></path>
	<path {...anim('signal', 3, shape.signal)} pathLength="100" d="M160 311C200 311 200 210 240 210"></path>
	<g {...anim('rise', 0.4)}>
		<rect {...sx(shape.panel, shape.panelWhite)} x="240" y="120" width="160" height="180"></rect>
		<text {...sx(text.label)} x="256" y="146">syneva</text>
		<rect {...sx(resourcesArt.slot)} x="256" y="166" width="128" height="58"></rect>
		<text {...sx(text.tiny)} x="320" y="192" text-anchor="middle">NO MODEL</text>
		<text {...sx(text.tiny)} x="320" y="208" text-anchor="middle">HERE, ON PURPOSE</text>
		<text {...sx(text.tiny)} x="256" y="252">RENDERS THE DIFF</text>
		<text {...sx(text.tiny)} x="256" y="268">VALIDATES INPUT</text>
		<text {...sx(text.tiny)} x="256" y="284">HANDS BACK A RESULT</text>
	</g>
	<circle {...sx(shape.port)} cx="240" cy="210" r="3"></circle>
	<text {...anim('fade', 0.9, text.tiny)} x="200" y="70" text-anchor="middle">JSON · STDOUT</text>
	<path {...anim('draw', 1, shape.route, shape.routeGreen)} pathLength="1" d="M400 210h60"></path>
	<path {...anim('signal', 2.2, shape.signal, shape.signalGreen)} pathLength="100" d="M400 210h60"></path>
	<text {...anim('fade', 1.1, text.tiny)} x="430" y="198" text-anchor="middle">HTTP</text>
	<g {...anim('rise', 1.2)}><rect {...sx(shape.panel, shape.panelMint)} x="460" y="170" width="100" height="80"></rect><text {...sx(text.tiny, text.green)} x="510" y="196" text-anchor="middle">YOUR DESK</text><text {...sx(text.small)} x="510" y="220" text-anchor="middle">localhost</text></g>
	<g {...anim('pop', 1.6)}><rect {...sx(resourcesArt.stamp)} x="464" y="300" width="92" height="44"></rect><text {...sx(text.head, text.accent)} x="510" y="329" text-anchor="middle">MIT</text></g>
</Drawing>
