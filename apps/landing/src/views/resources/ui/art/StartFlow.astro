---
// Get started: three commands, then the desk opens in your browser.
import { sx } from '@shared/lib/sx'
import { productArt } from '@shared/ui/drawing/product-art.styles'
import Check from '@shared/ui/drawing/Check.astro'
import Drawing from '@shared/ui/drawing/Drawing.astro'
import { anim } from '@shared/ui/drawing/anim'
import { shape } from '@shared/ui/drawing/shape.styles'
import { text } from '@shared/ui/drawing/text.styles'
import { resourcesArt } from './resources-art.styles'

const STEPS = [
	{ label: '01 · INSTALL', command: '$ npm install -g syneva', output: 'added 1 package', y: 70 },
	{ label: '02 · OPEN A DESK', command: '$ syneva', output: 'desk ready · http://localhost:41873', y: 180 },
	{ label: '03 · ATTACH YOUR AGENT', command: '$ syneva await', output: '{ "kind": "review", "result": … }', y: 290 },
] as const
const LAST = STEPS.length - 1
const STEP_DELAY = 0.6
const TO_DESK = 'M334 228C352 228 352 200 370 200'
---

<Drawing
	id="start"
	width={600}
	height={420}
	compact="24 30 316 370"
	title="Three commands to your first review"
	description="Install the CLI with npm, run syneva in your repository and a desk opens on localhost in your browser, then your agent attaches with syneva await and receives your verdict as JSON."
>
	<g {...anim('rise', 0)}><rect {...sx(shape.panel, shape.panelWhite)} x="34" y="40" width="300" height="340"></rect><path {...sx(shape.hair)} d="M34 56h300"></path><rect {...sx(resourcesArt.termDotAccent)} x="42" y="45" width="6" height="6"></rect><rect {...sx(resourcesArt.termDot)} x="52" y="45" width="6" height="6"></rect><rect {...sx(resourcesArt.termDot)} x="62" y="45" width="6" height="6"></rect></g>
	{
		STEPS.map(({ label, command, output, y }, i) => (
			<Fragment>
				<g {...anim('fade', 0.3 + i * STEP_DELAY)}>
					<text {...sx(text.tiny, text.accent)} x="50" y={y}>{label}</text>
				</g>
				<text {...anim('type', 0.4 + i * STEP_DELAY, text.code)} x="50" y={y + 26}>{command}</text>
				<text {...anim('fade', 0.75 + i * STEP_DELAY, text.code, i === LAST ? text.green : text.muted)} x="50" y={y + 48}>{output}</text>
			</Fragment>
		))
	}
	<path {...anim('draw', 1.4, shape.route, shape.routeAccent)} pathLength="1" d={TO_DESK}></path>
	<path {...anim('signal', 2.2, shape.signal)} pathLength="100" d={TO_DESK}></path>
	<g {...anim('rise', 1.5)}>
		<rect {...sx(shape.panel, shape.panelWhite)} x="370" y="100" width="200" height="200"></rect>
		<path {...sx(shape.hair)} d="M370 122h200"></path><rect {...sx(shape.dot)} x="378" y="109" width="5" height="5"></rect><text {...sx(text.tiny)} x="390" y="115">localhost:41873</text>
		<path {...sx(shape.hair)} d="M430 122v178"></path>
		<path {...sx(shape.lines)} d="M380 140h40M380 156h32M380 172h44M380 188h28"></path>
		<rect {...sx(shape.bandYes)} x="431" y="134" width="138" height="30"></rect><path {...sx(shape.lines)} d="M440 144h90M440 154h70"></path>
		<rect {...sx(shape.bandNo)} x="431" y="172" width="138" height="16"></rect><path {...sx(shape.lines)} d="M440 180h80"></path>
		<path {...sx(shape.lines)} d="M440 204h100M440 218h80M440 232h96"></path>
		<Check x={548} y={140} size={12} delay={2} />
		<rect {...sx(productArt.anatomySend)} x="486" y="272" width="76" height="18"></rect><text {...sx(text.tiny, text.white)} x="524" y="284.5" text-anchor="middle">SEND · ⇧S</text>
	</g>
	<text {...anim('fade', 1.8, text.tiny)} x="470" y="322" text-anchor="middle">OPENS IN YOUR BROWSER</text>
</Drawing>
