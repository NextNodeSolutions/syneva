---
import Button from '@shared/ui/Button.astro'
import CtaBand from '@widgets/cta-band/ui/CtaBand.astro'
import Callout from '@shared/ui/prose/Callout.astro'
import IndexRows from '@widgets/page-index/ui/IndexRows.astro'
import PageHero from '@widgets/page-hero/ui/PageHero.astro'
import Prose from '@shared/ui/prose/Prose.astro'
import ProseText from '@shared/ui/prose/ProseText.astro'
import SpecTable from '@shared/ui/prose/SpecTable.astro'
import TextLink from '@shared/ui/TextLink.astro'
import { commandOf } from '@entities/desk/model/agent-contract'
import { PAGES, SECTION_BY_ID } from '@entities/site/model/site-map'
import WorkflowHub from './art/WorkflowHub.astro'

const COMMANDS = [
	[PAGES.workingTree.code, 'The working-tree diff, untracked files included.'],
	['syneva --path src/auth', 'The same, narrowed to one path.'],
	[PAGES.stagedChanges.code, 'Only what is staged in the index.'],
	['syneva pr <ref>', 'A branch, PR number or GitHub URL vs its merge-base.'],
	['syneva pr <ref> --base main', 'The same, against a base you choose.'],
	['syneva file <path>', 'One file, tracked or not.'],
	['syneva --guide <file>', 'Attach your agent’s reading order to any of the above.'],
	[commandOf('stop'), 'Shut the desk down. Your review state stays saved.'],
] as const
---

<PageHero
	title="Four ways in.<br>One desk."
	lede="Review whatever your agent just did: the working tree, what you staged, a whole branch or pull request, or a single file like a plan. The desk, the keys and the handoff stay the same every time."
	caption="Every mode produces the same verdict. Its mode field says how to read it."
>
	<Fragment slot="actions"><Button href={PAGES.getStarted.href} label="Start a local review" /><TextLink href={SECTION_BY_ID.product.href} label={'What’s on the desk'} /></Fragment>
	<WorkflowHub slot="art" />
</PageHero>
<Prose id="modes" title="Pick the one<br>that fits the moment.">
	<IndexRows pages={SECTION_BY_ID.workflows.items} />
</Prose>
<Prose id="commands" title="Every command,<br>at a glance.">
	<SpecTable rows={COMMANDS} head={['Command', 'What opens']} />
	<ProseText>Your agent drives the rest of the loop with <code>await</code>, <code>comment</code>, <code>status</code> and <code>reload</code>. <TextLink href={PAGES.connectYourAgent.href} label="See the agent contract" /></ProseText>
</Prose>
<Prose id="remote" title="Reviewing from<br>another machine?">
	<ProseText>The desk binds to <code>127.0.0.1</code> by default. For a remote-dev setup, <code>--host</code> binds it wider so you can review from your laptop while the agent runs on a server; its subcommands keep talking over loopback.</ProseText>
	<Callout lead="Only on a network you fully trust.">The desk API is unauthenticated: anyone who can reach the address can drive the desk. A personal tailnet is fine. A coffee-shop Wi-Fi is not.</Callout>
</Prose>
<CtaBand />
