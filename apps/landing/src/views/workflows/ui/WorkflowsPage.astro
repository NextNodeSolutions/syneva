---
import WorkflowHub from './art/WorkflowHub.astro'
import Button from '@shared/ui/Button.astro'
import CtaBand from '@widgets/cta-band/ui/CtaBand.astro'
import Callout from '@shared/ui/prose/Callout.astro'
import IndexRows from '@widgets/page-index/ui/IndexRows.astro'
import PageHero from '@widgets/page-hero/ui/PageHero.astro'
import Prose from '@shared/ui/prose/Prose.astro'
import ProseText from '@shared/ui/prose/ProseText.astro'
import SpecTable from '@shared/ui/prose/SpecTable.astro'
import TextLink from '@shared/ui/TextLink.astro'
import { sectionById } from '@entities/site/model/site-map'

type Props = { route: string }

const { route } = Astro.props

const COMMANDS = [
	['syneva start', 'The hub: one process per machine, the dashboard of every project and desk.'],
	['syneva', 'The working-tree diff, untracked files included (same as <code>syneva open</code>).'],
	['syneva --path src/auth', 'The same, narrowed to one path.'],
	['syneva --diff staged', 'Only what is staged in the index.'],
	['syneva pr <ref>', 'A branch, PR number or GitHub URL vs its merge-base.'],
	['syneva pr <ref> --base main', 'The same, against a base you choose.'],
	['syneva file <path>', 'One file, tracked or not.'],
	['syneva --guide <file>', 'Attach your agent’s reading order to any of the above.'],
	['syneva desks', 'The live desks of this repo, with their URLs.'],
	['syneva close', 'Close the desk. The hub keeps running; your review state stays saved.'],
] as const
---

<PageHero
	route={route}
	crumb="Workflows"
	title="Four ways in.<br>One desk."
	lede="Review whatever your agent just did: the working tree, what you staged, a whole branch or pull request, or a single file like a plan. The desk, the keys and the handoff stay the same every time."
	caption="Every mode produces the same verdict. Its mode field says how to read it."
>
	<Fragment slot="actions"><Button href="/get-started/" label="Start a local review" /><TextLink href="/product/" label={'What’s on the desk'} /></Fragment>
	<WorkflowHub slot="art" />
</PageHero>
<Prose id="modes" title="Pick the one<br>that fits the moment.">
	<IndexRows items={sectionById('workflows').items} hasCode />
</Prose>
<Prose id="commands" title="Every command,<br>at a glance.">
	<SpecTable rows={COMMANDS} head={['Command', 'What opens']} />
	<ProseText>Every desk lives on the hub, which the first open starts for you. Your agent drives the rest of the loop with <code>await</code>, <code>comment</code>, <code>status</code> and <code>reload</code>. <TextLink href="/resources/connect-your-agent/" label="See the agent contract" /></ProseText>
</Prose>
<Prose id="remote" title="Reviewing from<br>another machine?">
	<ProseText>The hub binds to <code>127.0.0.1</code> by default. To review from your laptop while the agents run on a server, start it with <code>--host</code> and an access key: <code>syneva start --host 0.0.0.0 --key …</code>. You sign in once in the browser; your agents send the key.</ProseText>
	<Callout lead="The key is the lock.">Whoever holds it can drive every desk on that hub: run your editor command, stage changes, read the repos. Without a key the hub refuses to bind beyond loopback unless you say <code>--insecure</code>, which belongs on a personal tailnet, never on a coffee-shop Wi-Fi.</Callout>
</Prose>
<CtaBand />
