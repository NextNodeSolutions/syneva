---
import PrimaryButton from '@entities/site/ui/PrimaryButton.astro'
import CtaBand from '@widgets/cta-band/ui/CtaBand.astro'
import Callout from '@shared/ui/prose/Callout.astro'
import IndexRows from '@widgets/page-index/ui/IndexRows.astro'
import PageHero from '@widgets/page-hero/ui/PageHero.astro'
import Prose from '@shared/ui/prose/Prose.astro'
import ProseText from '@shared/ui/prose/ProseText.astro'
import SpecTable from '@shared/ui/prose/SpecTable.astro'
import TextLink from '@shared/ui/TextLink.astro'
import { commandOf, SUBCOMMANDS } from '@entities/desk/model/agent-contract'
import { PAGES, SECTION_BY_ID } from '@entities/site/model/site-map'
import { capitalize } from '@shared/lib/capitalize'
import { countWord } from '@shared/lib/count-word'
import { listFormat } from '@shared/lib/list-format'
import WorkflowHub from './art/WorkflowHub.astro'

const COMMANDS = [
	['syneva start', 'The hub: one process per machine, the dashboard of every project and desk.'],
	[PAGES.workingTree.code, 'The working-tree diff, untracked files included (same as <code>syneva open</code>).'],
	['syneva --path src/auth', 'The same, narrowed to one path.'],
	[PAGES.stagedChanges.code, 'Only what is staged in the index.'],
	['syneva pr &lt;ref&gt;', 'A branch, PR number or GitHub URL vs its merge-base.'],
	['syneva pr &lt;ref&gt; --base main', 'The same, against a base you choose.'],
	['syneva file &lt;path&gt;', 'One file, tracked or not.'],
	['syneva --guide &lt;file&gt;', 'Attach your agent’s reading order to any of the above.'],
	[commandOf('desks'), 'The live desks of this repo, with their URLs.'],
	[commandOf('close'), 'Close the desk. The hub keeps running; your review state stays saved.'],
] as const
// The round's subcommands, strictly after the desk is up; the table above lists the desk's lifecycle, not the round.
const ROUND_COMMAND_PARTS = listFormat.formatToParts(SUBCOMMANDS.map(({ name }) => name))
---

<PageHero
	title={`${capitalize(countWord(SECTION_BY_ID.workflows.items.length))} ways in.<br>One desk.`}
	lede="Review whatever your agent just did: the working tree, what you staged, a whole branch or pull request, or a single file like a plan. The desk, the keys and the handoff stay the same every time."
	caption="Every mode produces the same verdict. Its mode field says how to read it."
>
	<Fragment slot="actions"><PrimaryButton label="Start a local review" /><TextLink href={SECTION_BY_ID.product.href} label={'What’s on the desk'} /></Fragment>
	<WorkflowHub slot="art" />
</PageHero>
<Prose id="modes" title="Pick the one<br>that fits the moment.">
	<IndexRows pages={SECTION_BY_ID.workflows.items} />
</Prose>
<Prose id="commands" title="Every command,<br>at a glance.">
	<SpecTable rows={COMMANDS} head={['Command', 'What opens']} />
	<ProseText>Your agent drives the rest of the loop with {ROUND_COMMAND_PARTS.map(({ type, value }) => (type === 'element' ? <code>{value}</code> : value))}. <TextLink href={PAGES.connectYourAgent.href} label="See the agent contract" /></ProseText>
</Prose>
<Prose id="remote" title="Reviewing from<br>another machine?">
	<ProseText>The hub binds to <code>127.0.0.1</code> by default. For a remote-dev setup, <code>--host</code> must pair with an access key (<code>--key</code>): you sign in once in the browser, your agents send the key.</ProseText>
	<Callout lead="No key, no bind.">Without a key the hub refuses to bind beyond loopback unless you pass <code>--insecure</code> - which belongs only on a network you fully trust, like a personal tailnet. A coffee-shop Wi-Fi is not.</Callout>
</Prose>
<CtaBand />
