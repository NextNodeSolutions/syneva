---
// Single file: three states, and markdown reviewed as rendered blocks.
import { HOTKEYS } from '@entities/desk/model/hotkeys'
import { sx } from '@shared/lib/sx'
import AskThread from '@shared/ui/drawing/AskThread.astro'
import Drawing from '@shared/ui/drawing/Drawing.astro'
import { anim } from '@shared/ui/drawing/anim'
import { shape } from '@shared/ui/drawing/shape.styles'
import { text } from '@shared/ui/drawing/text.styles'
import { homeArt } from '@shared/ui/drawing/home-art.styles'
import { workflowsArt } from './workflows-art.styles'

// The three states syneva file opens; the drawing highlights the changed one.
const STATES = [
	{ label: 'UNCHANGED', words: 'full file', x: 40, isCurrent: false },
	{ label: 'CHANGED', words: 'diff · stageable', x: 220, isCurrent: true },
	{ label: 'UNTRACKED', words: 'full file · verdict', x: 400, isCurrent: false },
] as const
---

<Drawing
	id="sf"
	width={600}
	height={430}
	compact="30 30 560 390"
	title="One file, tracked or not"
	description="syneva file opens one file. An unchanged file shows in full, a changed file shows as a diff you can stage, and an untracked file shows in full for a verdict. Markdown renders, and you can comment on any rendered block, including the file's own images."
>
	{
		STATES.map(({ label, words, x, isCurrent }, i) => (
			<g {...anim('rise', i * 0.12)}>
				<rect {...sx(shape.panel, isCurrent && shape.panelWhite)} x={x} y="40" width="160" height="58" />
				<text {...sx(text.tiny, isCurrent && text.accent)} x={x + 14} y="62">{label}</text>
				<text {...sx(text.small)} x={x + 14} y="84">{words}</text>
			</g>
		))
	}
	<g {...anim('rise', 0.4)}>
		<rect {...sx(shape.panel, shape.panelWhite)} x="40" y="118" width="380" height="280"></rect>
		<text {...sx(text.file, text.strong)} x="56" y="140">docs/rollout.md</text>
		<rect {...sx(shape.kbd)} x="270" y="128" width="138" height="18"></rect><text {...sx(text.tiny)} x="339" y="141" text-anchor="middle">RENDERED · SOURCE {HOTKEYS.toggleSource}</text>
		<path {...sx(shape.hair)} d="M40 154h380"></path>
		<text {...sx(text.head)} x="56" y="184">Rollout</text>
		<path {...sx(shape.lines)} d="M56 204h320M56 220h260"></path>
		<rect {...sx(shape.bandFocus)} x="48" y="234" width="360" height="40"></rect>
		<path {...sx(shape.lines)} d="M56 250h300M56 264h220"></path>
		<rect {...sx(workflowsArt.image)} x="56" y="290" width="160" height="90"></rect>
		<path {...sx(workflowsArt.imageLine)} d="M64 368l40-34 26 20 30-28 48 42"></path><rect {...sx(workflowsArt.sun)} x="182" y="302" width="12" height="12"></rect>
		<text {...sx(text.tiny, shape.secondary)} x="230" y="374">IMAGES SERVED FROM THE REPO</text>
	</g>
	<path {...anim('draw', 0.9, homeArt.askAnchor)} d="M408 254h28"></path>
	<g {...anim('rise', 1.1)}>
		<AskThread x={436} y={214} width={140} height={92}>
			<text {...sx(text.tiny)} x="448" y="234">YOU · ASK</text><text {...sx(text.small)} x="448" y="252">Who flips the</text><text {...sx(text.small)} x="448" y="268">flag in step 2?</text>
			<text {...sx(text.tiny, text.accent)} x="448" y="292">ON THIS BLOCK</text>
		</AskThread>
	</g>
</Drawing>
