---
// Workflows overview: one source per workflow page, one desk, one verdict.
import { ICONS } from '@syneva/design-system/icons'
import { SECTION_BY_ID } from '@entities/site/model/site-map'
import { sx } from '@shared/lib/sx'
import Check from '@shared/ui/drawing/Check.astro'
import Drawing from '@shared/ui/drawing/Drawing.astro'
import Pending from '@shared/ui/drawing/Pending.astro'
import Wire from '@shared/ui/drawing/Wire.astro'
import { anim } from '@shared/ui/drawing/anim'
import { shape } from '@shared/ui/drawing/shape.styles'
import { text } from '@shared/ui/drawing/text.styles'
import { capitalize } from '@shared/lib/capitalize'
import { countWord } from '@shared/lib/count-word'
import { listFormat } from '@shared/lib/list-format'
import { workflowsArt } from './workflows-art.styles'

const TOP = 50
const ROW = 95
// The menu's 24-unit icons, centred in each card's left margin at 1.25x;
// workflowsArt.hubGlyph scales their stroke back to 1.4.
const ICON_SCALE = 1.25
const ICON_OFFSET = { x: 41, y: 10 } as const
// The workflows section's pages, as the site map lists them: each card shows
// the page's icon, title and command.
const SOURCES = SECTION_BY_ID.workflows.items.map(({ title, icon, code }, index) => {
	const y = TOP + index * ROW
	return { title, icon, command: code, y, iconTransform: `translate(${ICON_OFFSET.x} ${y + ICON_OFFSET.y}) scale(${ICON_SCALE})` }
})
const routeOf = (y: number): string => `M240 ${y + 32}C290 ${y + 32} 290 220 340 220`
---

<Drawing
	id="hub"
	width={600}
	height={440}
	compact="20 30 570 380"
	title={`${capitalize(countWord(SOURCES.length))} ways in, one desk`}
	description={`${capitalize(listFormat.format(SOURCES.map(({ title }) => title.toLowerCase())))} each feed the same local desk, which produces one structured verdict whose mode tells your agent how to read it.`}
>
	<g fill="none">
		{
			SOURCES.map(({ y }, index) => (
				<Fragment>
					<Wire d={routeOf(y)} drawDelay={0.5 + index * 0.1} signalDelay={1.4 + index * 0.8} />
					<circle {...sx(shape.port)} cx="240" cy={y + 32} r="2.5" />
				</Fragment>
			))
		}<Wire d="M450 220h40" drawDelay={1.2} signalDelay={2} routeCss={shape.routeGreen} signalCss={shape.signalGreen} />
	</g>
	{
		SOURCES.map(({ title, icon, command, y, iconTransform }, index) => (
			<g {...anim('rise', index * 0.12)}>
				<rect {...sx(shape.panel, shape.panelWhite)} x="30" y={y} width="210" height="64" />
				<g transform={iconTransform}>
					<path {...sx(workflowsArt.hubGlyph)} d={ICONS[icon]} />
				</g>
				<text {...sx(text.copy)} x="80" y={y + 28}>{title}</text>
				<text {...sx(text.code, text.accent)} x="80" y={y + 48}>{command}</text>
			</g>
		))
	}
	<g {...anim('rise', 0.8)}>
		<rect {...sx(shape.panel, shape.panelWhite)} x="340" y="160" width="110" height="120"></rect><path {...sx(shape.hair)} d="M340 180h110"></path><rect {...sx(shape.dot)} x="348" y="167" width="5" height="5"></rect><text {...sx(text.tiny)} x="358" y="173">LOCALHOST</text><text {...sx(text.small)} x="352" y="202">One desk</text><Check x={352} y={214} /><Check x={352} y={234} /><Pending x={352} y={254} /><path {...sx(shape.lines)} d="M370 220h64M370 240h54M370 260h60"></path>
	</g>
	<circle {...sx(shape.port)} cx="340" cy="220" r="2.5"></circle>
	<g {...anim('rise', 1.4)}>
		<rect {...sx(shape.panel, shape.panelMint)} x="490" y="180" width="86" height="80"></rect><text {...sx(text.tiny, text.green)} x="533" y="204" text-anchor="middle">VERDICT</text><text {...sx(text.code)} x="533" y="226" text-anchor="middle">mode</text><text {...sx(text.tiny)} x="533" y="246" text-anchor="middle">REPO·FILE·PR</text>
	</g>
</Drawing>
