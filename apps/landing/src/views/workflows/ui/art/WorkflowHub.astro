---
// Workflows overview: four sources, one desk, one verdict.
import { sx } from '@shared/lib/sx'
import Check from '@shared/ui/drawing/Check.astro'
import Drawing from '@shared/ui/drawing/Drawing.astro'
import Pending from '@shared/ui/drawing/Pending.astro'
import { anim } from '@shared/ui/drawing/anim'
import { shape } from '@shared/ui/drawing/shape.styles'
import { text } from '@shared/ui/drawing/text.styles'
import { GLYPHS } from './glyphs'
import { workflowsArt } from './workflows-art.styles'

const SOURCES = [
	{ glyph: 'tree', title: 'Working tree', command: 'syneva', y: 50 },
	{ glyph: 'staged', title: 'Staged changes', command: 'syneva --diff staged', y: 145 },
	{ glyph: 'branch', title: 'Branch or PR', command: 'syneva pr 128', y: 240 },
	{ glyph: 'file', title: 'A single file', command: 'syneva file plan.md', y: 335 },
] as const
const routeOf = (y: number): string => `M240 ${y + 32}C290 ${y + 32} 290 220 340 220`
---

<Drawing
	id="hub"
	width={600}
	height={440}
	compact="20 30 570 380"
	title="Four ways in, one desk"
	description="The working tree, staged changes, a branch or pull request, and a single file each feed the same local desk, which produces one structured verdict whose mode tells your agent how to read it."
>
	<g fill="none">
		{
			SOURCES.map(({ y }, i) => (
				<Fragment>
					<path {...anim('draw', 0.5 + i * 0.1, shape.route)} d={routeOf(y)} />
					<path {...anim('signal', 1.4 + i * 0.8, shape.signal)} d={routeOf(y)} />
					<circle {...sx(shape.port)} cx="240" cy={y + 32} r="2.5" />
				</Fragment>
			))
		}<path {...anim('draw', 1.2, shape.route, shape.routeGreen)} d="M450 220h40"></path><path {...anim('signal', 2, shape.signal, shape.signalGreen)} d="M450 220h40"></path>
	</g>
	{
		SOURCES.map(({ glyph, title, command, y }, i) => (
			<g {...anim('rise', i * 0.12)}>
				<rect {...sx(shape.panel, shape.panelWhite)} x="30" y={y} width="210" height="64" />
				<g transform={`translate(46 ${y + 14})`}>
					<path {...sx(workflowsArt.hubGlyph)} d={GLYPHS[glyph]} />
				</g>
				<text {...sx(text.copy)} x="80" y={y + 28}>{title}</text>
				<text {...sx(text.code, text.accent)} x="80" y={y + 48}>{command}</text>
			</g>
		))
	}
	<g {...anim('rise', 0.8)}>
		<rect {...sx(shape.panel, shape.panelWhite)} x="340" y="160" width="110" height="120"></rect><path {...sx(shape.hair)} d="M340 180h110"></path><rect {...sx(shape.dot)} x="348" y="167" width="5" height="5"></rect><text {...sx(text.tiny)} x="358" y="173">LOCALHOST</text><text {...sx(text.small)} x="352" y="202">One desk</text><Check x={352} y={214} /><Check x={352} y={234} /><Pending x={352} y={254} /><path {...sx(shape.lines)} d="M370 220h64M370 240h54M370 260h60"></path>
	</g>
	<circle {...sx(shape.port)} cx="340" cy="220" r="2.5"></circle>
	<g {...anim('rise', 1.4)}>
		<rect {...sx(shape.panel, shape.panelMint)} x="490" y="180" width="86" height="80"></rect><text {...sx(text.tiny, text.green)} x="533" y="204" text-anchor="middle">VERDICT</text><text {...sx(text.code)} x="533" y="226" text-anchor="middle">mode</text><text {...sx(text.tiny)} x="533" y="246" text-anchor="middle">REPO·FILE·PR</text>
	</g>
</Drawing>
