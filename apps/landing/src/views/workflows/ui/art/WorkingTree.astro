---
// Working tree: modified and untracked files, and --path as a lens.
import { PAGES } from '@entities/site/model/site-map'
import { sx } from '@shared/lib/sx'
import Drawing from '@shared/ui/drawing/Drawing.astro'
import Wire from '@shared/ui/drawing/Wire.astro'
import { anim } from '@shared/ui/drawing/anim'
import { shape } from '@shared/ui/drawing/shape.styles'
import { text } from '@shared/ui/drawing/text.styles'
import type { ComponentProps } from 'astro/types'
import FileList from './FileList.astro'

type ChangedFile = ComponentProps<typeof FileList>['files'][number]
type Row = { name: string; y: number; status?: ChangedFile['status'] }

// The repository's files; the changed ones carry their status.
const ROWS: readonly Row[] = [
	{ name: 'src/auth/session.ts', status: 'M', y: 92 },
	{ name: 'src/auth/token.ts', status: 'M', y: 120 },
	{ name: 'src/api/middleware.ts', status: 'M', y: 148 },
	{ name: 'src/limits/rate.ts', status: 'A', y: 176 },
	{ name: 'docs/plan.md', y: 204 },
	{ name: 'package.json', y: 232 },
]
const BADGE = { M: shape.no, A: shape.yes } as const
const BADGE_TEXT = { M: text.accent, A: text.green } as const
// syneva reviews every changed file; --path narrows the desk to one directory.
const LENS = 'src/auth'
const PATH_FLAG = `--path ${LENS}`
const ALL = ROWS.flatMap(({ name, status }): ChangedFile[] => (status ? [{ name, status }] : []))
const AUTH = ALL.filter(({ name }) => name.startsWith(`${LENS}/`))
const TO_ALL = 'M250 150C300 150 300 100 350 100'
const TO_AUTH = 'M250 106C320 106 280 290 350 290'
---

<Drawing
	id="working-tree-art"
	width={600}
	height={400}
	compact="20 30 566 350"
	title="The working tree, whole or narrowed"
	description="Your repository has three modified files and one new untracked file. syneva reviews all four, the new one as a full-file addition. syneva --path src/auth narrows the desk to the two files under src/auth."
>
	<g {...anim('rise', 0)}>
		<rect {...sx(shape.panel)} x="40" y="60" width="210" height="196"></rect><text {...sx(text.tiny)} x="40" y="50">YOUR REPOSITORY</text>{
			ROWS.map(({ name, status, y }) => (
				<Fragment>
					<text {...sx(text.file, !status && text.muted)} x="58" y={y}>{name}</text>
					{status && (
						<Fragment>
							<rect {...sx(BADGE[status])} x="216" y={y - 11} width="16" height="15" />
							<text {...sx(text.tiny, BADGE_TEXT[status])} x="224" y={y} text-anchor="middle">{status}</text>
						</Fragment>
					)}
				</Fragment>
			))
		}
	</g>
	<path {...anim('draw', 0.9, shape.bracket)} d="M50 88v-10h8M50 122v10h8"></path>
	<text {...anim('fade', 1, text.tiny, text.accent)} x="40" y="282">{PATH_FLAG}</text>
	<g fill="none">
		<Wire d={TO_ALL} drawDelay={0.5} signalDelay={1.6} />
		<Wire d={TO_AUTH} drawDelay={1.1} signalDelay={2.4} routeCss={shape.routeAccent} />
	</g>
	<FileList files={ALL} x={350} y={60} label={`$ ${PAGES.workingTree.code}`} delay={0.6} />
	<FileList files={AUTH} x={350} y={250} label={`$ ${PAGES.workingTree.code} ${PATH_FLAG}`} delay={1.2} />
	<text {...anim('fade', 1.4, text.tiny, text.green, shape.secondary)} x="40" y="330">A · UNTRACKED → FULL-FILE ADDITION</text>
	<text {...anim('fade', 1.5, text.tiny, shape.secondary)} x="40" y="348">UNCHANGED FILES STAY OUT</text>
</Drawing>
