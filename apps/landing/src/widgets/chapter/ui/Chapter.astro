---
// A ruled chapter: an explanatory headline, its paragraphs (default slot), an
// optional detail list, trailing actions (slot "after") and the drawing (slot
// "art"), side by side; artSide puts the drawing left of the copy instead.
import { revealItem, revealRuledGroup, scene } from '@shared/lib/reveal'
import { sx } from '@shared/lib/sx'
import { chapterCopyMarker } from '@shared/ui/actions.stylex'
import { chapterArtMarker } from '@shared/ui/drawing/drawing.stylex'
import { heading } from '@shared/ui/heading.styles'
import { chapter } from './chapter.styles'

type Props = {
	id?: string
	title: string
	artSide?: 'left' | 'right'
	list?: readonly (readonly [string, string])[]
	caption?: string
}

const { id, title, artSide = 'right', list = [], caption } = Astro.props
const isArtLeft = artSide === 'left'
const isSubpage = Astro.locals.page === 'sub'
---

<section {...revealRuledGroup(chapter.section, isSubpage && chapter.subSection)} id={id}>
	<div {...sx(chapter.copy, isSubpage && chapter.subCopy, isArtLeft && chapter.reverseCopy, chapterCopyMarker)}>
		<h2 {...revealItem(heading.section, isSubpage && heading.subpage)} set:html={title} />
		<slot />
		{
			list.length > 0 && (
				<ul {...sx(chapter.list, isSubpage && chapter.subList)}>
					{list.map(([head, text]) => (
						<li {...revealItem(chapter.item, isSubpage && chapter.subItem)}>
							<strong {...sx(chapter.itemHead)} set:html={head} />
							<span {...sx(chapter.itemText)} set:html={text} />
						</li>
					))}
				</ul>
			)
		}
		<slot name="after" />
	</div>
	<figure
		{...revealItem(chapter.art, isArtLeft && chapter.reverseArt, isSubpage && chapter.subArt, isSubpage && isArtLeft && chapter.subReverseArt, chapterArtMarker)}
		{...scene}
	>
		<slot name="art" />
		{caption && <figcaption {...sx(chapter.caption, isSubpage && chapter.subCaption)} set:html={caption} />}
	</figure>
</section>
