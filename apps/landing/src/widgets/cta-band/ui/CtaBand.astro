---
// The start band: two commands to a first desk, and where to read more.
import { REPO_URL } from '@entities/site/model/site-map'
import { revealGroup, revealItem } from '@shared/lib/reveal'
import { sx } from '@shared/lib/sx'
import Command from '@features/copy-command/ui/Command.astro'
import TextLink from '@shared/ui/TextLink.astro'
import { band } from './cta-band.styles'
import { section } from '@shared/ui/section.styles'

type Props = { title?: string; text?: string }

const {
	title = 'Keep the speed.<br>Keep the understanding.',
	text = 'Two commands to your first desk. Bring the agent you already use.',
} = Astro.props
---

<section {...revealGroup(false, section.ruled, section.pad, band.root)}>
	<div>
		<h2 {...revealItem(band.title)} set:html={title} />
		<p {...revealItem(band.text)} set:html={text} />
		<div {...revealItem(band.links)}>
			<TextLink href="/get-started/" label="Read the setup guide" />
			<TextLink href={REPO_URL} label="Star it on GitHub" isExternal />
		</div>
	</div>
	<div {...revealItem(band.install)}>
		<p {...sx(band.label)}>Install · Node 22+ and git</p>
		<Command text="npm install -g syneva" label="Installation command" isInstall />
		<p {...sx(band.label, band.next)}>Then, inside your repository</p>
		<Command text="syneva" label="Start a review" isInstall />
	</div>
</section>
