---
// The product menu's illustrative side preview: each product link swaps in a
// tiny, honest scene of what its page is about. The first scene is current
// until the client selects the hovered or focused link's scene.
import { sx } from '@shared/lib/sx'
import { sceneMarker } from './markers.stylex'
import { motions } from './preview-motion.styles'
import { preview } from './preview.styles'

const scene = (name: string) => ({
	...sx(preview.scene, sceneMarker, name === 'review' && 'is-current'),
	'data-scene': name,
})
---

<div {...sx(preview.frame)} aria-hidden="true">
	<div {...scene('review')}>
		<div {...sx(preview.caption)}><span>YOUR LOCAL DESK</span><span {...sx(preview.dot)}></span></div>
		<div {...sx(preview.diff)}>
			<div {...sx(preview.filename)}>auth/session.ts <span {...sx(preview.filenameStat)}>+2 −1</span></div>
			<div {...sx(preview.code)}>
				<span {...sx(preview.codeLine, preview.minus, motions.codeLine)}>− return run(req)</span>
				<span {...sx(preview.codeLine, preview.plus, motions.codeLine)}>+ await verifySession(req)</span>
				<span {...sx(preview.codeLine, preview.plus, motions.lastAddedLine)}>+ return run(req)</span>
			</div>
			<div {...sx(preview.verdict, motions.verdict)}><span {...sx(preview.check)}>✓</span> Accepted by you</div>
		</div>
		<p {...sx(preview.pitch)}>Your agent writes.<br /><strong {...sx(preview.pitchStrong)}>You decide what stays.</strong></p>
	</div>
	<div {...scene('guide')}>
		<div {...sx(preview.caption)}><span>A READING ORDER</span><span {...sx(preview.dot)}></span></div>
		<div {...sx(preview.tree)}>
			<div {...sx(preview.treeRow)}>
				<span {...sx(preview.treeIndex)}>01</span>
				<strong {...sx(preview.treeTitle)}>Start with the contract</strong>
				<small {...sx(preview.treeFile)}>contracts/review.ts</small>
			</div>
			<div {...sx(preview.treeRow)}>
				<span {...sx(preview.treeIndex)}>02</span>
				<strong {...sx(preview.treeTitle)}>Follow the behavior</strong>
				<small {...sx(preview.treeFile)}>auth/session.ts</small>
			</div>
			<div {...sx(preview.treeRow)}>
				<span {...sx(preview.treeIndex)}>03</span>
				<strong {...sx(preview.treeTitle)}>Check the interface</strong>
				<small {...sx(preview.treeFile)}>pages/desk.tsx</small>
			</div>
		</div>
		<p {...sx(preview.pitch)}>Your agent sets the order.<br /><strong {...sx(preview.pitchStrong)}>Every file stays visible.</strong></p>
	</div>
	<div {...scene('ask')}>
		<div {...sx(preview.caption)}><span>ON THE EXACT LINE</span><span {...sx(preview.dot)}></span></div>
		<div {...sx(preview.conversation)}>
			<code {...sx(preview.conversationCode)}>+ await verifySession(req)</code>
			<div {...sx(preview.message, motions.message)}>
				<span {...sx(preview.who)}>YOU</span>
				<p {...sx(preview.said)}>What if the session already expired?</p>
			</div>
			<div {...sx(preview.message, preview.reply, motions.reply)}>
				<span {...sx(preview.who)}>YOUR AGENT</span>
				<p {...sx(preview.said)}>It returns 401 before the handler runs.</p>
			</div>
		</div>
		<p {...sx(preview.pitch)}>Ask where it matters.<br /><strong {...sx(preview.pitchStrong)}>The answer stays there.</strong></p>
	</div>
	<div {...scene('plan')}>
		<div {...sx(preview.caption)}><span>PLAN DESK · PROTOTYPE</span></div>
		<div {...sx(preview.plan)}>
			<span {...sx(preview.planFile)}>plan.md</span>
			<strong {...sx(preview.planTitle)}>Move session checks<br />into middleware.</strong>
			<div {...sx(preview.planQuestion, motions.planQuestion)}>
				What happens when<br />the session expires? <span {...sx(preview.planMark)}>?</span>
			</div>
		</div>
		<p {...sx(preview.pitch)}>Find the assumption.<br /><strong {...sx(preview.pitchStrong)}>Settle it before the diff.</strong></p>
	</div>
	<span {...sx(preview.example)}>Illustrative example</span>
</div>
