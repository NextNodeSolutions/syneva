---
// A workflows menu cell: icon and title, blurb, and the command that opens it.
import type { WorkflowPage } from '@entities/site/model/site-map'
import { sx } from '@shared/lib/sx'
import Icon from '@entities/site/ui/Icon.astro'
import { currentPage } from '../model/current-page'
import { workflowLinkMarker } from './markers.stylex'
import { workflowLink } from './menu.styles'

type Props = { page: WorkflowPage; index: number }

const { page, index } = Astro.props
// Rows after the first carry a rule; the second cell of the first row only
// once the grid stacks into one column.
const SECOND_ROW = 2
const isRuled = index >= SECOND_ROW
const isRuledWhenStacked = index === 1
---

<a
	{...sx(
		workflowLink.base,
		isRuled && workflowLink.ruled,
		isRuledWhenStacked && workflowLink.stackedRule,
		workflowLinkMarker,
	)}
	href={page.href}
	data-menu-row
	aria-current={currentPage(page.href, Astro.url.pathname)}
>
	<strong {...sx(workflowLink.title)}>
		<Icon name={page.icon} css={workflowLink.icon} />
		{page.title} <span {...sx(workflowLink.arrow)} aria-hidden="true">→</span>
	</strong>
	<span {...sx(workflowLink.blurb)}>{page.blurb}</span>
	<code {...sx(workflowLink.code)}>{page.code}</code>
</a>
