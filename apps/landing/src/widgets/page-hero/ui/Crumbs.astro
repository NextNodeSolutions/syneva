---
// Where the page sits: the site, its section (unless it is the section's
// overview), the page itself, each named by the site map.
import { crumbOf, HOME_HREF, sectionOf } from '@entities/site/model/site-map'
import { sx } from '@shared/lib/sx'
import { pageHero } from './page-hero.styles'

const route = Astro.url.pathname
const current = crumbOf(route)
const section = sectionOf(route)
const parent = section && section.href !== route ? section : undefined
---

<nav {...sx(pageHero.crumbs)} aria-label="Breadcrumb">
	<a {...sx(pageHero.crumbLink)} href={HOME_HREF}>Syneva</a><span aria-hidden="true">/</span>{
		parent && (
			<Fragment>
				<a {...sx(pageHero.crumbLink)} href={parent.href}>{parent.label}</a><span aria-hidden="true">/</span>
			</Fragment>
		)
	}<span {...sx(pageHero.crumbCurrent)} aria-current="page">{current}</span>
</nav>
