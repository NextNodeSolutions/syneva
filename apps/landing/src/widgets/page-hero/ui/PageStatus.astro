---
// Whether the page describes the CLI today or a prototype direction.
import { sx } from '@shared/lib/sx'
import { pageStatus } from './page-hero.styles'

type Props = { state: 'available' | 'prototype' }

const { state } = Astro.props
const isPrototype = state === 'prototype'
---

<p {...sx(pageStatus.root, isPrototype && pageStatus.prototype)}>
	<span {...sx(pageStatus.dot)} aria-hidden="true"></span>{isPrototype ? 'Prototype · not in the CLI today' : 'Available now · in the CLI'}
</p>
