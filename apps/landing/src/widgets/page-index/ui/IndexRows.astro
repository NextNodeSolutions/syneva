---
// Linked rows for an overview page, from the section's pages; workflows
// show the command each one runs.
import type { Page } from '@entities/site/model/site-map'
import { revealItem } from '@shared/lib/reveal'
import { sx } from '@shared/lib/sx'
import Icon from '@entities/site/ui/Icon.astro'
import { indexRows } from './index-rows.styles'
import { indexRowMarker } from './page-index.stylex'
import { twoDigits } from '@shared/lib/step-number'

type Props = { items: readonly Page[]; hasCode?: boolean }

const { items, hasCode = false } = Astro.props
---

<div {...sx(indexRows.root)}>
	{
		items.map((item, index) => (
			<a {...revealItem(indexRows.row, indexRowMarker)} href={item.href}>
				<span {...sx(indexRows.number)}>{twoDigits(index + 1)}</span>
				<Icon name={item.icon} css={indexRows.icon} />
				<span>
					<strong {...sx(indexRows.title)}>
						{item.title}
						{item.badge && (
							<Fragment>
								{' '}
								<em {...sx(indexRows.badge)}>{item.badge}</em>
							</Fragment>
						)}
					</strong>
					<span {...sx(indexRows.blurb)}>{item.blurb}</span>
				</span>
				{hasCode && <code {...sx(indexRows.code)}>{item.code}</code>}
				<span {...sx(indexRows.arrow)} aria-hidden="true">
					→
				</span>
			</a>
		))
	}
</div>
