---
// Linked rows for an overview page, from the section's pages; a page with a
// command (every workflow) shows the command it runs.
import type { Page } from '@entities/site/model/site-map'
import Icon from '@entities/site/ui/Icon.astro'
import { revealItem } from '@shared/lib/reveal'
import { twoDigits } from '@shared/lib/step-number'
import { sx } from '@shared/lib/sx'
import { indexRows } from './index-rows.styles'
import { indexRowMarker } from './page-index.stylex'

type Props = { pages: readonly Page[] }

const { pages } = Astro.props
---

<div {...sx(indexRows.root)}>
	{
		pages.map((page, index) => (
			<a {...revealItem(indexRows.row, indexRowMarker)} href={page.href}>
				<span {...sx(indexRows.number)}>{twoDigits(index + 1)}</span>
				<Icon name={page.icon} css={indexRows.icon} />
				<span>
					<strong {...sx(indexRows.title)}>
						{page.title}
						{page.badge && (
							<Fragment>
								{' '}
								<em {...sx(indexRows.badge)}>{page.badge}</em>
							</Fragment>
						)}
					</strong>
					<span {...sx(indexRows.blurb)}>{page.blurb}</span>
				</span>
				{page.code && <code {...sx(indexRows.code)}>{page.code}</code>}
				<span {...sx(indexRows.arrow)} aria-hidden="true">
					→
				</span>
			</a>
		))
	}
</div>
