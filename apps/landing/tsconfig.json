{
	// The shared Astro preset (astro/tsconfigs/strict plus NextNode's strictness).
	"extends": "@nextnode-solutions/standards/typescript/astro",
	"compilerOptions": {
		// The signup's islands are React (@astrojs/react).
		"jsx": "react-jsx",
		"jsxImportSource": "react",
		// The FSD layer aliases (Astro applies tsconfig paths to its Vite build):
		// app -> views -> widgets -> features -> entities -> shared, strictly
		// downward; src/pages holds the routes, which compose app and views.
		// Enforced by oxlint's layer rules. layers.json lists the layers for
		// the configs that can import it (astro.config.ts, the root
		// oxlint.config.ts); JSON cannot, so this is their one literal copy:
		// keep the two in step.
		"paths": {
			"@app/*": ["./src/app/*"],
			"@views/*": ["./src/views/*"],
			"@widgets/*": ["./src/widgets/*"],
			"@features/*": ["./src/features/*"],
			"@entities/*": ["./src/entities/*"],
			"@shared/*": ["./src/shared/*"]
		}
	},
	"include": [
		".astro/types.d.ts",
		"src/**/*",
		"integrations/**/*",
		"astro.config.ts"
	],
	// The Worker's code (the on-demand routes and the *.server.ts modules they
	// call) is checked by tsconfig.worker.json against the Workers runtime:
	// its globals (Element, Response, fetch...) differ from the DOM's, so the
	// two never share a program.
	"exclude": ["dist", "src/pages/api/**", "src/**/*.server.ts"]
}
