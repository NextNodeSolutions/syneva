// Local development only: the bindings `astro dev` gives the Worker (a local
// D1 and limiter). Deploys never read it: the pipeline generates its own
// wrangler config from nextnode.toml. A real RESEND_API_KEY for local sends
// goes in .dev.vars (gitignored); without one the welcome email fails, logged,
// and the signup still lands.
{
	"name": "syneva-landing-local",
	"compatibility_date": "2026-06-01",
	"compatibility_flags": ["nodejs_compat"],
	// The deploy injects SITE_URL per environment (the email's links); locally it is astro dev's default address.
	"vars": { "SITE_URL": "http://localhost:4321" },
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "syneva-landing-local-d1",
			"database_id": "00000000-0000-0000-0000-000000000000",
			"migrations_dir": "migrations",
		},
	],
	"ratelimits": [
		{
			"name": "RL_SUBSCRIBE",
			"namespace_id": "1001",
			"simple": { "limit": 5, "period": 60 },
		},
	],
}
