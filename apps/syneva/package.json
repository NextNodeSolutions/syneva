{
	"name": "syneva",
	"version": "0.9.0",
	"description": "An integrated review environment (IRE) for code you didn't write by hand — review a git diff in the browser, then hand a structured review back to your coding agent.",
	"keywords": [
		"git",
		"diff",
		"code-review",
		"review",
		"coding-agent",
		"ai",
		"cli",
		"pi-package"
	],
	"homepage": "https://github.com/walid-mos/syneva#readme",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/walid-mos/syneva.git"
	},
	"bugs": {
		"url": "https://github.com/walid-mos/syneva/issues"
	},
	"author": "Walid Mostefaoui",
	"contributors": [
		"Yusuf Mansur Özer"
	],
	"license": "MIT",
	"type": "module",
	"engines": {
		"node": ">=22"
	},
	"pi": {
		"extensions": [
			"extension/syneva.ts"
		],
		"skills": [
			"extension/skills"
		],
		"prompts": [
			"extension/prompts"
		],
		"subagents": {
			"agents": [
				"extension/subagents"
			]
		}
	},
	"bin": {
		"syneva": "./dist/cli.js"
	},
	"peerDependencies": {
		"@earendil-works/pi-coding-agent": "*",
		"typebox": "*"
	},
	"files": [
		"dist",
		"extension"
	],
	"publishConfig": {
		"access": "public"
	},
	"scripts": {
		"dev": "node scripts/dev.mjs",
		"build": "node scripts/build-dist.mjs",
		"start": "node dist/cli.js",
		"check": "tsc --noEmit",
		"prepack": "pnpm build"
	},
	"devDependencies": {
		"@earendil-works/pi-coding-agent": "^0.85.1",
		"@syneva/backend": "workspace:*",
		"@syneva/frontend": "workspace:*",
		"@types/node": "latest",
		"changelogen": "^0.6.2",
		"esbuild": "^0.28.0",
		"tsx": "latest"
	}
}
