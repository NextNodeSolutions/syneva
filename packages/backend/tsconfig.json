{
	"extends": "../../tsconfig.base.json",
	"compilerOptions": {
		// The backend is a NodeNext emit world (tsc builds dist as ESM): intra-package imports keep explicit .js specifiers so the emitted code runs under plain Node ESM.
		"module": "NodeNext",
		"moduleResolution": "NodeNext",
		"noEmit": false,
		"declaration": true,
		"types": ["node"],
		"outDir": "dist",
		"rootDir": "src"
	},
	"include": ["src/**/*.ts"]
}
