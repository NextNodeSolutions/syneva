{
  "name": "@syneva/design-system",
  "version": "0.0.0",
  "description": "Syneva's design system, shared by every front (today the public site): StyleX tokens (palette, type, easing, duration, layout, breakpoints), the self-hosted fonts, the mark and the shared recipes.",
  "license": "MIT",
  "scripts": {
    "type-check": "tsc --noEmit"
  },
  "dependencies": {
    "@stylexjs/stylex": "0.19.1"
  },
  "devDependencies": {
    "typescript": "7.0.2"
  },
  "private": true,
  "type": "module",
  "exports": {
    "./tokens.stylex": "./src/tokens.stylex.ts",
    "./curves.stylex": "./src/curves.stylex.ts",
    "./transitions.stylex": "./src/transitions.stylex.ts",
    "./media.stylex": "./src/media.stylex.ts",
    "./when": "./src/when.ts",
    "./brand": "./src/brand.ts",
    "./brand.styles": "./src/brand.styles.ts",
    "./brand.stylex": "./src/brand.stylex.ts",
    "./press.styles": "./src/press.styles.ts",
    "./inline.stylex": "./src/inline.stylex.ts",
    "./controls.styles": "./src/controls.styles.ts",
    "./inline.styles": "./src/inline.styles.ts",
    "./a11y.styles": "./src/a11y.styles.ts",
    "./ruled.styles": "./src/ruled.styles.ts",
    "./icons": "./src/icons.ts",
    "./fonts.css": "./src/fonts.css",
    "./fonts/*": "./fonts/*"
  }
}
