{
	"extends": "../../tsconfig.base.json",
	"compilerOptions": {
		// The preset's ESNext/bundler resolution already fits the browser world.
		// Overrides: DOM libs next to the preset's ES2024, JSX runtime, the
		// node types vite.config.ts needs, and the frontend-only layer aliases
		// (FSD): app -> pages -> widgets -> features -> entities -> shared.
		// Enforced here by moduleResolution=bundler and by oxlint's layer rules.
		// The shared wire shapes come from the @syneva/contracts workspace
		// package, not an alias.
		"lib": ["ES2024", "DOM", "DOM.Iterable"],
		"jsx": "react-jsx",
		"types": ["node"],
		"paths": {
			"@app/*": ["./src/app/*"],
			"@pages/*": ["./src/pages/*"],
			"@widgets/*": ["./src/widgets/*"],
			"@features/*": ["./src/features/*"],
			"@entities/*": ["./src/entities/*"],
			"@shared/*": ["./src/shared/*"]
		}
	},
	// The whole browser world: it imports modules through bundler-style specifiers,
	// so it cannot be checked in the NodeNext worlds.
	"include": ["src/**/*.ts", "src/**/*.tsx", "vite.config.ts"]
}
