{
	"$schema": "https://turbo.build/schema.json",
	"tasks": {
		// The transit tasks (no script) link each package to its dependencies' files:
		// folding the source-only workspace deps (@syneva/design-system, @syneva/motion)
		// and the built-dist type resolution into the hashes, so a changed dependency
		// re-runs instead of replaying a stale cache and a check never runs against a
		// stale (or missing) dist.
		"build": {
			"dependsOn": ["^build", "transit"],
			"inputs": ["$TURBO_DEFAULT$"],
			"outputs": ["dist/**"]
		},
		"check": {
			"dependsOn": ["^build", "transit"],
			"outputs": []
		},
		"transit": {
			"dependsOn": ["^transit"]
		},
		"dev": {
			"cache": false,
			"persistent": true
		}
	}
}
